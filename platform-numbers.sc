        (EPIPE 32)
        (ENAMETOOLONG 63)
        (ENOTEMPTY 66)
        (ELOOP 62)
        (EOVERFLOW 84)
        (ETIMEDOUT 60)
        (ECONNREFUSED 61)
        (ENOTSOCK 38)
        ))))

  ;; ---- which row is this platform's -----------------------------------------

  ;; A reading's own lines name its platform: (system "Linux"), (machine
  ;; "x86_64"), (libc "glibc 2.39"). -> (system machine libc), libc being
  ;; the library's family ("glibc", "musl") on Linux and #f elsewhere, where
  ;; the system has one C library.
  (define (reading-string r name)
    (let ((e (assq name r)))
      (and e (pair? (cdr e)) (string? (cadr e)) (cadr e))))

  (define (first-word s)
    (let loop ((i 0))
      (cond ((= i (string-length s)) s)
            ((char=? (string-ref s i) #\space) (substring s 0 i))
            (else (loop (+ i 1))))))

  (define (reading-key r)
    (let ((system (reading-string r 'system)))
      (list system
            (reading-string r 'machine)
            (and (equal? system "Linux")
                 (let ((libc (reading-string r 'libc))) (and libc (first-word libc)))))))

  (define (has-prefix? prefix s)
    (and (<= (string-length prefix) (string-length s))
         (string=? (substring s 0 (string-length prefix)) prefix)))

  (define (has-suffix? suffix s)
    (and (<= (string-length suffix) (string-length s))
         (string=? (substring s (- (string-length s) (string-length suffix)) (string-length s)) suffix)))

  ;; -> the last component of a mapping's path, or #f for a line with no
  ;; path. A maps line is address, permissions, offset, device, inode, then
  ;; the pathname; only the pathname holds a "/", so it starts at the
  ;; line's first "/". The kernel appends " (deleted)" to an unlinked
  ;; object's path, and that suffix is not part of its name.
  (define (mapping-basename line)
    (let loop ((i 0))
      (cond
        ((= i (string-length line)) #f)
        ((char=? (string-ref line i) #\/)
         (let* ((path (substring line i (string-length line)))
                (path (if (has-suffix? " (deleted)" path)
                          (substring path 0 (- (string-length path) 10))
                          path)))
           (let last ((j (string-length path)))
             (if (char=? (string-ref path (- j 1)) #\/)
                 (substring path j (string-length path))
                 (last (- j 1))))))
        (else (loop (+ i 1))))))

  (define (text-lines text)
    (let loop ((i 0) (from 0) (out '()))
      (cond ((= i (string-length text)) (reverse (if (< from i) (cons (substring text from i) out) out)))
            ((char=? (string-ref text i) #\newline) (loop (+ i 1) (+ i 1) (cons (substring text from i) out)))
            (else (loop (+ i 1) from out)))))

  ;; THE C LIBRARY ON LINUX, IDENTIFIED POSITIVELY from the objects mapped
  ;; into this very process: glibc's libc.so.6 or its loader ld-linux-*,
  ;; musl's ld-musl-* or libc.musl-*. Each mapping's path is judged by its
  ;; LAST COMPONENT only, so a directory that happens to be named like a
  ;; library (/opt/libc.so.6-build/bin/scheme) names nothing. A text that
  ;; names both families, or neither, reads as unknown, and so does a
  ;; process that cannot read the file (a sandbox hiding /proc) or maps
  ;; neither (a static executable): unknown is unlisted and refused, the
  ;; safe side. -> "glibc", "musl" or "unknown"
  (define (maps-libc text)
    (let* ((names (filter (lambda (b) b) (map mapping-basename (text-lines text))))
           (glibc (exists (lambda (b) (or (string=? b "libc.so.6") (has-prefix? "ld-linux-" b))) names))
           (musl (exists (lambda (b) (or (has-prefix? "ld-musl-" b) (has-prefix? "libc.musl-" b))) names)))
      (cond ((and glibc (not musl)) "glibc")
            ((and musl (not glibc)) "musl")
            (else "unknown"))))

  (define (linux-libc)
    (let ((maps (guard (e (#t #f))
                  (call-with-input-file "/proc/self/maps" get-string-all))))
      (if (string? maps) (maps-libc maps) "unknown")))

  ;; THE SYSTEM AND THE ARCHITECTURE FROM (machine-type), a fixed map.
  ;; Threaded and non-threaded builds map alike: a layout does not depend
  ;; on threads. macOS on x86_64 maps to its own key, Darwin/x86_64, which
  ;; has no row -- it is refused, never given the arm64 row, and that
  ;; covers a Chez built for x86_64 running under Rosetta. Any other
  ;; machine type is unlisted by construction.
  (define (running-key)
    (let* ((m (machine-type))
           (pair (case m
                   ((ta6le a6le) '("Linux" "x86_64"))
                   ((tarm64le arm64le) '("Linux" "aarch64"))
                   ((ta6fb a6fb) '("FreeBSD" "amd64"))
                   ((tarm64osx arm64osx) '("Darwin" "arm64"))
                   ((ta6osx a6osx) '("Darwin" "x86_64"))
                   (else (list "unknown" (symbol->string m))))))
      (list (car pair) (cadr pair)
            (and (equal? (car pair) "Linux") (linux-libc)))))

  ;; Read by the process doing the EXPANDING, as ffi.sc reads its switch:
  ;; the seam below exists only in a build expanded with
  ;; THEOURGIA_INJECT=on, and a build without it has no code that reads
  ;; THEOURGIA_PLATFORM_KEY at all.
  (meta define inject-mode
    (let ((v (getenv "THEOURGIA_INJECT")))
      (cond
        ((or (not v) (string=? v "off")) 'off)
        ((string=? v "on") 'on)
        (else (assertion-violation 'theourgia-platform-numbers
                "THEOURGIA_INJECT must be \"on\", \"off\", or unset" v)))))

  (define (split-slashes s)
    (let loop ((i 0) (from 0) (out '()))
      (cond ((= i (string-length s)) (reverse (cons (substring s from i) out)))
            ((char=? (string-ref s i) #\/) (loop (+ i 1) (+ i 1) (cons (substring s from i) out)))
            (else (loop (+ i 1) from out)))))

  ;; THE TEST SEAM: THEOURGIA_PLATFORM_KEY=<system>/<machine>[/<libc>]
  ;; replaces the whole key, so a row of the suite can run a FRESH child
  ;; as if on another platform (its layouts are then built and read back
  ;; as bytes, never handed to this kernel). It is read once, here, at
  ;; initialisation, so a row once selected is never changed in place.
  (meta-cond
    ((eq? inject-mode 'on)
     (define (forced-key)
       (let ((v (getenv "THEOURGIA_PLATFORM_KEY")))
         (and v (> (string-length v) 0)
              (let ((parts (split-slashes v)))
                (list (car parts)
                      (if (pair? (cdr parts)) (cadr parts) "")
                      (if (and (pair? (cdr parts)) (pair? (cddr parts))) (caddr parts) #f)))))))
    (else
     (define (forced-key) #f)))

  (define selected-key (or (forced-key) (running-key)))

  (define selected
    (let ((row (find (lambda (r) (equal? (reading-key r) selected-key)) readings)))
      (or row
          (let ((p (current-error-port)))
            (write (append (list 'error 'platform-unmeasured
                                 (list 'system (car selected-key))
                                 (list 'machine (cadr selected-key)))
                           (if (caddr selected-key) (list (list 'libc (caddr selected-key))) '())
                           (list (list 'remedy "run test/probe/layout.c and add its row")))
                   p)
            (newline p)
            (flush-output-port p)
            (exit 75)))))

  ;; ---- the accessors ----------------------------------------------------------

  (define (platform-key) selected-key)
  (define (platform-row) selected)
  (define (platform-readings) readings)

  (define (block name)
    (find (lambda (d) (and (pair? d) (eq? (car d) name))) selected))

  (define (struct-block who name)
    (let ((b (find (lambda (d) (and (pair? d) (eq? (car d) 'struct) (pair? (cdr d)) (eq? (cadr d) name)))
                   selected)))
      (cond ((not b) (assertion-violation who "no such struct in the platform table" name))
            ((equal? (cddr b) '(absent)) (assertion-violation who "struct absent on this platform" name selected-key))
            (else (cddr b)))))

  (define (entry-value who entries key what)
    (let ((e (assq key entries)))
      (unless (and e (pair? (cdr e)) (exact? (cadr e)) (integer? (cadr e)))
        (assertion-violation who "no such entry in the platform table" what key))
      (cadr e)))

  ;; -> the exact integer the row's (constants ...) block gives for NAME.
  (define (platform-number name)
    (let* ((c (block 'constants))
           (e (and c (assq name (cdr c)))))
      (cond ((not e) (assertion-violation 'platform-number "no such number in the platform table" name))
            ((eq? (cadr e) 'absent) (assertion-violation 'platform-number "absent on this platform" name selected-key))
            (else (cadr e)))))

  (define (struct-size who name)
    (entry-value who (struct-block who name) 'size name))

  (define (platform-struct-size name) (struct-size 'platform-struct-size name))

  (define (field-entry who sname fname)
    (let ((f (find (lambda (d) (and (pair? d) (eq? (car d) 'field) (pair? (cdr d)) (eq? (cadr d) fname)))
                   (struct-block who sname))))
      (unless f (assertion-violation who "no such field in the platform table" sname fname))
      f))

  ;; -> #t when the row has the field, #f when it prints it absent
  ;; (sun_len and d_namlen on Linux).
  (define (platform-field-present? sname fname)
    (not (equal? (cddr (field-entry 'platform-field-present? sname fname)) '(absent))))

  ;; -> the field's offset or size; a field the row prints absent is a
  ;; programming error here: its presence is asked first.
  (define (platform-field sname fname what)
    (let ((f (field-entry 'platform-field sname fname)))
      (when (equal? (cddr f) '(absent))
        (assertion-violation 'platform-field "field absent on this platform" sname fname selected-key))
      (entry-value 'platform-field (cddr f) what (list sname fname))))

  ;; -> a value a struct block states directly, as posix_spawn's
  ;; (attr-size n) and (file-actions-size n).
  (define (platform-struct-value sname key)
    (entry-value 'platform-struct-value (struct-block 'platform-struct-value sname) key sname))

  ;; -> a (types ...) entry's size: pid_t, int.
  (define (platform-type-size name)
    (let* ((b (block 'types))
           (e (and b (assq name (cdr b)))))
      (unless e (assertion-violation 'platform-type-size "no such type in the platform table" name))
      (entry-value 'platform-type-size (cdr e) 'size name)))

  ;; -> one of the (wait-status ...) samples the probe computed with the
  ;; platform's own macros, which check the decoding kept in ffi.sc.
  (define (platform-wait-sample name)
    (let ((b (block 'wait-status)))
      (unless b (assertion-violation 'platform-wait-sample "no wait-status block" selected-key))
      (entry-value 'platform-wait-sample (cdr b) name 'wait-status)))
)
