5a0de545 (519 1792221500493 "import-git" (("w5vbequy" . 14982)) (put ((kind . decision) (slot . "import") (from . "eb193a9c9c11b6bb916871f5234261e5347ea860") (to . "96dfa7a6a4be594f6f1574c04305e44165f2035c") (tag . "import-96dfa7a") (status . "pending") (src . "query: goals are dispatched to one handler per kind, in three environments\ntest: query-dispatch looks up the dispatch's names, so it loads on a tree without them and reads today's behaviour there\nquery: import make-parameter, check every clause's head before any body\nquery: a rule handler's external flag is #f, the facts' column only\nstore: the partial answer's done is measured on a retry for commit and both imports; only a first attempt has no cell\n") (parent . root) (ord . 411))))
