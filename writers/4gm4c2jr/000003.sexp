d77c7a54 (633 1792310174500 "import-git" (("w5vbequy" . 14982)) (put ((kind . decision) (slot . "import") (from . "fdb46d2eaca59cb45c7e0d33193a794c011a5544") (to . "efb166e4f4f41326ad2b99568bb99d3304f1053c") (tag . "import-efb166e") (status . "pending") (src . "derive: stored derived relations, declared by a verb and checked where they are used\nderive: no and in a clause, a callee without a head leaves the head's kinds unread; the fixture's readings tightened\nderive fixture: the tracked plan's cursor is written writer:sequence\nderive: a resent rule is its replay, affects read under the lock, one walk per relation, and is no name\nderive: a rule's form handed on from its shape, recursive relations kept whole, one visit per relation outside the log\nderive: a partial answer stands on the walk it was made on, and a rule value's names are read once each\nquery: the external walk finds a relation's clauses by head, and a rule value's form asks for write facts without gathering names\nchange-stream guard: the catalogue and the unknown-verb refusal list derive\n") (parent . root) (ord . 415))))
