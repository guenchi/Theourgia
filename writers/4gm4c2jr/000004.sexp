79e58208 (958 1792382437493 "import-git" (("w5vbequy" . 14982)) (put ((kind . decision) (slot . "import") (from . "a482695e023be83f98a3a504a19414abb7e02596") (to . "4e1aed43ccc73ffca36a7026aac31e566903f784") (tag . "import-4e1aed4") (status . "pending") (src . "query: not, count, sum, min and max over a goal, and stored relations stratified\nquery: a form's table over its group and its goal's exports, a statically empty goal unevaluated\nquery: a form's table named by its occurrence and its group, emptiness read goal by goal, a disjoint goal's columns still kinded\nquery: a disjoint goal's columns kinded one variable at a time, a passed-over aggregate still kinding its result\nquery: emptiness read with every form's own refusal falling back to the kinds it still gives\nquery fixture: the unread row reads its rule's declaration too\n") (parent . root) (ord . 420))))
