148e02e2 (2852 1794213463939 "guenchi" (("4gm4c2jr" . 3240) ("w5vbequy" . 14982)) (put ((kind . doc) (title . "the launcher's group sends, the runner's own children, the library's handles") (brief . "f356c-verified-signal-sends") (brief-path . "core/briefs/f356c-verified-signal-sends.md") (brief-version . "v1.7") (parent . root) (ord . 655))))
54171e11 (2853 1794213463954 "guenchi" (("4gm4c2jr" . 3240) ("w5vbequy" . 14982)) (put ((kind . decision) (title . "OWN UNREAPED CHILD, BY PID, IS SAFE BY CONSTRUCTION") (src . "C1. OWN UNREAPED CHILD, BY PID, IS SAFE BY CONSTRUCTION: a pid is held\n    until its parent reaps it, so a parent that has not called waitpid\n    on that child (or whose waitpid answered 0) sends to the process it\n    forked. launch.pl :333 and :349 stay as they are, each with a one-line\n    comment naming the invariant (\"own child, not reaped: the pid is\n    held\"), and SA-3 names them as launch.pl's remainders with that\n    reason. The rule does not extend to a shell's $!: bash reaps on\n    SIGCHLD, so the shell's children are rule C3's.") (rule . "C1") (brief . "f356c-verified-signal-sends") (rule-version . "v1.7") (verified-by "test/launch-self.sc" "test/signal-audit.sc") (parent . "mlmfhyau.278") (ord . 0))))
