30b8ee44 (2926 1794213464022 "guenchi" (("4gm4c2jr" . 3240) ("w5vbequy" . 14982)) (put ((kind . decision) (title . "SA-3 READS PERL'S SEND TOO") (src . "C5. SA-3 READS PERL'S SEND TOO: the bare-send rule gains `kill '<NAME>',`\n    and `kill <NAME> =>` followed by a target (`-$x`, `$x` or a number),\n    so a new perl send is read; launch.pl's entry names :333, :349 (C1)\n    and the two stop_group sends (C2, \"G's leader held: sent before the\n    reap\") as remainders with their census rows; run-fixtures.sh gains an\n    entry with no remainder and converted (\"kill_if_same \" 6: the\n    definition and five calls) and (\"bps -o lstart=\" 4: three records and\n    the definition); facade-proc's remainder becomes child-send!'s one\n    line (census row 85, the children) and converted gains\n    (\"(worker-kill! \" n) with n the count. SA-0's file count is unchanged.") (rule . "C5") (brief . "f356c-verified-signal-sends") (rule-version . "v1.7") (verified-by "test/signal-audit.sc") (parent . "mlmfhyau.278") (ord . 4))))
