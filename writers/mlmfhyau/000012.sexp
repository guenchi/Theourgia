1db08645 (892 1793334353296 "guenchi" (("4gm4c2jr" . 3240) ("w5vbequy" . 14982)) (put ((kind . section) (title . "landing f395") (src . "test: the mcp-shell stub appends its log line before it sends the answer\n\nA row counts the stub's log as soon as the shell has answered, so an\nappend made after the send could be read as no answer on a slow runner.\nThe stub now writes and closes its log line before sendall, and the\nrows-baseline line for mcp-shell follows the fixture's new bytes.\n") (parent . root) (ord . 532))))
