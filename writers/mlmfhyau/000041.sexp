6e609b4d (5782 1794771649965 "import-git" (("4gm4c2jr" . 3240) ("w5vbequy" . 14982)) (put ((kind . decision) (slot . "import") (from . "15b31693ecf4ede78b3b200bb424a2fb061aea0d") (to . "cfda5766b3886f981a405c5acfc07d59807ebb98") (tag . "import-sb-1115b") (status . "pending") (src . "store: a partly applied batch sent again answers partial\nstore: a changed refusal carries the block's current fields\nstore: a planned batch sent again answers planned\nrender: a changed refusal's fields print as a record's\nexport-code: --wire answers each file's block ranges\nworking: a commit's behind leaves out the commit's own records\nstore: grep reads a datum body as printed, line by line\ndocs: log's verb, and conflicts' and batch's tool texts\nmd: one heading rule for read --md and export-md\nstore: grep's datum printer fallback catches only its refusal\nexport-code: the block map only on request, --map\ntest: the change-stream guard lists this branch's scripted answers\ntest/export-working: WORKING-11 reads export-code's usage with --map\ntest/store1: the stale-token refusal carries the block's fields\ntest: the guard's expect file is empty again after small batch sb-1115b's landing\n") (parent . root) (ord . 730))))
