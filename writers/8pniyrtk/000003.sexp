943025f7 (229 1789797940043 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (manual-md) (join (list (md-head 1 "theourgia manual") "The model a store holds, and every verb it answers to. This file is generated from the store it describes: the prose is its blocks and the reference is what `describe` answers, so neither can drift from the thing it documents.\n\n" (md-head 2 "The model") (md-head 3 "A store") (md-para "A store") (md-fence "Store layout") (md-head 3 "A block") (md-para "A block") (md-fence "A block, as the store answers it") (md-head 3 "The log is the only truth") (md-para "The log is the only truth") (md-head 4 "Deletion keeps the history") (md-para "Deletion keeps the history") (md-head 3 "One graph over code and prose") (md-para "Everything is a block") (md-head 4 "A name is a block") (md-para "A name is a block") (md-head 4 "Other languages, more modestly") (md-para "Other languages, more modestly") (md-head 3 "Backlinks cost one query") (md-para "Backlinks cost one query") (md-fence "Refs, verbatim") (md-quote "What refs resolves, exactly") (md-head 3 "One query surface") (md-para "One answer shape") (md-head 3 "Put the store in git") (md-para "Put the store in git") (md-head 4 "What to exclude, and what to keep") (md-fence "A store's gitignore") (md-head 4 "What a clone can do, and when") (md-fence "A clone's first write") (md-quote "What adopt does to a clone") (md-head 2 (join (list (number->string (length verb-table)) " verbs"))) (md-para "Reference intro") (md-verbs)))) (doc . "") (parent . "8pniyrtk.2") (ord . 60))))
