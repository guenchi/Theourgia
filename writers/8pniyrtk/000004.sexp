f2219c7f (244 1789822860684 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "Theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "manual.html")) "The 32 verbs"))))) (sec "features" "Core features" "A Living Graph Engine for Human-Agent Symbiosis" #f (prose "Core features lead") (prose "Core features lead 2")) (sec "query" "01" "A minimal query surface for agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One Unified Graph Across Artifacts" (copy "F2 lead") (graph-svg) (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly")))) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "manual.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global Backlinks at Near-Zero Cost" (copy "F3 lead") (code-of "Refs, verbatim") (table-of "F3 cost table") (note-of "What refs resolves, exactly")) (sec "people" "04" "Human-Agent Symbiosis in the IDE" (copy "F4 lead") (prose "IDE design lead") (ulist-of "IDE scarce uses")) (sec "concurrency" "05" "Zero-Conflict Concurrent Workspaces" (copy "F5 lead") (code-of "A refusal, verbatim") (note-of "About that example") (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (one-card "Measured under real concurrency")) (sec "evaluate" "06" "A Living Lisp Machine" (copy "F6 lead") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then.")) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "Branches side by side: not yet" (prose "What evaluation does not do yet"))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
b18f51b8 (245 1789823037855 "ws" () (set "8pniyrtk.20" body (define (topnav here) (define (lk href label) (if (equal? here label) (list (quote a) (list (quote @) (list (quote href) href) (list (quote class) "on")) label) (list (quote a) (list (quote @) (list (quote href) href)) label))) (quasiquote (nav (div (@ (class "wrap")) (div (@ (class "logo")) (a (@ (href "index.html") (style "color:inherit")) (span (raw "&#952;")) " Theourgia")) (div (@ (class "links")) (unquote (lk "why.html" "Why")) (unquote (lk "manual.html" "Manual")) (unquote (lk "changelog.html" "Changelog")) (unquote (lk "agents.html" "Agents")) (a (@ (href "https://github.com/guenchi/theourgia")) "GitHub"))))))))
508fe256 (246 1789823038081 "ws" () (set "8pniyrtk.6d" body (define (manual-md) (join (list (md-head 1 "Theourgia manual") "The model a store holds, and every verb it answers to. This file is generated from the store it describes: the prose is its blocks and the reference is what `describe` answers, so neither can drift from the thing it documents.\n\n" (md-head 2 "The model") (md-head 3 "A store") (md-para "A store") (md-fence "Store layout") (md-head 3 "A block") (md-para "A block") (md-fence "A block, as the store answers it") (md-head 3 "The log is the only truth") (md-para "The log is the only truth") (md-head 4 "Deletion keeps the history") (md-para "Deletion keeps the history") (md-head 3 "One graph over code and prose") (md-para "Everything is a block") (md-head 4 "A name is a block") (md-para "A name is a block") (md-head 4 "Other languages, more modestly") (md-para "Other languages, more modestly") (md-head 3 "Backlinks cost one query") (md-para "Backlinks cost one query") (md-fence "Refs, verbatim") (md-quote "What refs resolves, exactly") (md-head 3 "One query surface") (md-para "One answer shape") (md-head 3 "Put the store in git") (md-para "Put the store in git") (md-head 4 "What to exclude, and what to keep") (md-fence "A store's gitignore") (md-head 4 "What a clone can do, and when") (md-fence "A clone's first write") (md-quote "What adopt does to a clone") (md-head 2 (join (list (number->string (length verb-table)) " verbs"))) (md-para "Reference intro") (md-verbs))))))
8d751699 (247 1789823038212 "ws" () (set "8pniyrtk.6l" body (define (page-manual) (shell "Manual | Theourgia" "The model a store holds and every verb it answers to, generated from the store itself." "Manual" (list (quasiquote (div (@ (class "md-body")) (raw (unquote (md->html (manual-md)))))))))))
d1ad4de2 (248 1789823038342 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "Theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "Theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "manual.html")) "The 32 verbs"))))) (sec "features" "Core features" "A Living Graph Engine for Human-Agent Symbiosis" #f (prose "Core features lead") (prose "Core features lead 2")) (sec "query" "01" "A minimal query surface for agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One Unified Graph Across Artifacts" (copy "F2 lead") (graph-svg) (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly")))) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "manual.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global Backlinks at Near-Zero Cost" (copy "F3 lead") (code-of "Refs, verbatim") (table-of "F3 cost table") (note-of "What refs resolves, exactly")) (sec "people" "04" "Human-Agent Symbiosis in the IDE" (copy "F4 lead") (prose "IDE design lead") (ulist-of "IDE scarce uses")) (sec "concurrency" "05" "Zero-Conflict Concurrent Workspaces" (copy "F5 lead") (code-of "A refusal, verbatim") (note-of "About that example") (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (one-card "Measured under real concurrency")) (sec "evaluate" "06" "A Living Lisp Machine" (copy "F6 lead") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then.")) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "Branches side by side: not yet" (prose "What evaluation does not do yet"))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
0ad14acf (249 1789823047278 "ws" () (set "8pniyrtk.2i" body (define (page-why) (shell "Why not markdown | Theourgia" "The four things a file-per-note memory does badly, what replaces each, and the measurements." "Why" (list (phead "Why not markdown" "Four things a memory made of files does badly, what replaces each, and what the replacement does not do.") (sec "read" "01" "Reading is all or nothing" (copy "Reading is all or nothing") (prose "Reading is all or nothing, measured") (table-of "Query cost table") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Fifty-six questions over twenty documents. The share is of what reading the " "whole document every time would have cost."))) (sec "shape" "02" "The shape degenerates" (copy "The shape degenerates")) (sec "concurrency" "03" "One write lands on top of another" (copy "Two writers meet at the file") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "index.html#concurrency")) "Drafts, commits and what a refusal hands back") " ->"))) (sec "index" "04" "The index drifts away from the text" (copy "The index drifts away from the text") (quasiquote (div (@ (class "grid2")) (unquote (card "What a rename actually does")) (unquote (card "Editing one sentence")))) (table-of "Edit cost table")))))))
94b5aae3 (250 1789823047378 "ws" () (set "8pniyrtk.2u" body (define (page-agents) (shell "For agents and people | Theourgia" "The write protocol, the daemon and the MCP shell, the measured latencies, and two prompts that put a store behind Claude Code's memory." "Agents" (list (phead "For agents, and for the people working beside them" "What an agent has to know to write into a store, what it costs, and two prompts meant to be copied as they are.") (sec "protocol" "01" "The write protocol" (copy "The write protocol")) (sec "shape" "02" "One daemon, thin clients" (copy "Process shape") (prose "Latency, measured")) (sec "cost" "03" "What it costs" #f (quasiquote (div (@ (class "grid2")) (unquote (card "What it costs to move a memory in")) (unquote (card "Recall, measured against markdown"))))) (sec "migrate" "04" "Prompt: move an existing markdown memory in" "Give this to an agent together with the list of files to migrate. One agent per group of files works, and several may write into one store at the same time, each under its own writer id." (code-of "Migration prompt")) (sec "memory" "05" "Prompt: use a store as Claude Code's memory" "Three pieces. Turn the markdown memory off, put the store's outline into the session at startup, and tell the agent how to recall and how to write." (quasiquote (h3 (@ (style "margin-top:26px")) "The session hook")) (code-of "SessionStart hook") (quasiquote (h3 (@ (style "margin-top:26px")) "What goes in CLAUDE.md")) (code-of "Memory prompt") (quasiquote (h3 (@ (style "margin-top:26px")) "Over MCP instead of a shell")) (code-of "MCP registration")))))))
ae878b06 (251 1789823047479 "ws" () (set "8pniyrtk.2v" body (define (page-changelog) (shell "Changelog -- Theourgia" "Released versions of theourgia, newest first." "Changelog" (list (phead "Changelog" (copy "Changelog intro")))))))
