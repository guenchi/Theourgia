(verb-registry-base (base "b0b4776") (describe-entries ((init (usage (init ("--template" <name>) ("--template-file" <template-file>))) (description "Create a store in this directory; with --template (a built-in such as project) or --template-file, then apply that template to it.") (protocol #f) (route local)) (eval (usage (eval ("--lang" <language>) ("--cut" <cut>) ("--under" <library>) ("--working") ("--latest") ("--writer" <name>) ("--timeout-ms" <n>) ("--memory-bytes" <n>) ("--output-bytes" <n>) <source>)) (description "Evaluate source against the store, or against a writer's working view with --working: Scheme by default, another language with --lang, whose runner runs only where the operator has set THEOURGIA_RUNNERS=on. It runs as a child process of the caller, never in the store's server.") (protocol #f) (route child)) (insert (usage (insert ("--under" <id>) ("--after" <id>) "--title" <text> ("--text" <text>) ("--keywords" <text>) ("--premises" <datum>))) (description "Add a block under a parent, with a title and optional text.") (protocol #t) (route daemon)) (set (usage (set <id> <field> <value> ("--if-unchanged" <version>) ("--based-on" <version>) ("--premises" <datum>))) (description "Replace one field of one block.") (protocol #f) (route daemon)) (move (usage (move <id> <parent> ("--after" <id>) ("--premises" <datum>))) (description "Move a block to another parent, optionally after a sibling.") (protocol #f) (route daemon)) (del (usage (del <id> ("--premises" <datum>))) (description "Retire a block. Its history stays.") (protocol #f) (route daemon)) (link (usage (link <from> <rel> <to> ("--premises" <datum>))) (description "Record a named relation between two blocks.") (protocol #f) (route daemon)) (unlink (usage (unlink <from> <rel> <to> ("--premises" <datum>))) (description "Remove a named relation between two blocks.") (protocol #f) (route daemon)) (relation (usage (relation <name> ("--as" <kind>) ("--from" <selector>) ("--to" <selector>) ("--retire") ("--premises" <datum>))) (description "Declare what a relation name does: --as one of the six relations with an effect (supersedes, refutes, depends-on, implements, verifies, conflicts-with), whose rules its edges then follow, or nothing, a listed edge with no effect. --from and --to name the blocks each end is for: a write that adds an edge whose end its selector does not match, or retypes such an end, is refused relation-endpoint. With --retire the name is a plain edge again. The same declaration again answers (ok (unchanged)) and writes nothing.") (protocol #f) (route daemon)) (rule (usage (rule <name> ("--on" <kind>) ("--where" <goal>) ("--must" <goal>) ("--must-not" <goal>) ("--builtin" <name>) ("--retire") ("--premises" <datum>))) (description "Declare a rule of the store: on writes to blocks of the --on kinds (repeated for several), selected by --where when given, the --must goal must have a row for the block, or the --must-not goal none; ?w stands for the block. --builtin names a built-in rule (citation-coverage); --retire ends a rule. A goal is a query goal over the stored facts; one that reads outside the log is refused. Every committed write after it is judged before anything is written; a write that fails is refused rule-violation, naming every failing pair. The same rule again answers (ok (unchanged)) and writes nothing.") (protocol #f) (route daemon)) (write (usage (write <block> <bytes> ("--writer" <name>) ("--based-on" <version>) ("--working-cut" <cut>) ("--working-parent-writer" <name>) ("--working-parent" <version>) ("--rebase"))) (description "Save a draft of a block in a writer's own space, without committing it.") (protocol #t) (route daemon)) (restore (usage (restore <version> ("--writer" <name>))) (description "Take an earlier version of a draft back into a writer's space.") (protocol #f) (route daemon)) (commit (usage (commit (<block> ...) ("--writer" <name>) ("--working-version" <block>=<version>) ("--premises" <datum>))) (description "Install a writer's drafts into the store as one change.") (protocol #f) (route daemon)) (drafts (usage (drafts ("--writer" <name>))) (description "List the drafts a writer is holding.") (protocol #f) (route daemon)) (diagnostics (usage (diagnostics ("--writer" <name>))) (description "List the diagnostics an editor supplied for a writer's working view, by block and then by start, each at a byte range of its block's own src.") (protocol #f) (route daemon)) (discard (usage (discard <block> ("--writer" <name>))) (description "Throw away a writer's draft of a block.") (protocol #f) (route daemon)) (batch (usage (batch <intents> ("--premises" <datum>))) (description "Carry out several changes as one request.") (protocol #f) (route daemon)) (split-suggest (usage (split-suggest <file> ("--output" <review-file>) ("--symbols" <symbols-file>))) (description "Propose where a long file could be divided into blocks. With --symbols, the cuts come from an editor's list of the file's top-level symbols instead of the language's definition patterns; the answer's cuts-from says which.") (protocol #f) (route daemon)) (import-code (usage (import-code <dir> ("--allow-delete") ("--datum") ("--symbols" <symbols-file>) ("--premises" <datum>))) (description "Read a directory of source into the store. With --datum, the whole-line ; comments directly above a form become its doc; a ; comment inside a form is dropped, and the answer warns with its line and column. A #| |# block comment, and any comment inside a datum discarded with #;, is dropped with neither. With --datum, only Scheme files are read: those the language table gives to Scheme by extension (ss, sc, scm, sls, matched exactly); every other file the directory walk returns (it does not enter a name that starts with a dot) is listed, in the order it was walked, in the answer's skipped clause, which is there only when something was skipped. A file the reader refuses is named in the refusal's path clause. Text mode, without --datum, skips a file that is not UTF-8 text or that holds a NUL byte, and lists it in the same skipped clause; it is decided by the bytes, not the name, so a source file in a legacy 8-bit encoding or in UTF-16 is skipped and listed, not imported, unless its bytes happen to be valid UTF-8 with no NUL. With --symbols, a file an editor's symbols file names is split on its first import at those symbols' ranges, every start and every end a cut, as a marked import of the same cuts would split it; a file that already carries markers follows them, and the answer lists it as symbols-ignored. A file whose cuts the scanner does not see at the top level is not imported, and the answer lists it with its refusal as symbols-refused.") (protocol #f) (route daemon)) (export-code (usage (export-code <dir> ("--raw") ("--datum") ("--working") ("--writer" <name>))) (description "Write the store's source back out to a directory.") (protocol #f) (route daemon)) (def (usage (def <name> ("--under" <library>) <source> ("--premises" <datum>))) (description "Define or replace one named definition.") (protocol #f) (route daemon)) (import-md (usage (import-md <dir> ("--allow-delete") ("--premises" <datum>))) (description "Read a directory of markdown into the store.") (protocol #f) (route daemon)) (export-md (usage (export-md <dir> ("--with-ids") ("--working") ("--writer" <name>))) (description "Write the store out as markdown.") (protocol #f) (route daemon)) (supply (usage (supply <kind> <file> ("--for" <writer>) ("--clear"))) (description "Keep facts an editor computed from an export-code projection -- signatures, calls, diagnostics -- beside the store, never in it. The file's header names the projection it was made from; every file it lists is checked against the store's own re-projection, of the committed state or, with --for, of that writer's working view. A fact is used only while the blocks it depends on still project as they did. With --clear, the table the header names is removed.") (protocol #f) (route daemon)) (adopt (usage (adopt)) (description "Take in records that are on disk but not yet in the log.") (protocol #f) (route daemon)) (check (usage (check)) (description "Read the whole store and report whether it is sound.") (protocol #f) (route daemon)) (snapshot (usage (snapshot)) (description "Record the current state as a reduction that can be reopened quickly.") (protocol #f) (route daemon)) (publish (usage (publish <writer> <segment> <file> (<sha256>))) (description "Publish a segment of a writer's log.") (protocol #f) (route daemon)) (outline (usage (outline ("--depth" <n>) ("--with-keywords") ("--with-signatures"))) (description "List the blocks as a tree of titles.") (protocol #f) (route daemon)) (read (usage (read <id> ("--md") ("--recursive") ("--writer" <name>) ("--working") ("--working-info") ("--signature") ("--cut" <cut>) ("--rev"))) (description "Read one block: its fields, or its text. With --signature, the signature an editor supplied for it, of the committed store or, with --working, of the writer's working view. With --cut, the block as it was at a causal cut (a literal or a tag name): the same answer over that cut's state, or unknown-id where the block did not exist yet.") (protocol #f) (route daemon)) (refs (usage (refs <id>)) (description "List the relations a block takes part in.") (protocol #f) (route daemon)) (reach (usage (reach <id> ("--rel" <rel>) ("--depth" <n>))) (description "List the blocks a block reaches over the edges an editor supplied (calls, by default), outward, up to --depth hops (1 by default); the block itself is at depth 0.") (protocol #f) (route daemon)) (search (usage (search <query> ("--all") ("--all-validity"))) (description "Find blocks whose title, keywords or text match every word given.") (protocol #f) (route daemon)) (grep (usage (grep <pattern> ("--under" <id>) ("--all") ("--all-validity"))) (description "List the lines that contain a pattern, literally.") (protocol #f) (route daemon)) (whereis (usage (whereis <name> ("--all-validity"))) (description "Say where a name is defined, and which libraries carry it.") (protocol #f) (route daemon)) (log (usage (log (<id>))) (description "Show the changes recorded, for the store or for one block.") (protocol #f) (route daemon)) (tag (usage (tag (<name>) ("--premises" <datum>))) (description "Name the current cut, or list the names already given.") (protocol #f) (route daemon)) (diff (usage (diff <cut> <cut>)) (description "Report what changed between two cuts.") (protocol #f) (route daemon)) (conflicts (usage (conflicts)) (description "List blocks whose writers disagree.") (protocol #f) (route daemon)) (subscribe (usage (subscribe <stream> <rev> (<token>))) (description "Follow the store's publications: <stream> is changes, and every publication after <rev> arrives as a line naming what changed, until the stream ends. 0 starts from now; a resume names the daemon token its acceptance gave.") (protocol #f) (route stream)) (scope (usage (scope <dir> "--cut" <cut> "--roots" <id> "--for" <actor>)) (description "Make a new store at <dir> holding a letter to <actor> and a copy of each block under the roots as it was at the cut, each copy carrying origin (the block's id here) and origin-cut; the edges between copies are copied, an edge leaving the roots is dropped and listed, and a contested field is listed and not copied. The letter copy's baseline is the new store's cut after the copies. --roots is given once per root. One record is written here: the letter, at the top level, with to, status, cut, roots and scope. An existing <dir> is refused before anything is written, and so is a block or edge the write would refuse. It runs in the caller's own program -- the command line's, or the MCP shell's child -- never in a store's server.") (protocol #f) (route child)) (collect (usage (collect <dir>)) (description "Bring a scoped store's review results back under its letter here: the blocks the letter's reviewer created in <dir>, with their settled fields, under the reviewer's name, and their about edges, to the origin of a copy or to the collected block. A second collect writes nothing new. It runs in the caller's own program -- the command line's, or the MCP shell's child -- never in a store's server.") (protocol #f) (route child)) (review-results (usage (review-results)) (description "In a scoped store, list the review results as one datum: each live block the letter's reviewer created that is not a copy, with its parent, settled fields and the actor of each, and its about targets; a finding with no about and a verdict missing a condition field are listed.") (protocol #f) (route daemon)) (collect-into (usage (collect-into <letter-id> "--results" <datum>)) (description "Write a review-results datum under a letter: the blocks not collected before, then the about edges not present, as the reviewer's records. Answers how many were inserted, linked and already linked, and every field another actor set.") (protocol #f) (route daemon)) (describe (usage (describe)) (description "List the verbs, what each is for, and the writing protocol.") (protocol #f) (route daemon)))) (describe-verbs (init eval insert set move del link unlink relation rule write restore commit drafts diagnostics discard batch split-suggest import-code export-code def import-md export-md supply adopt check snapshot publish outline read refs reach search grep whereis log tag diff conflicts subscribe scope collect review-results collect-into describe)) (answers (((conflicts) (ok (items))) ((search "no such text anywhere") (ok (items) (cut ()) (scanned (blocks 0) (fields (title keywords src names doc body)) (unreadable-blocks 0)) (coverage (defs (names 0)) (names-from (datum lexical))))))))
