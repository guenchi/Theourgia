      (list 2 (list (list wa 'doc)) #t))

;; ---- NOT FORWARD ------------------------------------------------------------------------------
(printf "== FWD: only a reduction moved forward ==\n")
(define V (store! "forward"))
(define va (make V 'doc "a"))
(define vst1 (state V))
(define VS (make-query-session vst1))
(hold! VS '(kind ?b ?k))
(define vst1b (state V))
(make V 'doc "b")
(define vst2 (state V))
(want "FWD-1 the same reduction, an equal cut, a cut that does not cover: not-forward, no new session"
      (in-order (advance VS vst1) (advance VS vst1b) (advance (make-query-session vst2) vst1))
      '((error not-forward) (error not-forward) (error not-forward)))
;; REDUCTIONS BUILT RECORD BY RECORD, as the admission fixture builds them:
;; a plan of one insert by writer O, its member at index 0 applied; a second
;; valid member at 0 from another writer makes both conflict, the applied one
;; withdrawn, and the reduction is rebuilt in place
(define fo "fw000000")
(define (fw-plan! r)
  (reduce-apply! r fo 1 '() (list 'plan "w" "fp" (cons fo 0) (list (cons 0 (list 'insert 'root #f (list (cons 'kind 'section) (cons 'title "w0"))))))
                 (list "test" (cons fo "w") 'plan "fp" #f (cons fo 0))))
(define (fw-member! r w seq deps title)
  (reduce-apply! r w seq deps (list 'put (list (cons 'kind 'section) (cons 'title title) '(parent . root) '(ord . 1)))
                 (list "test" (cons fo "w") 0 "fp" (cons fo 1) (cons fo 0))))
(define (fw-gate r w n) (let ((p (assoc (cons w n) (reduce-gates r)))) (and p (cdr p))))
(define r-planned (let ((r (reduce-empty))) (fw-plan! r) r))
(define r-applied (let ((r (reduce-clone r-planned))) (fw-member! r fo 2 '() "w0") r))
(define r-withdrawn (let ((r (reduce-clone r-applied))) (fw-member! r "fw100000" 1 (list (cons fo 1)) "w0") r))
(want "FWD-2 a rebuild that withdrew an event the first state had applied: not forward"
      (in-order (fw-gate r-applied fo 2) (fw-gate r-withdrawn fo 2) (forward? r-applied r-withdrawn)
                (advance (make-query-session r-applied) r-withdrawn))
      '(#f plan-conflict #f (error not-forward)))
(define r-later
  (let ((r (reduce-clone r-withdrawn)))
    (reduce-apply! r "fw200000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "z") '(parent . root) '(ord . 2))))
    r))
(want "FWD-3 a rebuild between the states that withdrew only later events, the cut covering and moved: forward"
      (in-order (forward? r-planned r-later) (session? (advance (make-query-session r-planned) r-later)))
      '(#t #t))
(want "FWD-4 a history that is not a suffix (another record before the shared one): not forward"
      (let ((other (let ((r (reduce-empty)))
                     (reduce-apply! r "fw300000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "o") '(parent . root) '(ord . 3))))
                     (fw-plan! r)
                     r)))
        (in-order (forward? r-planned other) (advance (make-query-session r-planned) other)))
      '(#f (error not-forward)))

(want "FWD-5 the same event identities with another payload (the plan's title): not forward, records compared whole"
      (let ((other (let ((r (reduce-empty)))
                     (reduce-apply! r fo 1 '() (list 'plan "w" "fp" (cons fo 0) (list (cons 0 (list 'insert 'root #f (list (cons 'kind 'section) (cons 'title "w1"))))))
                                    (list "test" (cons fo "w") 'plan "fp" #f (cons fo 0)))
                     (reduce-apply! r "fw400000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "p") '(parent . root) '(ord . 4))))
                     r)))
        (in-order (reduce-applied-cut other) (forward? r-planned other) (advance (make-query-session r-planned) other)))
      (list (list (cons fo 1) (cons "fw400000" 1)) #f '(error not-forward)))

(want "FWD-6 the same event identities and payloads with another actor: not forward"
      (let ((other (let ((r (reduce-empty)))
                     (reduce-apply! r fo 1 '() (list 'plan "w" "fp" (cons fo 0) (list (cons 0 (list 'insert 'root #f (list (cons 'kind 'section) (cons 'title "w0"))))))
                                    (list "test2" (cons fo "w") 'plan "fp" #f (cons fo 0)))
                     (reduce-apply! r "fw500000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "q") '(parent . root) '(ord . 5))))
                     r)))
        (in-order (reduce-applied-cut other) (forward? r-planned other) (advance (make-query-session r-planned) other)))
      (list (list (cons fo 1) (cons "fw500000" 1)) #f '(error not-forward)))

(want "FWD-7 the same event identity, payload and actor with other dependencies: not forward"
      (let ((other (let ((r (reduce-empty)))
                     (reduce-apply! r fo 1 (list (cons "fw600000" 1))
                                    (list 'plan "w" "fp" (cons fo 0) (list (cons 0 (list 'insert 'root #f (list (cons 'kind 'section) (cons 'title "w0"))))))
                                    (list "test" (cons fo "w") 'plan "fp" #f (cons fo 0)))
                     (reduce-apply! r "fw600000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "d") '(parent . root) '(ord . 6))))
                     r)))
        (in-order (reduce-applied-cut other) (forward? r-planned other) (advance (make-query-session r-planned) other)))
      (list (list (cons fo 1) (cons "fw600000" 1)) #f '(error not-forward)))

(system (string-append "rm -rf '" root "'"))
(printf "rows: ~a\n~a failures\nsession-advance complete\n" rows bad)
(exit (if (zero? bad) 0 1))
