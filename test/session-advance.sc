      (in-order (car (inspected TS2 'low '?x)) (inspected TS2 'mid '?x) (inspected TS2 'top '?x)
                (rows-of TS2 '(top ?x)) (oracle tst2 '(top ?x)))
      (list 'complete #f #f (sorted (list (list t1) (list t2))) (sorted (list (list t1) (list t2)))))

