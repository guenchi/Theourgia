;; A query session advanced to a later state (query.sc, session-advance): a
;; new session at the later state holding the tables of the old one's named
;; keys that are carried, each what a fresh session would hold, maintained by
;; delete-and-rederive; the old session untouched. Each row first INSPECTS
;; the new session's tables (a seam that reads without evaluating), then asks
;; it and a fresh session at the same state the same keys (the oracle).
;; Stores are built through the verbs, a concurrent writer's record published
;; as another writer's segment; each state is its own reduction object.

(import (chezscheme) (theourgia rpc)
        (only (theourgia extensions) extension-verbs)
        (only (theourgia query) make-query-session session-answer session-spent session-budget-set!)
        (only (theourgia store) open-and-reduce)
        (only (theourgia reduce) reduce-applied-cut block-id reduce-empty reduce-apply! reduce-clone reduce-gates)
        (only (theourgia wire) encode-record storable-encode)
        (only (theourgia log) log-publish! segment-sha))

;; LOOKED UP, NOT IMPORTED: the base has none of them, and each row reads red
;; there on its own; an absent entry point answers the symbol absent, which no
;; row expects
(define (late lib name) (guard (e (#t #f)) (eval name (environment lib))))
(define advance-proc (late '(theourgia query) 'session-advance))
(define table-of-proc (late '(theourgia query) 'session-table-of))
(define named-expansions-proc (late '(theourgia query) 'session-named-expansions))
(define root-names-proc (late '(theourgia query) 'session-root-names))
(define forward-proc (late '(theourgia reduce) 'reduction-forward?))
(define (advance S st) (if advance-proc (advance-proc S st) 'absent))
(define (table-of S . key) (if table-of-proc (apply table-of-proc S key) 'absent))
(define (named-expansions S) (if named-expansions-proc (named-expansions-proc S) 'absent))
(define (root-names S) (if root-names-proc (root-names-proc S) 'absent))
(define (forward? a b) (if forward-proc (forward-proc a b) 'absent))
(define (session? x) (and x (not (symbol? x)) (not (pair? x))))
(define bad 0)
(define rows 0)
(define-syntax in-order
  (syntax-rules ()
    ((_) '())
    ((_ e rest ...) (let ((v e)) (cons v (in-order rest ...))))))
(define (want-1 name got expected)
  (set! rows (+ rows 1))
  (if (equal? got expected)
      (printf "ok   ~a\n" name)
      (begin (set! bad (+ bad 1)) (printf "FAIL ~a -> ~s   WANT ~s\n" name got expected))))
(include "expected.ss")
(define-syntax want
  (syntax-rules ()
    ((_ name got expected)
     (with-expected name expected (x) (want-1 name (guard (e (#t (list 'RAISED (if (and (condition? e) (message-condition? e))
                                                                                 (condition-message e) e)
                                                                     (if (and (condition? e) (irritants-condition? e)) (condition-irritants e) '()))))
                                                    got) x)))))

(define root (string-append (or (getenv "THEOURGIA_TEST_ROOT") "/tmp") "/session-advance-" (number->string (get-process-id))))
(system (string-append "rm -rf '" root "'; mkdir -p '" root "/home'"))
(putenv "THEOURGIA_HOME" (string-append root "/home"))
(register-verbs! extension-verbs)

;; ---- stores, verbs, readings --------------------------------------------------------

(define n 0)
(define (store! name)
  (set! n (+ n 1))
  (let ((st (string-append root "/" name "-" (number->string n))))
    (rpc-dispatch st '(init) "author")
    st))
(define (on st . args) (rpc-dispatch st args "author"))
;; a state: the store's reduction now, a new object each time
(define (state st) (open-and-reduce st))
(define (cut-of st) (reduce-applied-cut (state st)))
(define (head-of a) (if (and (pair? a) (eq? (car a) 'error) (pair? (cdr a))) (list 'error (cadr a)) (and (pair? a) (car a))))
(define (head3 a) (if (and (list? a) (>= (length a) 3)) (list-head a 3) a))
(define (clause-of a name) (and (pair? a) (list? a) (find (lambda (c) (and (pair? c) (eq? (car c) name))) (cdr a))))
(define (new-id a)
  (let* ((ev (and (pair? a) (eq? (car a) 'ok) (assq 'events (cdr a))))
         (e (and ev (pair? (cadr ev)) (car (cadr ev)))))
    (and (pair? e) (block-id (car e) (cdr e)))))
(define (batch st . intents) (on st 'batch (format "~s" intents)))
(define (make st kind title)
  (let ((a (batch st (list 'insert 'root #f (list (cons 'kind kind) (cons 'title title))))))
    (new-id (car (cadr a)))))
(define (link! st from rel to) (on st 'link from rel to))
(define (unlink! st from rel to) (on st 'unlink from rel to))
(define (field! st id name value) (batch st (list 'set id name value)))
(define (derive! st name value) (on st 'derive (symbol->string name) (format "~s" value)))
(define (retire! st name) (on st 'derive (symbol->string name) "--retire"))
(define (local-writer st)
  (let ((p (clause-of (on st 'position) 'position))) (and p (car (cadr p)))))
;; a record from another writer, PEER (eight characters), whose premise is PAST on the local writer.
;; A STORE IS REPLAYED WRITER BY WRITER IN NAME ORDER, so a peer whose name
;; sorts before the local writer's is delivered before the local history and
;; the later state's history no longer ends with the earlier one's (not
;; forward); the local name is eight base-36 digits, so a peer named
;; zzzzzzzz sorts after it (or equals it, one chance in 36^8)
(define (forge! st peer payload past)
  (let* ((w (let ((w (local-writer st)))
              (when (equal? w peer) (error 'forge! "the local writer has the peer's name; rerun" w))
              w))
         (bytes (encode-record 1 1789000000001 "peer" (list (cons w (cdr (assoc w past)))) (storable-encode payload))))
    (log-publish! st peer 1 bytes (segment-sha bytes))))
(define (sorted rs) (list-sort (lambda (x y) (string<? (format "~s" x) (format "~s" y))) rs))
;; a session's rows of GOAL, sorted; a refusal as it is
(define (rows-of S goal)
  (let ((a (session-answer S goal))) (if (and (pair? a) (eq? (car a) 'ok)) (sorted (cadr a)) a)))
;; an inspected table: (complete <tuples sorted>), or what the seam answers
(define (inspected S . key)
  (let ((t (apply table-of S key))) (if (and (pair? t) (pair? (cdr t))) (list (car t) (sorted (cadr t))) t)))
;; the oracle: a fresh session at the same state asked the same goal
(define (oracle st goal) (rows-of (make-query-session st) goal))
(define (identity name rel arity kinds)
  (let ((vars (let loop ((i 0) (out '())) (if (= i arity) (reverse out) (loop (+ i 1) (cons (string->symbol (string-append "?v" (number->string i))) out))))))
    (list (cons 'head (list (cons name kinds))) (cons 'clause (cons (cons name vars) (list (cons rel vars)))))))
;; what a fresh session at ST spends building every edge (a row-less query)
(define (edge-build st) (let ((S (make-query-session st))) (session-answer S '(and (edge ?a ?r ?b) (/= ?a ?a))) (session-spent S)))
;; held: S asked GOAL, so its keys are complete in S
(define (hold! S goal) (session-answer S goal))

;; ---- BASE: the delta of a stored fact relation, by enumeration at two cuts -------------------
(printf "== BASE: what a fact relation adds and retracts between two cuts ==\n")
;; stored identity relations over the facts, held in S: their carried tables
;; show the facts' delta
(define B (store! "base"))
(define ba (make B 'doc "a"))
(define bb (make B 'doc "b"))
(define bc (make B 'doc "c"))
(define bx (make B 'doc "x"))
(define by (make B 'doc "y"))
(link! B ba "cites" bb)
(link! B bx "depends-on" by)
(link! B bc "depends-on" bb)
(field! B ba 'n 1)
(field! B ba 'm 1)
(field! B bc 'spell bb)
(define bs (make B 'section "s"))
(define bz (make B 'section "z"))
(define blib (new-id (car (cadr (batch B (list 'insert 'root #f (list (cons 'kind 'library) (cons 'name '(my lib)))))))))
(define b-uses (link! B bx "leans-on" bz))
(define bcode (new-id (car (cadr (batch B (list 'insert blib #f (list (cons 'kind 'code) (cons 'title "fn"))))))))
(derive! B 'iff (identity 'iff 'field 3 '(ID STR ANY)))
(derive! B 'ife (identity 'ife 'edge 3 '(ID SYM ID)))
(derive! B 'ifv (identity 'ifv 'validity 2 '(ID (SYM valid needs-review refuted superseded))))
(derive! B 'ifr (identity 'ifr 'validity-reason 3 '(ID SYM ID)))
(derive! B 'ifu (identity 'ifu 'under 2 '(ID PARENT)))
(derive! B 'ifl (identity 'ifl 'in-library 2 '(ID NAME-OR-NONE)))
(derive! B 'ifk (identity 'ifk 'edge-kind 3 '(ID SYM ID)))
(define base-keys '((iff ?b ?n ?v) (ife ?a ?r ?b) (ifv ?b ?v) (ifr ?a ?w ?b) (ifu ?b ?p) (ifl ?b ?n) (ifk ?a ?k ?b)))
(define b1 (state B))
(define BS (make-query-session b1))
(for-each (lambda (g) (hold! BS g)) base-keys)
(define b-past (cut-of B))
(field! B ba 'n 2)
(field! B ba 'm 2)
(forge! B "zzzzzzzz" (list 'set ba 'm 3) b-past)
(unlink! B ba "cites" bb)
(on B 'set by "title" "y moved")
(on B 'del bb)
(define b-moved (on B 'move bz bs))
(define b-renamed (field! B blib 'name '(my lib2)))
(define b-declared (on B 'relation "leans-on" "--as" "depends-on"))
(define b2 (state B))
(define BS2 (advance BS b2))
(define (member-of? t tbl) (if (pair? tbl) (and (member t (cadr tbl)) #t) tbl))
(want "BASE-1 a field set to another value: the old tuple retracted, the new one added"
      (let ((t (inspected BS2 'iff '?b '?n '?v)))
        (list (car t) (member-of? (list ba "n" 1) t) (member-of? (list ba "n" 2) t)))
      '(complete #f #t))
(want "BASE-2 a field two writers set differently is no longer settled: its tuple retracted"
      (let ((t (inspected BS2 'iff '?b '?n '?v)))
        (list (member-of? (list ba "m" 1) t) (member-of? (list ba "m" 2) t) (member-of? (list ba "m" 3) t)))
      '(#f #f #f))
(want "BASE-3 an edge unlinked: retracted"
      (member-of? (list ba 'cites bb) (inspected BS2 'ife '?a '?r '?b))
      #f)
(want "BASE-4 a premise changed: its dependent's validity valid retracted, needs-review added, the dependent untouched by any record"
      (let ((t (inspected BS2 'ifv '?b '?v)))
        (list (member-of? (list bx 'valid) t) (member-of? (list bx 'needs-review) t)))
      '(#f #t))
(want "BASE-5 a block deleted: its own tuples retracted, premise-gone added for its dependent, another block's field spelling its id kept"
      (list (member-of? (list bb 'valid) (inspected BS2 'ifv '?b '?v))
            (member-of? (list bc 'premise-gone bb) (inspected BS2 'ifr '?a '?w '?b))
            (member-of? (list bc "spell" bb) (inspected BS2 'iff '?b '?n '?v)))
      '(#f #t #t))
(want "BASE-6 a block moved: its under tuple at the old parent retracted, at the new one added"
      (let ((t (inspected BS2 'ifu '?b '?p)))
        (list (head-of b-moved) (member-of? (list bz "root") t) (member-of? (list bz bs) t)))
      '(ok #f #t))
(want "BASE-8 a library renamed: the code block under it changes library, no record of its own (a tuple of a block the write did not name)"
      (let ((old (inspected BS 'ifl '?b '?n)) (new (inspected BS2 'ifl '?b '?n)))
        (list (head-of b-renamed)
              (and (pair? old) (pair? new) (length (filter (lambda (t) (equal? (car t) bcode)) (cadr old))))
              (and (pair? new) (equal? (cadr new) (oracle b2 '(ifl ?b ?n))))
              (and (pair? old) (pair? new) (equal? (cadr old) (cadr new)))))
      '(batch 1 #t #f))
(want "BASE-7 every identity table complete in the new session before any ask, then each the fresh session's, the asks expanding nothing"
      (let* ((kinds (map (lambda (g) (let ((t (apply inspected BS2 g))) (if (pair? t) (car t) t))) base-keys))
             (before (named-expansions BS2))
             (same (map (lambda (g) (equal? (rows-of BS2 g) (oracle b2 g))) base-keys)))
        (list kinds same (if (number? before) (- (named-expansions BS2) before) before)))
      '((complete complete complete complete complete complete complete) (#t #t #t #t #t #t #t) 0))
(want "BASE-9 a relation name given a kind: the edge under it gains an edge-kind tuple, no edge written"
      (let ((t (inspected BS2 'ifk '?a '?k '?b)))
        (list (head-of b-uses) (head-of b-declared)
              (member-of? (list bx 'depends-on bz) (inspected BS 'ifk '?a '?k '?b)) (member-of? (list bx 'depends-on bz) t)))
      '(ok ok #f #t))

;; ---- DRED: positive strata, delete and rederive ----------------------------------------------
(printf "== DRED: a positive stratum maintained ==\n")
(define (reach-clauses name)
  (list (list 'head (list name 'ID 'ID))
        (list 'clause (list name '?a '?b) '(edge ?a cites ?b))
        (list 'clause (list name '?a '?b) '(edge ?a cites ?m) (list name '?m '?b))))
;; INSERTION, several recursive steps out, and a key of the stratum demanded
(define D (store! "dred"))
(define d1 (make D 'doc "1"))
(define d2 (make D 'doc "2"))
(define d3 (make D 'doc "3"))
(define d4 (make D 'doc "4"))
(define d5 (make D 'doc "5"))
(link! D d1 "cites" d2)
(link! D d2 "cites" d3)
(link! D d3 "cites" d4)
(derive! D 'rch (reach-clauses 'rch))
(define dst1 (state D))
(define DS (make-query-session dst1))
(hold! DS (list 'rch d1 '?x))
(link! D d4 "cites" d5)
(define dst2 (state D))
(define DS2 (advance DS dst2))
(want "BUDGET-2 the advance is charged its insertions: the four tuples ending at 5, exactly, beyond the edge enumeration at both states"
      (let ((n1 (edge-build dst1)) (n2 (edge-build dst2)) (spent (if (session? DS2) (session-spent DS2) DS2)))
        (in-order (list n1 n2) (and (number? spent) (- spent (+ n1 n2)))))
      (list (list 3 4) 4))
(want "DRED-1 an edge added at the end of a chain: the tuples four recursive steps out derived, inspected before any ask"
      (in-order (inspected DS2 'rch d1 '?x) (inspected DS2 'rch d2 '?x) (inspected DS2 'rch d3 '?x) (inspected DS2 'rch d4 '?x))
      (list (list 'complete (sorted (map (lambda (b) (list d1 b)) (list d2 d3 d4 d5))))
            (list 'complete (sorted (map (lambda (b) (list d2 b)) (list d3 d4 d5))))
            (list 'complete (sorted (map (lambda (b) (list d3 b)) (list d4 d5))))
            (list 'complete (list (list d4 d5)))))
(want "DRED-2 a key of the same stratum S never held, demanded by the insertion: evaluated inside the advance, complete"
      (inspected DS2 'rch d5 '?x)
      '(complete ()))
(want "DRED-3 S's roots are not in the new session, and asking a carried key adds no named expansion"
      (let ((before (named-expansions DS2)))
        (in-order (filter (lambda (r) (member r (root-names DS2))) (root-names DS))
                  (equal? (rows-of DS2 (list 'rch d1 '?x)) (oracle dst2 (list 'rch d1 '?x)))
                  (- (named-expansions DS2) before)))
      '(() #t 0))
;; A KEY OF THE SAME STRATUM DEMANDED BY THE INSERTION, NOT EMPTY, AND
;; EVALUATED WHILE A HELD KEY IT READS IS STILL SHORT: a cites b, c cites d,
;; d cites e; hold rch(a, ?) and rch(d, ?); insert b cites c and e cites f.
;; In the first round rch(b, ?) demands rch(c, ?), evaluated then over
;; rch(d, ?) = {(d e)}: {(c d) (c e)}. rch(d, ?) gains (d f) only in the second
;; round (through (e f)), and rch(c, ?) gains (c f) only because it joined the
;; maintained set; (b f) and (a f) follow from it
(define DN (store! "demand-nonempty"))
(define dna (make DN 'doc "a"))
(define dnb (make DN 'doc "b"))
(define dnc (make DN 'doc "c"))
(define dnd (make DN 'doc "d"))
(define dne (make DN 'doc "e"))
(define dnf (make DN 'doc "f"))
(link! DN dna "cites" dnb)
(link! DN dnc "cites" dnd)
(link! DN dnd "cites" dne)
(derive! DN 'rch (reach-clauses 'rch))
(define dnst1 (state DN))
(define DNS (make-query-session dnst1))
(hold! DNS (list 'rch dna '?x))
(hold! DNS (list 'rch dnd '?x))
(link! DN dnb "cites" dnc)
(link! DN dne "cites" dnf)
(define dnst2 (state DN))
(define DNS2 (advance DNS dnst2))
(define (dn-pairs from tos) (sorted (map (lambda (t) (list from t)) tos)))
(want "DRED-8 a demanded key of the stratum, evaluated while a held key it reads is short, joins the maintained set: rch(c, ?) gains f, and so do b and a, inspected, then the oracle's"
      (in-order (inspected DNS 'rch dnc '?x)
                (inspected DNS2 'rch dna '?x) (inspected DNS2 'rch dnb '?x) (inspected DNS2 'rch dnc '?x) (inspected DNS2 'rch dnd '?x)
                (if (session? DNS2) (equal? (rows-of DNS2 (list 'rch dna '?x)) (oracle dnst2 (list 'rch dna '?x))) DNS2))
      (list #f
            (list 'complete (dn-pairs dna (list dnb dnc dnd dne dnf)))
            (list 'complete (dn-pairs dnb (list dnc dnd dne dnf)))
            (list 'complete (dn-pairs dnc (list dnd dne dnf)))
            (list 'complete (dn-pairs dnd (list dne dnf)))
            #t))

;; TWO FACTS GONE: p of a block citing two others, both edges unlinked at once
(define P (store! "two-facts"))
(define px (make P 'doc "x"))
(define py (make P 'doc "y"))
(define pz (make P 'doc "z"))
(link! P px "cites" py)
(link! P px "cites" pz)
(derive! P 'twoc '((head (twoc ID)) (clause (twoc ?x) (edge ?x cites ?y) (edge ?x cites ?z) (/= ?y ?z))))
(define pst1 (state P))
(define PS (make-query-session pst1))
(hold! PS '(twoc ?x))
(unlink! P px "cites" py)
(unlink! P px "cites" pz)
(define pst2 (state P))
(define PS2 (advance PS pst2))
(want "DRED-4 a tuple that needed two facts, both gone in one advance: deleted (each delta joined with the other's OLD value), inspected empty"
      (inspected PS2 'twoc '?x)
      (list 'complete '()))
(want "DRED-5 the same advance: S's own table still holds the tuple (S untouched)"
      (inspected PS 'twoc '?x)
      (list 'complete (list (list px))))
;; DELETION ONLY: an edge of one path retracted, another path to the same end
(define E (store! "deletion"))
(define e1 (make E 'doc "1"))
(define e2 (make E 'doc "2"))
(define e3 (make E 'doc "3"))
(define e4 (make E 'doc "4"))
(for-each (lambda (p) (link! E (car p) "cites" (cdr p))) (list (cons e1 e2) (cons e2 e4) (cons e1 e3) (cons e3 e4)))
(derive! E 'rch (reach-clauses 'rch))
(define est1 (state E))
(define ES (make-query-session est1))
(hold! ES (list 'rch e1 '?x))
(unlink! E e2 "cites" e4)
(define est2 (state E))
(define ES2 (advance ES est2))
(want "DELETION-ONLY a middle edge retracted: what lay beyond it through 2 deleted, (1 4) re-derived through 3, nothing inserted; every carried key, the empty one included; charged exactly two deletions and two derivations (the restored (1 4), and (3 4) of the key rch(3, 4) the re-derivation demands)"
      (let ((n1 (edge-build est1)) (n2 (edge-build est2)) (spent (if (session? ES2) (session-spent ES2) ES2)))
        (in-order (inspected ES2 'rch e2 '?x) (inspected ES2 'rch e1 '?x) (inspected ES2 'rch e3 '?x) (inspected ES2 'rch e4 '?x)
                  (list n1 n2) (and (number? spent) (- spent (+ n1 n2)))))
      (list (list 'complete '()) (list 'complete (sorted (list (list e1 e2) (list e1 e3) (list e1 e4))))
            (list 'complete (list (list e3 e4))) (list 'complete '()) (list 4 3) 4))
;; A LOWER STRATUM'S KEY DEMANDED, and a positive stratum above a positive one
(define Q (store! "demand"))
(define qa (make Q 'doc "a"))
(define qb (make Q 'doc "b"))
(define qc (make Q 'doc "c"))
(define qd (make Q 'doc "d"))
(link! Q qa "cites" qb)
(link! Q qb "depends-on" qd)
(link! Q qc "depends-on" qd)
(derive! Q 'lo '((head (lo ID ID)) (clause (lo ?x ?y) (edge ?x depends-on ?y))))
(derive! Q 'up '((head (up ID ID)) (clause (up ?x ?z) (edge ?x cites ?y) (lo ?y ?z))))
(define qst1 (state Q))
(define QS (make-query-session qst1))
(hold! QS (list 'up qa '?z))
(link! Q qa "cites" qc)
(define qst2 (state Q))
(define QS2 (advance QS qst2))
(want "DEMAND-1 a lower stratum's key S never held (lo of c), demanded by the insertion: evaluated inside the advance"
      (in-order (inspected QS 'lo qc '?z) (inspected QS2 'lo qc '?z) (inspected QS2 'up qa '?z))
      (list #f (list 'complete (list (list qc qd))) (list 'complete (list (list qa qd)))))
;; THE OLD DATABASE FOR A KEY S DOES NOT HOLD: v(a, ?) through lo(a, y) and
;; lo2(y, z); lo2(b, c) retracted: the over-deletion asks lo(a, b), both
;; arguments bound, which S never asked
(define O (store! "old-join"))
(define oa (make O 'doc "a"))
(define ob (make O 'doc "b"))
(define oc (make O 'doc "c"))
(link! O oa "cites" ob)
(link! O ob "depends-on" oc)
(derive! O 'lo '((head (lo ID ID)) (clause (lo ?x ?y) (edge ?x cites ?y))))
(derive! O 'lo2 '((head (lo2 ID ID)) (clause (lo2 ?x ?y) (edge ?x depends-on ?y))))
(derive! O 'vv '((head (vv ID ID)) (clause (vv ?x ?z) (lo ?x ?y) (lo2 ?y ?z))))
(define ost1 (state O))
(define OS (make-query-session ost1))
(hold! OS (list 'vv oa '?z))
(hold! OS (list 'version oa '?v))
;; read before S's invariants are taken: the query itself spends
(define oa-version-before (rows-of OS (list 'version oa '?v)))
(define os-keys-before (list (inspected OS 'lo oa ob) (inspected OS 'vv oa '?z) (session-spent OS) (named-expansions OS)))
(unlink! O ob "depends-on" oc)
(on O 'set oa "title" "a moved on")
(define ost2 (state O))
(define OS2 (advance OS ost2))
(want "OLD-JOIN an over-deletion that asks the old database for a key S never held: answered at S's state, the tuple deleted, S untouched"
      (in-order (inspected OS2 'vv oa '?z) (list (inspected OS 'lo oa ob) (inspected OS 'vv oa '?z) (session-spent OS) (named-expansions OS)))
      (list (list 'complete '()) os-keys-before))
