;; REDUCTIONS BUILT RECORD BY RECORD, as the admission fixture builds them:
;; a plan of one insert by writer O, its member at index 0 applied; a second
;; valid member at 0 from another writer makes both conflict, the applied one
;; withdrawn, and the reduction is rebuilt in place
(define fo "fw000000")
(define (fw-plan! r)
  (reduce-apply! r fo 1 '() (list 'plan "w" "fp" (cons fo 0) (list (cons 0 (list 'insert 'root #f (list (cons 'kind 'section) (cons 'title "w0"))))))
                 (list "test" (cons fo "w") 'plan "fp" #f (cons fo 0))))
(define (fw-member! r w seq deps title)
  (reduce-apply! r w seq deps (list 'put (list (cons 'kind 'section) (cons 'title title) '(parent . root) '(ord . 1)))
                 (list "test" (cons fo "w") 0 "fp" (cons fo 1) (cons fo 0))))
(define (fw-gate r w n) (let ((p (assoc (cons w n) (reduce-gates r)))) (and p (cdr p))))
(define r-planned (let ((r (reduce-empty))) (fw-plan! r) r))
(define r-applied (let ((r (reduce-clone r-planned))) (fw-member! r fo 2 '() "w0") r))
(define r-withdrawn (let ((r (reduce-clone r-applied))) (fw-member! r "fw100000" 1 (list (cons fo 1)) "w0b") r))
(want "FWD-2 a rebuild that withdrew an event the first state had applied: not forward"
      (in-order (fw-gate r-applied fo 2) (fw-gate r-withdrawn fo 2) (forward? r-applied r-withdrawn))
      '(#f plan-conflict #f))
(define r-later
  (let ((r (reduce-clone r-withdrawn)))
    (reduce-apply! r "fw200000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "z") '(parent . root) '(ord . 2))))
    r))
(want "FWD-3 a rebuild between the states that withdrew only later events, the cut covering and moved: forward"
      (forward? r-planned r-later)
      #t)
(want "FWD-4 a history that is not a suffix (another record before the shared one): not forward"
      (let ((other (let ((r (reduce-empty)))
                     (reduce-apply! r "fw300000" 1 '() (list 'put (list (cons 'kind 'section) (cons 'title "o") '(parent . root) '(ord . 3))))
                     (fw-plan! r)
                     r)))
        (forward? r-planned other))
      #f)

