9cc69dd6 (90 1789760073411 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-why) (shell "Why not markdown -- theourgia" "The four things a file-per-note memory does badly, what replaces each, and the measurements." "Why" (list (phead "Why not markdown" "Four things a memory made of files does badly, what replaces each, and what the replacement does not do.") (sec "read" "01" "Reading is all or nothing" (copy "Reading is all or nothing") (prose "Reading is all or nothing, measured") (table-of "Query cost table") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Fifty-six questions over twenty documents. The share is of what reading the " "whole document every time would have cost."))) (sec "shape" "02" "The shape degenerates" (copy "The shape degenerates") (prose "Editing one sentence)")) (sec "concurrency" "03" "Two writers meet at the file" (copy "Two writers meet at the file") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "concurrency.html")) "Drafts, commits and what a refusal hands back") " ->"))) (sec "index" "04" "The index drifts away from the text" (copy "The index drifts away from the text") (quasiquote (div (@ (class "grid2")) (unquote (card "What a rename actually does")) (unquote (card "Editing one sentence")))) (table-of "Edit cost table"))))) (doc . "") (parent . "8pniyrtk.2") (ord . 38))))
f46d844f (91 1789760085495 "ws" () (set "8pniyrtk.2i" body (define (page-why) (shell "Why not markdown -- theourgia" "The four things a file-per-note memory does badly, what replaces each, and the measurements." "Why" (list (phead "Why not markdown" "Four things a memory made of files does badly, what replaces each, and what the replacement does not do.") (sec "read" "01" "Reading is all or nothing" (copy "Reading is all or nothing") (prose "Reading is all or nothing, measured") (table-of "Query cost table") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Fifty-six questions over twenty documents. The share is of what reading the " "whole document every time would have cost."))) (sec "shape" "02" "The shape degenerates" (copy "The shape degenerates")) (sec "concurrency" "03" "Two writers meet at the file" (copy "Two writers meet at the file") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "concurrency.html")) "Drafts, commits and what a refusal hands back") " ->"))) (sec "index" "04" "The index drifts away from the text" (copy "The index drifts away from the text") (quasiquote (div (@ (class "grid2")) (unquote (card "What a rename actually does")) (unquote (card "Editing one sentence")))) (table-of "Edit cost table")))))))
d5399c2d (92 1789760114892 "ws" () (set "8pniyrtk.1b" src "A refused commit does not simply say no. It answers stale-baseline, and it names the version the draft was made against, the version the block carries now, and the records applied since -- the winner's content among them. The agent that lost the race does not have to go and fetch the new state to find out what happened: it already has what it needs to redo its edit against it."))
182bf627 (93 1789760114995 "ws" () (put ((kind . section) (title . "A refusal, verbatim") (src . "$ theourgia commit <block> --writer w1\n\n(error stale-baseline\n  (block \"s9av8p0w.1\")\n  (based-on \"fb580a74...\")\n  (now \"904e0323...\")\n  (since ((\"s9av8p0w\" . 3)\n          (<the record that landed>)\n          (set \"s9av8p0w.1\" src \"w2 version\")))\n  (usage (commit (<block> ...) (\"--writer\" <name>)\n                 (\"--working-version\" <block>=<version>))))") (keywords . "refusal, stale-baseline, commit, example, answer") (parent . "8pniyrtk.m") (ord . 5))))
8f26231e (94 1789760115095 "ws" () (put ((kind . section) (title . "About that example") (src . "That answer was taken from a run, not written by hand: two writers took a draft of one block from the same baseline, the second committed, and the first was refused. The two hashes are shortened here to fit the page, and the record in the middle of since is stood in for by a description of it; everything else is as the store answered.") (keywords . "example, measured, truncation, hash, honesty") (parent . "8pniyrtk.m") (ord . 6))))
4d9bab3a (95 1789760115187 "ws" () (put ((kind . section) (title . "Store layout") (src . "store/\n  meta.sexp            the store's identity\n  instance.sexp        which machine and directory this copy is\n  writers/\n    f0sjkuzn/\n      owner.sexp       who this writer is\n      000001.sexp      one record per line: a CRC and an S-expression\n      working/         this writer's drafts -- not part of the log\n  blobs/               payloads too large to sit in a record\n  published.sexp       what has been handed to other machines\n  snap/                a cached reduction; delete it and it is rebuilt") (keywords . "layout, directory, files, segment, blob") (parent . "8pniyrtk.l") (ord . 5))))
8b565878 (96 1789760115300 "ws" () (put ((kind . section) (title . "A block, as the store answers it") (src . "$ theourgia read f0sjkuzn.au\n\n(ok ((id . \"f0sjkuzn.au\")\n     (deleted . #f)\n     (fields (keywords . \"retry, supervisor, worker\")\n             (kind . section)\n             (src . \"...\")\n             (title . \"Why the retry is three deep\"))\n     (position \"f0sjkuzn.a\" . 3)\n     (edges ((ref . \"f0sjkuzn.b2\")))))") (keywords . "block, answer, fields, position, edges") (parent . "8pniyrtk.l") (ord . 6))))
b96775df (97 1789760129392 "ws" () (put ((kind . section) (title . "Verb groups") (src . "Reading a store|read outline refs search log tag diff conflicts describe\nMaking and changing blocks|init insert set move del link unlink def\nDrafts, and committing them|write restore drafts discard commit\nImporting, exporting, splitting|import-md export-md import-code export-code split-suggest\nChecking, syncing, serving|check snapshot adopt publish batch") (keywords . "reference, groups, verbs, order, index") (parent . "8pniyrtk.o") (ord . 0))))
a856db1f (98 1789760129492 "ws" () (put ((kind . section) (title . "Reference intro") (src . "Every verb below, with its usage line and its one-sentence description, is rendered from what the store answers to describe. Nothing on this page is typed by hand, so it cannot drift from the binary that produced it. The tag on the right of each signature says where the verb runs: local in the client process, or daemon over the socket.") (keywords . "reference, describe, generated, usage, route") (parent . "8pniyrtk.o") (ord . 1))))
790db168 (99 1789760129562 "ws" () (put ((kind . section) (title . "Changelog intro") (src . "Nothing released yet. When there are versions, they land here, newest first, with what changed in each.") (keywords . "changelog, releases, versions, empty") (parent . "8pniyrtk.p") (ord . 0))))
8aba8b3f (100 1789760129647 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-model) (shell "The model -- theourgia" "A store is a directory of append-only logs. A block is a stable id, some fields, a position and typed edges. The state is a reduction." "Model" (list (phead "The model" "Four things: a store, a block, a log that is the only truth, and one shape for every answer.") (sec "store" "01" "A store" (copy "A store") (code-of "Store layout")) (sec "block" "02" "A block" (copy "A block") (code-of "A block, as the store answers it")) (sec "log" "03" "The log is the only truth" (copy "The log is the only truth") (quasiquote (div (@ (class "grid2")) (unquote (card "Deletion keeps the history")) (unquote (card "One answer shape"))))) (sec "surface" "04" "One query surface" (copy "One answer shape") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "reference.html")) "All 32 verbs, with their usage lines") " ->")))))) (doc . "") (parent . "8pniyrtk.2") (ord . 39))))
91e3c703 (101 1789760129726 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-concurrency) (shell "Concurrency -- theourgia" "Writer identities, drafts in your own space, commits judged per block against the version the draft was based on, and what a refusal hands back." "Concurrency" (list (phead "Two writers, one store" "Not a lock. Each writer has a space of their own; the two meet at commit, one block at a time.") (sec "writer" "01" "A writer is an identity" (copy "A writer is an identity")) (sec "drafts" "02" "Drafts, then commit" (copy "Drafts, then commit")) (sec "refusal" "03" "A refusal hands back the winner" (copy "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sec "correct" "04" "Correct with several writers from the start" (copy "Correct with several writers from the start") (quasiquote (div (@ (class "grid2")) (unquote (card "Measured under real concurrency")) (unquote (card "A writer is an identity")))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 40))))
dcfe4b71 (102 1789760129803 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-agents) (shell "For agents -- theourgia" "The write protocol, the daemon and the MCP shell, the measured latencies, and two prompts that put a store behind Claude Code's memory." "Agents" (list (phead "For agents" "What an agent has to know to write into a store, what it costs, and two prompts that are meant to be copied as they are.") (sec "protocol" "01" "The write protocol" (copy "The write protocol")) (sec "shape" "02" "One daemon, thin clients" (copy "Process shape") (prose "Latency, measured")) (sec "cost" "03" "What it costs" #f (quasiquote (div (@ (class "grid2")) (unquote (card "What it costs to move a memory in")) (unquote (card "Recall, measured against markdown"))))) (sec "migrate" "04" "Prompt: move an existing markdown memory in" "Give this to an agent together with the list of files to migrate. One agent per group of files works, and several may write into one store at the same time, each under its own writer id." (code-of "Migration prompt")) (sec "memory" "05" "Prompt: use a store as Claude Code's memory" "Three pieces. Turn the markdown memory off, put the store's outline into the session at startup, and tell the agent how to recall and how to write." (quasiquote (h3 (@ (style "margin-top:26px")) "The session hook")) (code-of "SessionStart hook") (quasiquote (h3 (@ (style "margin-top:26px")) "What goes in CLAUDE.md")) (code-of "Memory prompt") (quasiquote (h3 (@ (style "margin-top:26px")) "Over MCP instead of a shell")) (code-of "MCP registration"))))) (doc . "") (parent . "8pniyrtk.2") (ord . 41))))
e31d5e2f (103 1789760129883 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-changelog) (shell "Changelog -- theourgia" "Released versions of theourgia, newest first." "Changelog" (list (phead "Changelog" (copy "Changelog intro"))))) (doc . "") (parent . "8pniyrtk.2") (ord . 42))))
d618700a (104 1789760139562 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (verb-entry name) (or (assq name verb-table) (error (quote verb-entry) "describe does not answer with this verb" name))) (doc . "") (parent . "8pniyrtk.2") (ord . 43))))
276aa5ac (105 1789760139642 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (verb-row entry) (quasiquote (div (@ (class "verb")) (span (@ (class "sig")) (unquote (usage-line entry))) (div (@ (class "d")) (span (@ (class "r")) (unquote (verb-route entry))) (unquote (verb-desc entry)))))) (doc . "") (parent . "8pniyrtk.2") (ord . 44))))
266e21b2 (106 1789760139723 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (verb-groups) (map (lambda (l) (let ((p (split-char l ("#%char" 124)))) (unless (= (length p) 2) (error (quote verb-groups) "a row must be name|verb verb ..." l)) (cons (car p) (map string->symbol (filter (lambda (s) (> (string-length s) 0)) (split-char (cadr p) ("#%char" 32))))))) (lines-of (copy "Verb groups")))) (doc . "") (parent . "8pniyrtk.2") (ord . 45))))
5ffc0973 (107 1789760139800 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (ungrouped-verbs) (let ((named (apply append (map cdr (verb-groups))))) (filter (lambda (e) (not (memq (car e) named))) verb-table))) (doc . "") (parent . "8pniyrtk.2") (ord . 46))))
78a11aa8 (108 1789760139879 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-reference) (let* ((groups (verb-groups)) (left (ungrouped-verbs)) (blocks (append (map (lambda (g) (sec (car g) "" (car g) #f (quasiquote (div (unquote-splicing (map (lambda (n) (verb-row (verb-entry n))) (cdr g))))))) groups) (if (null? left) (quote ()) (list (sec "other" "" "Not yet grouped" "These verbs came back from describe and this page has no section for them." (quasiquote (div (unquote-splicing (map verb-row left)))))))))) (shell "Reference -- theourgia" "Every verb the store answers to, with its usage line, rendered from describe." "Reference" (append (list (phead (join (list (number->string (length verb-table)) " verbs")) (copy "Reference intro"))) blocks)))) (doc . "") (parent . "8pniyrtk.2") (ord . 47))))
19871773 (109 1789760150410 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (favicon) (html (quasiquote (svg (@ (xmlns "http://www.w3.org/2000/svg") (viewBox "0 0 64 64")) (rect (@ (width "64") (height "64") (rx "14") (fill "#5b3fc4"))) (ellipse (@ (cx "32") (cy "32") (rx "12.5") (ry "18") (fill "none") (stroke "#ffffff") (stroke-width "5"))) (path (@ (d "M 20.5 32 H 43.5") (stroke "#ffffff") (stroke-width "5") (stroke-linecap "round"))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 48))))
41189298 (110 1789760283763 "ws" () (put ((kind . section) (title . "One library holds every definition") (src . "eval --under <library> does not build an R6RS library. It splices the bodies of the library block's direct children into one (let () ...) and evaluates the expression there (eval-worker.ss, the --under branch). The imports field is checked against a fixed list of (rnrs ...) libraries, so a store library cannot import another store library. The plan of a chrome library plus one library per page is therefore not available; this site puts every def under a single site generator block, and each page renderer is a sibling of the helpers it calls.") (keywords . "eval, library, import, scope, finding") (parent . "8pniyrtk.r") (ord . 0))))
a26b10bc (111 1789760283828 "ws" () (put ((kind . section) (title . "A local-path write is invisible to the next daemon read") (src . "Measured, three trials, identical each time. With a daemon running for a store, an insert made with THEOURGIA_LOCAL=1 through cli.ss answers ok and is durable, but the FIRST outline through the thin client afterwards does not show the new block. The second one does. Trials A, B, C each read 0, then 1, then 1. This matters because the documented workaround for batch answering usage over the daemon is to run batch on the local path -- so the very next lookup of the block just created can come back empty. Looking the id up a second time is enough.") (keywords . "daemon, local, stale, visibility, finding") (parent . "8pniyrtk.r") (ord . 1))))
23730e29 (112 1789760283898 "ws" () (put ((kind . section) (title . "Editing a definition in place") (src . "def <name> <source> --under <library> adds a definition; running it twice with the same name adds a second block with that name, and both bodies then land in the same let. To change a definition, set <id> body <source> works and is what this site's build used throughout. The README documents def but not this.") (keywords . "def, set, body, edit, finding") (parent . "8pniyrtk.r") (ord . 2))))
bb2b0fbf (113 1789760283969 "ws" () (put ((kind . section) (title . "Refusals and quirks hit while building this site") (src . "init answered (error bad-request ...) usage while THEOURGIA_WRITER was bound; run it under env -u THEOURGIA_WRITER. batch over the daemon answers usage; it was run with THEOURGIA_LOCAL=1 against cli.ss. THEOURGIA_WRITER=ws had no visible effect: every record here is under the writer init created. A block's text handed through shell command substitution loses its trailing newline, so the two prompt blocks differ from docs/claude-code-memory.md by exactly that one byte and nothing else. eval answers the page as a written string, so build.sh reads the answer back with a Scheme reader rather than trying to unescape it with sed.") (keywords . "refusal, usage, quirk, workaround, log") (parent . "8pniyrtk.r") (ord . 3))))
5d77c63d (114 1789760412998 "ws" () (set "8pniyrtk.11" src "Two agents editing one markdown file have nothing smaller than the file to meet on, so one write lands on top of the other and nothing says so. Here an update cannot be lost. Each agent writes in its own space, and a commit states the version it was based on; if that version has moved, the commit is refused and handed the content of the writer who got there first. The check is per block, so two agents working on different blocks are never refused because of each other."))
85292b9a (115 1789760413110 "ws" () (set "8pniyrtk.1a" src "write puts a proposed next version of a block into the writing agent's own space. It is not in the log and nobody else can see it. commit, in describe's own words, installs a writer's drafts into the store as one change; the process that owns the store carries commits out one at a time, so the outcome of a race is decided rather than interleaved. With --based-on, the commit states the version the draft was made against. If that premise has moved, the commit is refused."))
bbca477e (116 1789760413216 "ws" () (set "8pniyrtk.1b" src "A refused commit does not simply say no. It answers stale-baseline, and it names the version the draft was made against, the version the block carries now, and the records applied since -- the winner's content among them. The agent that lost the race does not have to go and fetch the new state to find out what happened: it already has what it needs to merge and send the commit again."))
d175808d (117 1789760413317 "ws" () (set "8pniyrtk.1o" src "Every figure on this site comes from one of two measured runs: 157 files of a real agent memory written by five concurrent agents, and 113 documents converted and then queried. Four things are worth knowing before quoting them. The token counts use cl100k_base, which is OpenAI's tokenizer, not Claude's and not a billing unit; calibrated once against real context growth it ran about 9% low. How much a query saves tracks the size of the block that happens to answer it, not anything theourgia does: where the answering block is most of the document, it saves almost nothing. Documents under about a thousand tokens do not benefit. And roughly 40% of queries made without knowing what is in the store fall back to reading the outline first."))
30d4863b (118 1789760413392 "ws" () (put ((kind . section) (title . "Saying nothing about the base") (src . "--based-on is optional, and leaving it out is not an error. A set or an insert sent without a stated base simply appends: nothing is refused, and nothing is silently dropped, but nothing is checked either, and two writers can end up disagreeing about a field. conflicts is the verb for that -- in describe's words, it lists blocks whose writers disagree. The guarantee above is what --based-on buys; it is not something the store does behind an agent that never asks for it.") (keywords . "based-on, optional, conflicts, append, honesty") (parent . "8pniyrtk.m") (ord . 7))))
5607c599 (119 1789760413529 "ws" () (set "8pniyrtk.26" body (define (sec anchor kicker title lead . rest) (quasiquote (section (@ (id (unquote anchor))) (div (@ (class "wrap")) (unquote-splicing (if (and (string? kicker) (> (string-length kicker) 0)) (list (quasiquote (div (@ (class "kicker")) (unquote kicker)))) (quote ()))) (h2 (unquote title)) (unquote-splicing (if (string? lead) (list (quasiquote (p (@ (class "lead")) (unquote lead)))) (quote ()))) (unquote-splicing rest)))))))
7363feee (120 1789760421423 "ws" () (set "8pniyrtk.2t" body (define (page-concurrency) (shell "Concurrency -- theourgia" "Per-block optimistic commits: a commit whose base has moved is refused and handed the winner's content. Writer identities, drafts, and what a refusal carries." "Concurrency" (list (phead "Two writers, one store" "Per-block optimistic commits. Each writer has a space of their own; the two meet at commit, one block at a time.") (sec "writer" "01" "A writer is an identity" (copy "A writer is an identity")) (sec "drafts" "02" "Drafts, then commit" (copy "Drafts, then commit")) (sec "refusal" "03" "No lost updates" (copy "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sec "base" "04" "Only if you say what you based it on" (copy "Saying nothing about the base")) (sec "correct" "05" "Correct with several writers from the start" (copy "Correct with several writers from the start") (quasiquote (div (@ (class "grid2")) (unquote (card "Measured under real concurrency")) (unquote (card "A writer is an identity"))))))))))
7deda2ff (121 1789760421530 "ws" () (set "8pniyrtk.2i" body (define (page-why) (shell "Why not markdown -- theourgia" "The four things a file-per-note memory does badly, what replaces each, and the measurements." "Why" (list (phead "Why not markdown" "Four things a memory made of files does badly, what replaces each, and what the replacement does not do.") (sec "read" "01" "Reading is all or nothing" (copy "Reading is all or nothing") (prose "Reading is all or nothing, measured") (table-of "Query cost table") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Fifty-six questions over twenty documents. The share is of what reading the " "whole document every time would have cost."))) (sec "shape" "02" "The shape degenerates" (copy "The shape degenerates")) (sec "concurrency" "03" "One write lands on top of another" (copy "Two writers meet at the file") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "concurrency.html")) "Drafts, commits and what a refusal hands back") " ->"))) (sec "index" "04" "The index drifts away from the text" (copy "The index drifts away from the text") (quasiquote (div (@ (class "grid2")) (unquote (card "What a rename actually does")) (unquote (card "Editing one sentence")))) (table-of "Edit cost table")))))))
2a3eb405 (122 1789760441968 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (one-card t) (quasiquote (div (@ (class "grid2") (style "grid-template-columns:1fr;max-width:640px")) (unquote (card t))))) (doc . "") (parent . "8pniyrtk.2") (ord . 49))))
a8a5e53a (123 1789760442075 "ws" () (set "8pniyrtk.2t" body (define (page-concurrency) (shell "Concurrency -- theourgia" "Per-block optimistic commits: a commit whose base has moved is refused and handed the winner's content. Writer identities, drafts, and what a refusal carries." "Concurrency" (list (phead "Two writers, one store" "Per-block optimistic commits. Each writer has a space of their own; the two meet at commit, one block at a time.") (sec "writer" "01" "A writer is an identity" (copy "A writer is an identity")) (sec "drafts" "02" "Drafts, then commit" (copy "Drafts, then commit")) (sec "refusal" "03" "No lost updates" (copy "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sec "base" "04" "Only if you say what you based it on" (copy "Saying nothing about the base")) (sec "correct" "05" "Correct with several writers from the start" (copy "Correct with several writers from the start") (one-card "Measured under real concurrency")))))))
6dcfd1e5 (124 1789760442182 "ws" () (set "8pniyrtk.2s" body (define (page-model) (shell "The model -- theourgia" "A store is a directory of append-only logs. A block is a stable id, some fields, a position and typed edges. The state is a reduction." "Model" (list (phead "The model" "Four things: a store, a block, a log that is the only truth, and one shape for every answer.") (sec "store" "01" "A store" (copy "A store") (code-of "Store layout")) (sec "block" "02" "A block" (copy "A block") (code-of "A block, as the store answers it")) (sec "log" "03" "The log is the only truth" (copy "The log is the only truth") (one-card "Deletion keeps the history")) (sec "surface" "04" "One query surface" (copy "One answer shape") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "reference.html")) "All 32 verbs, with their usage lines") " ->"))))))))
2ac229ea (125 1789760458699 "ws" () (set "8pniyrtk.2d" src "Document|Rewrite the file|write plus commit|Share\n19,820 B design note|8,403|292|3.47%\n367,298 B design note|127,510|246|0.19%\n10,624 B design note|2,904|163|5.61%"))
cc2e2028 (126 1789760477471 "ws" () (set "8pniyrtk.1k" src "Two sets of figures, because they were taken under different conditions. Over MCP with the shell resident and the store at 387 blocks, a tool call took 1 ms to read a block, 2 ms for an outline and 48-68 ms for a search; initialize took 39 ms and tools/list 121 ms, the latter including the describe round trip to the daemon. Measured separately, from a source-form client with four other agents writing into the same store at the time, an insert of a 3 KB body took 108 ms end to end, including the client process starting. A client process starts in 30-50 ms once it is running from compiled objects. search is a full scan and grows with the store."))
c4256c24 (127 1789760477569 "ws" () (set "8pniyrtk.1d" src "Five agents, five writer ids, one daemon, writing an existing 157-file agent memory (about 430 KB) into one store at the same time: 387 blocks, 0 refusals. An insert of a 3 KB body took 108 ms end to end while that was going on, measured from a source-form client and including the time the client process took to start."))
83d4c984 (128 1789760477669 "ws" () (set "8pniyrtk.1o" src "Every figure on this site comes from one of two measured runs: 157 files of a real agent memory written by five concurrent agents, and 113 documents converted and then queried. Four things are worth knowing before quoting them. The token counts use cl100k_base, which is OpenAI's tokenizer, not Claude's and not a billing unit; calibrated once against real context growth it ran about 9% low. How much a query saves tracks the size of the block that happens to answer it, not anything theourgia does: in the bucket where the answering block is most of the document the median query still cost 95.2% of reading the whole thing. Small documents have little to give either -- under about a thousand tokens the median was 38.5%, and one README's outline alone came to 67.6% of the document it summarised. And roughly 40% of queries made without knowing what is in the store fall back to reading the outline first."))
