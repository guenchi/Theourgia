1c77a0a7 (77 1789760046589 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (graph-svg) (quasiquote (div (@ (class "diagram")) (svg (@ (viewBox "0 0 900 262") (xmlns "http://www.w3.org/2000/svg") (role "img") (aria-label "A store's root with three sections, each holding a block, and one typed edge running between two blocks")) (unquote (gedge 180 111 260 47 #f)) (unquote (gedge 180 111 260 125 #f)) (unquote (gedge 180 111 260 203 #f)) (unquote (gedge 420 47 500 47 #f)) (unquote (gedge 420 125 500 125 #f)) (unquote (gedge 420 203 500 203 #f)) (path (@ (d "M 660 180 C 720 180 720 70 660 70") (fill "none") (stroke "#5b3fc4") (stroke-width "1.6") (stroke-dasharray "5 4"))) (text (@ (x "726") (y "129") (font-size "11.5") (font-family "ui-monospace, Menlo, monospace") (fill "#5b3fc4")) "ref") (unquote (gbox 20 88 "root" "the store")) (unquote (gbox 260 24 "Model" "f0sjkuzn.3")) (unquote (gbox 260 102 "Concurrency" "f0sjkuzn.7")) (unquote (gbox 260 180 "Agents" "f0sjkuzn.b")) (unquote (gbox 500 24 "A block" "f0sjkuzn.4")) (unquote (gbox 500 102 "Drafts, then commit" "f0sjkuzn.8")) (unquote (gbox 500 180 "The write protocol" "f0sjkuzn.c")))))) (doc . "") (parent . "8pniyrtk.2") (ord . 28))))
