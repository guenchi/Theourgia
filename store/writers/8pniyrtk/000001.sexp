2537afc0 (83 1789760058485 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (page-index) (shell "theourgia -- a block-graph knowledge base for agents and people" "A knowledge base agents and people write into together: stable block ids, typed edges, an append-only log per writer, and a deterministic reduction over it." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "reference.html")) "The 32 verbs"))))) (sec "problem" "01 -- The problem" "A file is the wrong unit" (copy "The two problems") (quasiquote (div (@ (class "grid2")) (unquote (card "Reading is all or nothing")) (unquote (card "Two writers meet at the file")))) (quasiquote (p (@ (style "margin-top:26px")) (a (@ (href "why.html")) "All four, and what replaces each") " ->"))) (sec "model" "02 -- The model" "A store, its blocks, and one log per writer" (copy "What it is") (graph-svg) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "model.html")) "The model in full") " -> " (a (@ (href "concurrency.html")) "How two writers meet") " ->"))) (sec "measured" "03 -- Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "04 -- Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install")))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 34))))
cb2d92c5 (84 1789760072947 "ws" () (put ((kind . section) (title . "Query cost table") (src . "Route|Tokens|Share\nRead the whole document for each question|232,478|100%\noutline, then read the block that answers|46,410|20.0%\nsearch, then read the block that answers|34,917|15.0%") (keywords . "table, token, query, outline, search") (parent . "8pniyrtk.k") (ord . 6))))
6172595b (85 1789760073015 "ws" () (put ((kind . section) (title . "Edit cost table") (src . "Document|Rewrite the file|write plus commit|Share\n19,820 B design note|8,403|292|3.47%\n297 KB design note|127,510|246|0.19%\n6,800 B design note|2,904|163|5.61%") (keywords . "table, write, edit, token, payload") (parent . "8pniyrtk.k") (ord . 7))))
b5762d0d (86 1789760073088 "ws" () (put ((kind . section) (title . "Editing one sentence") (src . "Changing one sentence in a markdown memory means handing the whole file back. Here it means handing back the one block: write <block> <bytes>, then commit. Measured on three documents, the payload plus command line came to between 0.19% and 5.61% of rewriting the file, and the answer stayed at 190-200 tokens whatever the document's size. Exporting afterwards and diffing against the original showed exactly one line replaced, all three times.") (keywords . "edit, write, commit, payload, diff") (parent . "8pniyrtk.k") (ord . 8))))
1a9dc86f (87 1789760073181 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (table-of t) (let* ((rows (map (lambda (l) (split-char l ("#%char" 124))) (lines-of (copy t)))) (head (car rows)) (body (cdr rows))) (quasiquote (table (thead (tr (unquote-splicing (map (lambda (c) (quasiquote (th (unquote c)))) head)))) (tbody (unquote-splicing (map (lambda (r) (quasiquote (tr (unquote-splicing (map (lambda (c) (quasiquote (td (unquote c)))) r))))) body))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 35))))
