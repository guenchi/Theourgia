4e2f33f6 (8 1789759885677 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (html node) (cond ((string? node) (esc node)) ((null? node) "") ((not (pair? node)) (error (quote html) "not a node" node)) ((eq? (car node) (quote raw)) (join (cdr node))) ((symbol? (car node)) (let* ((tag (symbol->string (car node))) (rest (cdr node)) (tagged (and (pair? rest) (pair? (car rest)) (eq? (caar rest) (quote @)))) (al (if tagged (cdar rest) (quote ()))) (kids (if tagged (cdr rest) rest))) (if (void-tag? (car node)) (join (list "<" tag (attrs al) ">")) (join (list "<" tag (attrs al) ">" (join (map html kids)) "</" tag ">"))))) (else (join (map html node))))) (doc . "") (parent . "8pniyrtk.2") (ord . 4))))
ed0746d9 (9 1789759892976 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (fields-of rec) (let ((p (and (pair? rec) (assq (quote fields) rec)))) (if p (cdr p) (quote ())))) (doc . "") (parent . "8pniyrtk.2") (ord . 5))))
08987ef1 (10 1789759893043 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (fld rec name) (let ((p (assq name (fields-of rec)))) (and p (cdr p)))) (doc . "") (parent . "8pniyrtk.2") (ord . 6))))
e874e868 (11 1789759893109 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (live? rec) (and (pair? rec) (let ((p (assq (quote deleted) rec))) (not (and p (cdr p)))))) (doc . "") (parent . "8pniyrtk.2") (ord . 7))))
7dfa9f96 (12 1789759893195 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (all-recs) (filter live? (map (lambda (b) (block (cadr b))) (blocks)))) (doc . "") (parent . "8pniyrtk.2") (ord . 8))))
29d59cb7 (13 1789759893263 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (by-title t) (let loop ((rs (all-recs))) (cond ((null? rs) #f) ((equal? t (fld (car rs) (quote title))) (car rs)) (else (loop (cdr rs)))))) (doc . "") (parent . "8pniyrtk.2") (ord . 9))))
623283fa (14 1789759893331 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (need t) (or (by-title t) (error (quote need) "no live block carries this title" t))) (doc . "") (parent . "8pniyrtk.2") (ord . 10))))
e4f2ecee (15 1789759893401 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (copy t) (let ((s (fld (need t) (quote src)))) (if (string? s) s (error (quote copy) "block has no src" t)))) (doc . "") (parent . "8pniyrtk.2") (ord . 11))))
cb872cfe (16 1789759893519 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (parent-of rec) (let ((p (assq (quote position) rec))) (and p (car (cdr p))))) (doc . "") (parent . "8pniyrtk.2") (ord . 12))))
c3c600a2 (17 1789759893590 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (ord-of rec) (let ((p (assq (quote position) rec))) (if p (cdr (cdr p)) 0))) (doc . "") (parent . "8pniyrtk.2") (ord . 13))))
91b061dc (18 1789759893663 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (kids rec) (let ((id (cdr (assq (quote id) rec)))) (list-sort (lambda (a b) (< (ord-of a) (ord-of b))) (filter (lambda (r) (equal? id (parent-of r))) (all-recs))))) (doc . "") (parent . "8pniyrtk.2") (ord . 14))))
b672ad7b (19 1789759901870 "ws" () (put ((kind . section) (title . "Home") (src . "Section: Home") (keywords . "section, Home") (parent . root) (ord . 2))))
15026657 (20 1789759901980 "ws" () (put ((kind . section) (title . "Why not markdown") (src . "Section: Why not markdown") (keywords . "section, Why not markdown") (parent . root) (ord . 3))))
288cb145 (21 1789759902074 "ws" () (put ((kind . section) (title . "Model") (src . "Section: Model") (keywords . "section, Model") (parent . root) (ord . 4))))
5795158b (22 1789759902146 "ws" () (put ((kind . section) (title . "Concurrency") (src . "Section: Concurrency") (keywords . "section, Concurrency") (parent . root) (ord . 5))))
98255840 (23 1789759902212 "ws" () (put ((kind . section) (title . "Agents") (src . "Section: Agents") (keywords . "section, Agents") (parent . root) (ord . 6))))
b7855494 (24 1789759902279 "ws" () (put ((kind . section) (title . "Reference") (src . "Section: Reference") (keywords . "section, Reference") (parent . root) (ord . 7))))
ea651f12 (25 1789759902347 "ws" () (put ((kind . section) (title . "Changelog") (src . "Section: Changelog") (keywords . "section, Changelog") (parent . root) (ord . 8))))
99150225 (26 1789759902473 "ws" () (put ((kind . section) (title . "Assets") (src . "Section: Assets") (keywords . "section, Assets") (parent . root) (ord . 9))))
fb7ec54e (27 1789759902573 "ws" () (put ((kind . section) (title . "Notes") (src . "Section: Notes") (keywords . "section, Notes") (parent . root) (ord . 10))))
4562dbc7 (28 1789759912940 "ws" () (put ((kind . section) (title . "Tagline") (src . "A block-graph knowledge base that agents and people write into together.") (keywords . "tagline, hero, one line, agent, knowledge base") (parent . "8pniyrtk.j") (ord . 0))))
8a263349 (29 1789759913012 "ws" () (put ((kind . section) (title . "Hero sub") (src . "Apache-2.0 · R6RS Scheme, Chez as the reference platform · runs on Igropyr") (keywords . "hero, subtitle, licence, scheme, igropyr") (parent . "8pniyrtk.j") (ord . 1))))
0649d992 (30 1789759913112 "ws" () (put ((kind . section) (title . "The two problems") (src . "Knowledge is written by appending to a chain and by inserting in the middle of one. A file boundary is a poor place to cut it, and a poor reason to read all of it. And it should index itself: an agent should be able to read down to the level it needs, instead of grepping, or reading an index file whole before it can ask its first question.") (keywords . "problem, file boundary, index, self-indexing, motivation") (parent . "8pniyrtk.j") (ord . 2))))
3b422489 (31 1789759913184 "ws" () (put ((kind . section) (title . "What it is") (src . "A store is a directory: one append-only log per writer, plus blobs and metadata. A block is the smallest unit of content -- a stable id, a few fields, a position under a parent, and typed directed edges to other blocks. The state is a deterministic reduction over a fixed set of events. The log is the only truth; snapshots, indexes, renderings and projections are derived, and can be deleted and rebuilt.") (keywords . "store, block, log, reduction, derived") (parent . "8pniyrtk.j") (ord . 3))))
ecdecae5 (32 1789759925162 "ws" () (del "8pniyrtk.1"))
577afbcf (33 1789759925284 "ws" () (set "8pniyrtk.d" body (define (by-title t) (let loop ((rs (all-recs))) (cond ((null? rs) #f) ((and (string? (fld (car rs) (quote src))) (equal? t (fld (car rs) (quote title)))) (car rs)) (else (loop (cdr rs))))))))
6aa167c0 (34 1789759925417 "ws" () (put ((kind . section) (title . "Reading is all or nothing") (src . "A memory file grows the way an edit log grows: many lines added, almost none removed. When an agent needs one rule out of it, the file is still the unit it has to read, so the whole thing lands in the context window. The cost is not the writing, it is every later read.") (keywords . "read, token, file boundary, append only, context") (parent . "8pniyrtk.k") (ord . 0))))
1bc3aacf (35 1789759925517 "ws" () (put ((kind . section) (title . "Reading is all or nothing, measured") (src . "Measured on one real question against one real memory file, both routes run into the same agent's context: reading the 19,820-byte file cost 10,432 tokens; an outline call plus a read of the single block that answered the question cost 1,823. That is 5.7x, and about 600 of each route's tokens are per-turn framing rather than content.") (keywords . "measurement, token, context, outline, read") (parent . "8pniyrtk.k") (ord . 1))))
b5317cc0 (36 1789759925638 "ws" () (put ((kind . section) (title . "The shape degenerates") (src . "Left alone, a file-per-note memory drifts to two extremes at once: a long tail of tiny isolated notes, and a handful of files that accrete for months until nobody can say where one subject ends. Splitting a big file by hand cuts a thread that was continuous. The block, not the file, is the unit here: a block is placed under the parent its subject puts it under, and a boundary never decides what gets read.") (keywords . "long tail, topology, split, fragment, accretion") (parent . "8pniyrtk.k") (ord . 2))))
9d082b89 (37 1789759925735 "ws" () (put ((kind . section) (title . "Two writers meet at the file") (src . "Two agents editing one markdown file have nothing smaller than the file to meet on, so one write silently lands on top of the other. theourgia's answer is not a block-level lock. Each writer has their own space; drafts live there and are not in the log. Consistency is decided at commit time, per block, against the version the draft was based on -- and a refused commit comes back carrying the content of the writer who got there first, so the loser has what it needs to redo the work.") (keywords . "concurrency, overwrite, writer, commit, based-on") (parent . "8pniyrtk.k") (ord . 3))))
7fef5063 (38 1789759925844 "ws" () (put ((kind . section) (title . "The index drifts away from the text") (src . "Line maps and external indexes are separate artifacts from the prose they describe, and they go stale quietly. Here the identifier is part of the state: a block's id does not change when its text, its title or its position does, and the reference graph is reduced from the same log as the content. What that buys is one query -- refs <id> answers who points at this block. What it does not buy: there is no staleness detection, and no embeddings. Vectors are an explicit non-goal. What exists is per-block full text, keywords, and a graph of stable ids.") (keywords . "index, stable id, refs, backlink, rename") (parent . "8pniyrtk.k") (ord . 4))))
9fce49a4 (39 1789759925956 "ws" () (put ((kind . section) (title . "What a rename actually does") (src . "Worth being precise, because it is easy to over-claim. Explicit edges are recorded by id, so renaming a block's title or a function's name leaves them intact. Derived edges -- the ref and uses relations the reducer works out for itself -- are re-resolved by name on every reduction. That is a fresh resolution, not an edge that followed the rename, and after a rename it resolves to whatever now carries the name.") (keywords . "rename, edge, explicit, derived, uses") (parent . "8pniyrtk.k") (ord . 5))))
cc7a3422 (40 1789759937210 "ws" () (put ((kind . section) (title . "A store") (src . "A store is a directory, and everything in it is a plain file. meta.sexp names the store. Each writer owns a directory under writers/, holding one numbered segment file per run of writing: one record per line, a CRC and an S-expression, readable by a person and diffable by git. Large payloads go to blobs/. published.sexp records what has been handed to other machines.") (keywords . "store, directory, log, blob, meta") (parent . "8pniyrtk.l") (ord . 0))))
10a153fb (41 1789759937277 "ws" () (put ((kind . section) (title . "A block") (src . "A block is the smallest unit of content. It has a stable id, written <writer>.<base36 ordinal> -- f0sjkuzn.au is one. It has fields: kind, title, src, keywords, and whatever else its kind calls for. It has a position: a parent and an ordinal among that parent's children. And it has edges: named, directed relations to other blocks.") (keywords . "block, id, field, position, edge") (parent . "8pniyrtk.l") (ord . 1))))
42f2a22e (42 1789759937370 "ws" () (put ((kind . section) (title . "The log is the only truth") (src . "State is a deterministic reduction over a fixed set of events. Given the same log you get the same state, on any machine, in any order of reading. Everything else -- the snapshot in snap/, the search index, an outline, a markdown export -- is derived. Deleting a derived artifact costs a rebuild and nothing else, which is why none of them has to be kept correct by hand.") (keywords . "log, reduction, deterministic, derived, snapshot") (parent . "8pniyrtk.l") (ord . 2))))
e110f942 (43 1789759937439 "ws" () (put ((kind . section) (title . "Deletion keeps the history") (src . "del retires a block: the reduction stops treating it as live, and the record of its life stays in the log. A block that was written by mistake can be taken out of the view without taking it out of the history, and what was written before the mistake is still readable at an earlier cut.") (keywords . "del, tombstone, history, recover") (parent . "8pniyrtk.l") (ord . 3))))
a527eea2 (44 1789759937509 "ws" () (put ((kind . section) (title . "One answer shape") (src . "Every verb answers with one line: an S-expression that begins with ok or error. --wire asks for the machine-facing spelling of it. There is no second, prettier output mode that an agent has to parse differently, and no rendering markup in the way -- the reply is the same data the store holds, and the agent can judge the size of what it is about to read before it reads it.") (keywords . "s-expression, wire, query surface, one line, machine") (parent . "8pniyrtk.l") (ord . 4))))
bb5eb2ff (45 1789759937587 "ws" () (put ((kind . section) (title . "A writer is an identity") (src . "Every agent and every person writes under a writer id. The id is what block ids are built from, so a block carries the identity of who wrote it for as long as it exists. One writer id is held by one live agent at a time -- that is a rule in the documentation, not a mechanism in the code; a later session may bind the same id and carry on with its drafts.") (keywords . "writer, identity, actor, agent, id") (parent . "8pniyrtk.m") (ord . 0))))
f3d52777 (46 1789759937687 "ws" () (put ((kind . section) (title . "Drafts, then commit") (src . "write puts a proposed next version of a block into the writing agent's own space. It is not in the log and nobody else can see it. commit installs a writer's drafts into the store as one change. With --based-on, the commit states the version the draft was made against; if that premise has moved, the commit is refused.") (keywords . "draft, write, commit, based-on, scratchpad") (parent . "8pniyrtk.m") (ord . 1))))
130faa1e (47 1789759937765 "ws" () (put ((kind . section) (title . "A refusal hands back the winner") (src . "This is the part worth designing for. A refused commit does not simply say no: it comes back carrying the content of the writer who committed first. The agent that lost the race does not have to go and fetch the new state to find out what happened -- it already has what it needs to redo its edit against it.") (keywords . "refusal, conflict, redo, content, commit") (parent . "8pniyrtk.m") (ord . 2))))
66591762 (48 1789759937839 "ws" () (put ((kind . section) (title . "Correct with several writers from the start") (src . "Multi-writer correctness is in the reduction rather than in a framework on top of it: candidate sets for fields and positions, dependencies between events, tombstones for deletion, OR-set semantics for edges. No CRDT library, no vector clocks in the API, and no merge step an agent has to run.") (keywords . "crdt, or-set, tombstone, candidate, deps") (parent . "8pniyrtk.m") (ord . 3))))
fa9d6115 (49 1789759937915 "ws" () (put ((kind . section) (title . "Measured under real concurrency") (src . "Five agents, five writer ids, one daemon, writing an existing 157-file agent memory (about 430 KB) into one store at the same time: 387 blocks, 0 refusals. Through the daemon, insert of a 3 KB body took about 100 ms, a read 1 ms, an outline 2 ms.") (keywords . "measurement, concurrent, agents, blocks, refusals") (parent . "8pniyrtk.m") (ord . 4))))
1243439d (50 1789759948250 "ws" () (put ((kind . section) (title . "Migration prompt") (src . "You are moving an existing markdown memory into a theourgia store through\nits command-line client, following the store's write protocol. The store is\nthe target of everything you write; the markdown files are read-only source.\n\nEnvironment (every shell):\n  export THEOURGIA_ACTOR=<your-name> THEOURGIA_WRITER=<your-name>\n  STORE=<path of the store>\n  theourgia <verb> --store $STORE ... --wire\nThe first stderr line `(theourgia machine-home ...)` is a banner; ignore it.\n\nWrite protocol:\n  - A block is the unit of writing: one block answers one question on its\n    own. Keep a block under about 800 tokens (roughly 3000 bytes); split a\n    longer one into blocks that each stand alone.\n  - Give every block a one-line title and 3 to 8 keywords, comma separated,\n    the words a future reader would actually type when searching.\n  - Place a block under the parent its subject puts it under (--under).\n  - Do not rewrite the source bytes: do not polish, translate or drop\n    sentences. Frontmatter stays out of the body; its description may become\n    the title, its name and type belong in the keywords.\n  - A memory file is usually one block. A file holding several independent\n    dated instances that together exceed the limit is split by instance,\n    each block titled with the file's name.\n\nPer file:\n  theourgia insert --store $STORE --under <parent-id> --title \"<title>\" \\\n    --keywords \"<k1>, <k2>, ...\" --text \"<body verbatim>\" --wire\nA success answers (ok (events ...) (state ((<id> . <hash>))) ...); record\n<id>. Record any other answer verbatim, with the command minus the body;\nretry at most once.\n\nLedger (write it to <ledger path> as JSON):\n  {\"group\": ..., \"files\": [{\"file\": ..., \"chars\": n,\n     \"blocks\": [{\"id\": ..., \"title\": ..., \"keywords\": ..., \"bytes\": n}],\n     \"refusals\": [{\"cmd\": ..., \"answer\": ...}]}],\n   \"totals\": {\"files\": n, \"blocks\": n, \"refusals\": n, \"wall_seconds\": n},\n   \"friction\": [\"one sentence per thing that was awkward: command line,\n                 answers, protocol, speed\"]}\nEvery id in the ledger comes from a real answer; never write a placeholder.\n\nDo not modify any source file. Do not touch git. Do not kill processes. Do\nnothing to the store except insert under the parents you were given. If the\nclient fails more than three times in a row, stop, record, report.") (keywords . "prompt, migration, import, markdown, agent") (parent . "8pniyrtk.n") (ord . 0))))
ed82c3b3 (51 1789759948342 "ws" () (put ((kind . section) (title . "Memory prompt") (src . "## Memory lives in theourgia, not in markdown files\n\nThe store at /path/to/memory-store is my memory. The markdown memory\ndirectory is retired: do not read it and do not write to it.\n\nIdentity: export THEOURGIA_ACTOR=<agent name> and THEOURGIA_WRITER=<agent\nname> before the first call. One writer id is held by one live agent at a\ntime; a later session may bind the same id and carry on with its drafts.\nTwo agents that need to edit the same draft copy it (drafts --writer w1,\nrestore <version> --writer w2) instead of sharing the id.\n\nRecall, before starting a task:\n  theourgia search --store $STORE <two or three words from the task>\n  theourgia read --store $STORE <id>          # the hits that look relevant\n  theourgia outline --store $STORE <id>       # to see what sits under a block\nRead what the search returns; do not page through the whole store. If a\nsearch finds nothing, try the other words a past self would have used, then\nstop: absence of a memory is an answer.\n\nWrite, when something worth keeping happens (a correction, a decision, a\nfact about the environment, a lesson):\n  theourgia insert --store $STORE --under <section id> --title \"<one line>\" \\\n    --keywords \"<3-8 words a future reader would search for>\" \\\n    --text \"<the fact, then Why: and How to apply:>\"\nOne block answers one question; keep it under about 800 tokens. Put it under\nthe section it belongs to (the outline shows them). Before inserting, search\nfor an existing block on the same fact and update that one with `write`\nfollowed by `commit --based-on` rather than adding a duplicate. Keep the\nmarkdown habits that still apply: say why, say how to apply, link related\nblocks by id in the text.\n\nDo not put into the store what the repository already records (code\nstructure, git history, CLAUDE.md itself), and nothing that only matters to\nthe current conversation.") (keywords . "prompt, claude code, memory, recall, write") (parent . "8pniyrtk.n") (ord . 1))))
856046d4 (52 1789759948413 "ws" () (put ((kind . section) (title . "SessionStart hook") (src . "{\n  \"hooks\": {\n    \"SessionStart\": [\n      {\n        \"matcher\": \"startup\",\n        \"hooks\": [\n          {\n            \"type\": \"command\",\n            \"command\": \"theourgia outline --store /path/to/memory-store --depth 1\"\n          }\n        ]\n      }\n    ]\n  }\n}") (keywords . "hook, session start, outline, settings, claude code") (parent . "8pniyrtk.n") (ord . 2))))
1970d86a (53 1789759948490 "ws" () (put ((kind . section) (title . "MCP registration") (src . "claude mcp add theourgia -- theourgia-mcp --store /path/to/memory-store \\\n  --actor <agent name> --writer <agent name>") (keywords . "mcp, register, shell, actor, writer") (parent . "8pniyrtk.n") (ord . 3))))
bcd0f2f3 (54 1789759965711 "ws" () (put ((kind . section) (title . "The write protocol") (src . "One block answers one question on its own. Keep it under about 800 tokens; split a longer one into blocks that each stand alone. Give it a one-line title and three to eight keywords -- the words a future reader would actually type. Put it under the parent its subject puts it under. Do not rewrite the source bytes when you are moving something in: no polishing, no translating, no dropping sentences.") (keywords . "protocol, block, title, keywords, parent") (parent . "8pniyrtk.n") (ord . 4))))
84648785 (55 1789759965809 "ws" () (put ((kind . section) (title . "Process shape") (src . "One store, one daemon. theourgia serve <store> holds the store's write lock and keeps the reduced state in memory. The client is thin: it knows the transport and nothing else, and it starts a daemon itself if it cannot reach one. Requests and answers are S-expression envelopes over a unix socket. The MCP shell is thin in the same way -- it asks the daemon for the tool list with describe rather than carrying its own copy.") (keywords . "daemon, client, socket, lock, serve") (parent . "8pniyrtk.n") (ord . 5))))
93af3834 (56 1789759965881 "ws" () (put ((kind . section) (title . "Latency, measured") (src . "Through the daemon, on a store of 387 blocks: read 1 ms, outline 2 ms, search 50-70 ms, insert about 100 ms. A client process starts in 30-50 ms from compiled objects. Over MCP with the shell resident: initialize 39 ms, tools/list 121 ms including the describe round trip, and a tool call is the daemon figure plus the shell. search is a full scan and grows with the store.") (keywords . "latency, measurement, daemon, mcp, milliseconds") (parent . "8pniyrtk.n") (ord . 6))))
7e2093ef (57 1789759965950 "ws" () (put ((kind . section) (title . "Recall, measured against markdown") (src . "Twenty real questions about a real agent memory, answered blind by two agents: one allowed only the store, one allowed only the markdown files. Both scored 20/20, and the answers were checked against each other question by question. The store route read 14% more bytes, all of it from search: its replies have no upper bound yet, and a broad query returns every hit with its full keyword list. That is a known open item, not a property of the model.") (keywords . "recall, measurement, correct, bytes, search") (parent . "8pniyrtk.n") (ord . 7))))
5fa50fdd (58 1789759966021 "ws" () (put ((kind . section) (title . "What it costs to move a memory in") (src . "import-md opens the files itself, so the bytes never enter the agent's context. Measured on 113 documents totalling 2,717,039 bytes: 0 tokens of context to convert, against roughly 1,082,000 if the same agent had read them first. This holds only while the split needs no judgement -- import-md cuts at headings. A corpus that needs a human decision about where to cut does not get the zero.") (keywords . "import, migration, context, token, zero") (parent . "8pniyrtk.n") (ord . 8))))
e8976405 (59 1789759975586 "ws" () (put ((kind . section) (title . "Numbers") (src . "387|blocks written into one store by five agents at the same time, with 0 refusals\n5.7x|less context for one real question: outline plus one block, against reading the file\n113/113|documents exported back byte-for-byte identical after being imported\n6%|of a corpus's markdown tokens is the size of its entire outline\n1 ms|to read a block through the daemon") (keywords . "measurement, numbers, panel, evidence, home") (parent . "8pniyrtk.j") (ord . 4))))
07490b6a (60 1789759975653 "ws" () (put ((kind . section) (title . "How the numbers were taken") (src . "Every figure on this site comes from one of two measured runs: 157 files of a real agent memory written by five concurrent agents, and 113 documents converted and then queried. What is worth knowing before quoting them. The token counts use cl100k_base, which is OpenAI's tokenizer, not Claude's and not a billing unit; calibrated once against real context growth it ran about 9% low. How much a query saves tracks the size of the block that happens to answer it, not anything theourgia does: where the answering block is most of the document, it saves almost nothing. Documents under about a thousand tokens do not benefit. And roughly 40% of queries made without knowing what is in the store fall back to reading the outline first.") (keywords . "caveat, method, limits, honesty, estimator") (parent . "8pniyrtk.j") (ord . 5))))
f741a0f5 (61 1789759975718 "ws" () (put ((kind . section) (title . "Quickstart") (src . "# a store is a directory\ntheourgia init\n\n# one block answers one question\ntheourgia insert --under root --title \"Why the retry is three deep\" \\\n  --keywords \"retry, supervisor, worker, timeout\" \\\n  --text \"...\"\n\n# find it again without reading the store\ntheourgia search \"retry supervisor\"\ntheourgia read <id>\n\n# what is under this block?\ntheourgia outline --depth 1") (keywords . "quickstart, install, init, insert, search") (parent . "8pniyrtk.j") (ord . 6))))
309f3923 (62 1789759975786 "ws" () (put ((kind . section) (title . "Install") (src . "theourgia is R6RS Scheme and builds with Chez Scheme against Igropyr. build.ss compiles every library in the tree into a directory of objects; the client, the MCP shell and the sandbox worker are the scripts beside them. There is no package to install and no daemon to configure: point the client at a directory and it starts what it needs.") (keywords . "install, build, chez, compile, path") (parent . "8pniyrtk.j") (ord . 7))))
d0c6eae8 (63 1789759982589 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define verb-table (quote ((init (usage (init)) (description "Create a store in this directory.") (protocol #f) (route local)) (insert (usage (insert "--under" <id> ("--after" <id>) "--title" <text> ("--text" <text>) ("--keywords" <text>))) (description "Add a block under a parent, with a title and optional text.") (protocol #t) (route daemon)) (set (usage (set <id> <field> <value> ("--if-unchanged" <version>) ("--based-on" <version>))) (description "Replace one field of one block.") (protocol #f) (route daemon)) (move (usage (move <id> <parent> ("--after" <id>))) (description "Move a block to another parent, optionally after a sibling.") (protocol #f) (route daemon)) (del (usage (del <id>)) (description "Retire a block. Its history stays.") (protocol #f) (route daemon)) (link (usage (link <from> <rel> <to>)) (description "Record a named relation between two blocks.") (protocol #f) (route daemon)) (unlink (usage (unlink <from> <rel> <to>)) (description "Remove a named relation between two blocks.") (protocol #f) (route daemon)) (write (usage (write <block> <bytes> ("--writer" <name>) ("--based-on" <version>) ("--rebase"))) (description "Save a draft of a block in a writer's own space, without committing it.") (protocol #t) (route daemon)) (restore (usage (restore <version> ("--writer" <name>))) (description "Take an earlier version of a draft back into a writer's space.") (protocol #f) (route daemon)) (commit (usage (commit (<block> ...) ("--writer" <name>) ("--working-version" <block>=<version>))) (description "Install a writer's drafts into the store as one change.") (protocol #f) (route daemon)) (drafts (usage (drafts ("--writer" <name>))) (description "List the drafts a writer is holding.") (protocol #f) (route daemon)) (discard (usage (discard <block> ("--writer" <name>))) (description "Throw away a writer's draft of a block.") (protocol #f) (route daemon)) (batch (usage (batch <intents>)) (description "Carry out several changes as one request.") (protocol #f) (route daemon)) (split-suggest (usage (split-suggest <file> ("--output" <review-file>))) (description "Propose where a long file could be divided into blocks.") (protocol #f) (route daemon)) (import-code (usage (import-code <dir> ("--allow-delete") ("--datum"))) (description "Read a directory of source into the store.") (protocol #f) (route daemon)) (export-code (usage (export-code <dir> ("--raw") ("--datum"))) (description "Write the store's source back out to a directory.") (protocol #f) (route daemon)) (def (usage (def <name> ("--under" <library>) <source>)) (description "Define or replace one named definition.") (protocol #f) (route daemon)) (import-md (usage (import-md <dir> ("--allow-delete"))) (description "Read a directory of markdown into the store.") (protocol #f) (route daemon)) (export-md (usage (export-md <dir> ("--with-ids"))) (description "Write the store out as markdown.") (protocol #f) (route daemon)) (adopt (usage (adopt)) (description "Take in records that are on disk but not yet in the log.") (protocol #f) (route daemon)) (check (usage (check)) (description "Read the whole store and report whether it is sound.") (protocol #f) (route daemon)) (snapshot (usage (snapshot)) (description "Record the current state as a reduction that can be reopened quickly.") (protocol #f) (route daemon)) (publish (usage (publish <writer> <segment> <file> (<sha256>))) (description "Publish a segment of a writer's log.") (protocol #f) (route daemon)) (outline (usage (outline ("--depth" <n>) ("--with-keywords"))) (description "List the blocks as a tree of titles.") (protocol #f) (route daemon)) (read (usage (read <id> ("--md") ("--recursive") ("--writer" <name>) ("--working") ("--working-info"))) (description "Read one block: its fields, or its text.") (protocol #f) (route daemon)) (refs (usage (refs <id>)) (description "List the relations a block takes part in.") (protocol #f) (route daemon)) (search (usage (search <query>)) (description "Find blocks whose title, keywords or text match every word given.") (protocol #f) (route daemon)) (log (usage (log (<id>))) (description "Show the changes recorded, for the store or for one block.") (protocol #f) (route daemon)) (tag (usage (tag (<name>))) (description "Name the current cut, or list the names already given.") (protocol #f) (route daemon)) (diff (usage (diff <cut> <cut>)) (description "Report what changed between two cuts.") (protocol #f) (route daemon)) (conflicts (usage (conflicts)) (description "List blocks whose writers disagree.") (protocol #f) (route daemon)) (describe (usage (describe)) (description "List the verbs, what each is for, and the writing protocol.") (protocol #f) (route daemon))))) (doc . "") (parent . "8pniyrtk.2") (ord . 15))))
bfd450ce (64 1789759990869 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (usage-part x) (cond ((string? x) x) ((symbol? x) (symbol->string x)) ((pair? x) (join (list "[" (usage-inner x) "]"))) (else (error (quote usage-part) "unexpected usage part" x)))) (doc . "") (parent . "8pniyrtk.2") (ord . 16))))
8a5405f7 (65 1789759990938 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (usage-inner xs) (let loop ((xs xs) (acc (quote ()))) (cond ((null? xs) (join (reverse acc))) ((null? (cdr xs)) (loop (quote ()) (cons (usage-part (car xs)) acc))) (else (loop (cdr xs) (cons " " (cons (usage-part (car xs)) acc))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 17))))
38c1c958 (66 1789759991008 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (usage-line entry) (usage-inner (cadr (assq (quote usage) (cdr entry))))) (doc . "") (parent . "8pniyrtk.2") (ord . 18))))
37597179 (67 1789759991078 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (verb-desc entry) (cadr (assq (quote description) (cdr entry)))) (doc . "") (parent . "8pniyrtk.2") (ord . 19))))
9e8d38bb (68 1789759991151 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (verb-route entry) (symbol->string (cadr (assq (quote route) (cdr entry))))) (doc . "") (parent . "8pniyrtk.2") (ord . 20))))
2199d1e7 (69 1789760008907 "ws" () (put ((kind . section) (title . "Stylesheet") (src . ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#5b3fc4;--acc2:#3f3a8f;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#6d28d9;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo span{color:var(--acc);font-size:20px;vertical-align:-1px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#efeaff 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.glyph{font-size:44px;color:var(--acc);line-height:1}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}") (keywords . "css, style, theme, layout, site") (parent . "8pniyrtk.q") (ord . 0))))
