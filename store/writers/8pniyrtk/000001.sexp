30813d1a (5 1789759873562 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (join xs) (let ((n (length xs))) (cond ((= n 0) "") ((= n 1) (car xs)) (else (let loop ((i 0) (head (quote ())) (rest xs)) (if (= i (div n 2)) (string-append (join (reverse head)) (join rest)) (loop (+ i 1) (cons (car rest) head) (cdr rest)))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 1))))
