f2219c7f (244 1789822860684 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "Theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "manual.html")) "The 32 verbs"))))) (sec "features" "Core features" "A Living Graph Engine for Human-Agent Symbiosis" #f (prose "Core features lead") (prose "Core features lead 2")) (sec "query" "01" "A minimal query surface for agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One Unified Graph Across Artifacts" (copy "F2 lead") (graph-svg) (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly")))) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "manual.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global Backlinks at Near-Zero Cost" (copy "F3 lead") (code-of "Refs, verbatim") (table-of "F3 cost table") (note-of "What refs resolves, exactly")) (sec "people" "04" "Human-Agent Symbiosis in the IDE" (copy "F4 lead") (prose "IDE design lead") (ulist-of "IDE scarce uses")) (sec "concurrency" "05" "Zero-Conflict Concurrent Workspaces" (copy "F5 lead") (code-of "A refusal, verbatim") (note-of "About that example") (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (one-card "Measured under real concurrency")) (sec "evaluate" "06" "A Living Lisp Machine" (copy "F6 lead") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then.")) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "Branches side by side: not yet" (prose "What evaluation does not do yet"))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
