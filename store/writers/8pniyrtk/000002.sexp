730eb971 (161 1789793423600 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (sub title . body) (quasiquote (div (@ (class "subsec")) (h3 (unquote title)) (unquote-splicing body)))) (doc . "") (parent . "8pniyrtk.2") (ord . 52))))
8e7b23bd (162 1789793423797 "ws" () (set "8pniyrtk.1x" src ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#5b3fc4;--acc2:#3f3a8f;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#6d28d9;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo span{color:var(--acc);font-size:20px;vertical-align:-1px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#efeaff 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.glyph{font-size:44px;color:var(--acc);line-height:1}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}\n.subsec{margin-top:38px}\n.subsec h3{font-size:20px;margin-bottom:10px}\n.subsec h4{font-size:16px;margin:24px 0 8px}\n.subsec p{color:var(--dim)}\n.subsec .lead{color:var(--dim)}"))
7ee7d0c3 (163 1789793432200 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: stable block ids, typed edges, an append-only log per writer, per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "reference.html")) "The 32 verbs"))))) (sec "problem" "01 -- The problem" "A file is the wrong unit" (copy "The two problems") (quasiquote (div (@ (class "grid2")) (unquote (card "Reading is all or nothing")) (unquote (card "Two writers meet at the file")))) (quasiquote (p (@ (style "margin-top:26px")) (a (@ (href "why.html")) "All four, and what replaces each") " ->"))) (sec "model" "02 -- The model" "One graph, over code and prose alike" (copy "What it is") (graph-svg) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "model.html")) "The model in full") " ->"))) (sec "concurrency" "03 -- Concurrency" "Two writers, one store" "Per-block optimistic commits. Each writer has a space of their own; the two meet at commit, one block at a time." (sub "A writer is an identity" (prose "A writer is an identity")) (sub "Drafts, then commit" (prose "Drafts, then commit")) (sub "No lost updates" (prose "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (sub "Correct with several writers from the start" (prose "Correct with several writers from the start") (one-card "Measured under real concurrency")) (sub "Put the store in git" (prose "Put the store in git") (quasiquote (h4 "What to exclude, and what to keep")) (code-of "A store's gitignore") (quasiquote (h4 "What a clone can do, and when")) (code-of "A clone's first write") (note-of "What adopt does to a clone"))) (sec "evaluate" "04 -- Evaluation" "A store that runs" "A knowledge base whose code is Scheme is not far from the old idea of a Lisp machine -- with the qualification first: only Scheme blocks evaluate today." (sub "What evaluates, and where" (prose "Evaluate intro")) (sub "Evaluate at a point in history" (prose "Evaluate at a point in history") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then."))) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "What is not there yet" (prose "What evaluation does not do yet"))) (sec "measured" "05 -- Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "06 -- Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
7fe44723 (164 1789793439504 "ws" () (set "8pniyrtk.20" body (define (topnav here) (define (lk href label) (if (equal? here label) (list (quote a) (list (quote @) (list (quote href) href) (list (quote class) "on")) label) (list (quote a) (list (quote @) (list (quote href) href)) label))) (quasiquote (nav (div (@ (class "wrap")) (div (@ (class "logo")) (a (@ (href "index.html") (style "color:inherit")) (span (raw "&#952;")) " theourgia")) (div (@ (class "links")) (unquote (lk "why.html" "Why")) (unquote (lk "model.html" "Model")) (a (@ (href "index.html#concurrency")) "Concurrency") (a (@ (href "index.html#evaluate")) "Evaluate") (unquote (lk "agents.html" "Agents")) (unquote (lk "reference.html" "Reference")) (unquote (lk "changelog.html" "Changelog")) (a (@ (href "https://github.com/guenchi/theourgia")) "GitHub"))))))))
76593d9e (165 1789793447181 "ws" () (set "8pniyrtk.2i" body (define (page-why) (shell "Why not markdown | theourgia" "The four things a file-per-note memory does badly, what replaces each, and the measurements." "Why" (list (phead "Why not markdown" "Four things a memory made of files does badly, what replaces each, and what the replacement does not do.") (sec "read" "01" "Reading is all or nothing" (copy "Reading is all or nothing") (prose "Reading is all or nothing, measured") (table-of "Query cost table") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Fifty-six questions over twenty documents. The share is of what reading the " "whole document every time would have cost."))) (sec "shape" "02" "The shape degenerates" (copy "The shape degenerates")) (sec "concurrency" "03" "One write lands on top of another" (copy "Two writers meet at the file") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "index.html#concurrency")) "Drafts, commits and what a refusal hands back") " ->"))) (sec "index" "04" "The index drifts away from the text" (copy "The index drifts away from the text") (quasiquote (div (@ (class "grid2")) (unquote (card "What a rename actually does")) (unquote (card "Editing one sentence")))) (table-of "Edit cost table")))))))
c3e94bcb (166 1789793447301 "ws" () (set "8pniyrtk.2s" body (define (page-model) (shell "The model | theourgia" "A store is a directory of append-only logs. A block is a stable id, some fields, a position and typed edges. Prose and code are the same kind of node." "Model" (list (phead "The model" "A store, a block, a log that is the only truth, one shape for every answer -- and one graph over code and prose alike.") (sec "store" "01" "A store" (copy "A store") (code-of "Store layout")) (sec "block" "02" "A block" (copy "A block") (code-of "A block, as the store answers it")) (sec "log" "03" "The log is the only truth" (copy "The log is the only truth") (one-card "Deletion keeps the history")) (sec "graph" "04" "One graph over code and prose" (copy "Everything is a block") (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly"))))) (sec "refs" "05" "Backlinks cost one query" (copy "Backlinks cost one query") (code-of "Refs, verbatim") (note-of "What refs resolves, exactly")) (sec "surface" "06" "One query surface" (copy "One answer shape") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "reference.html")) "All 32 verbs, with their usage lines") " -> " (a (@ (href "index.html#evaluate")) "Running the Scheme a store holds") " ->"))))))))
6f8b0528 (167 1789793447374 "ws" () (del "8pniyrtk.2t"))
34f835a4 (168 1789793447447 "ws" () (del "8pniyrtk.4a"))
06ef5d2b (169 1789793968454 "ws" () (put ((kind . section) (title . "Core features lead") (src . "Markdown is a good format for people to write in. As the memory and the documentation behind an agent it runs into the problems on the next page. To get past them the system stops organising content by files -- the store is still files, but a file boundary no longer decides what is read, what is written, or what is run -- and rebuilds how knowledge is organised, handed out and computed on. Six things.") (keywords . "features, intro, markdown, files, organise") (parent . "8pniyrtk.j") (ord . 9))))
ce92e25f (170 1789793968546 "ws" () (put ((kind . section) (title . "F1 lead") (src . "A compact interface built for machine reading and for a token budget, with rendering markup left out entirely. outline, search, refs, batch and the other verbs answer in S-expressions, one item per line, and an agent can see the size of what it is about to read before it reads it. There is no second, prettier output mode to parse.") (keywords . "query surface, agent, token, s-expression, compact") (parent . "8pniyrtk.j") (ord . 10))))
6bfeb002 (171 1789793968620 "ws" () (put ((kind . section) (title . "F1 example") (src . "$ theourgia outline --depth 1\n- 8pniyrtk.j  Home\n- 8pniyrtk.k  Why not markdown\n- 8pniyrtk.l  Model\n\n$ theourgia search \"stale-baseline\"\n(hit \"8pniyrtk.2l\" 4 \"refusal, stale-baseline, commit, example, answer\")\n(hit \"8pniyrtk.1b\" 1 \"A refused commit does not simply say no. It answers stale-baseline, and it names\")") (keywords . "example, outline, search, answer, verbatim") (parent . "8pniyrtk.j") (ord . 11))))
986f8939 (172 1789793968704 "ws" () (put ((kind . section) (title . "F2 lead") (src . "The wall between the code repository and the document store is a filesystem accident, not a property of the knowledge. Everything engineering produces goes into one graph. A section of a design, a Scheme macro, a function in another language and a decision record are all blocks -- equal, each with its own id, each addressable on its own. Edges are typed and directed, so a requirement can point at the code that meets it, the code at the test that checks it, and the test back at the discussion that decided it.") (keywords . "graph, boundary, code, prose, node") (parent . "8pniyrtk.j") (ord . 12))))
d8671dc8 (173 1789793968782 "ws" () (put ((kind . section) (title . "F3 lead") (src . "This changes how an agent, or a person, looks for context. refs <id> is one small query that answers the whole picture at once: which design mentions this function, which prose block refers to it -- and log <id> gives the history of the block itself. In place of wandering a source tree and a documentation tree with grep, one call.") (keywords . "refs, backlinks, context, grep, one query") (parent . "8pniyrtk.j") (ord . 13))))
c1ed7ef2 (174 1789793968873 "ws" () (put ((kind . section) (title . "F4 lead") (src . "The store is not only for the automated half. It is meant as a semantic layer that human developers and agents share: the same blocks, the same edges, the same history, whichever side wrote them. For people that means an editor, not a command line.") (keywords . "human, agent, shared, editor, layer") (parent . "8pniyrtk.j") (ord . 14))))
6e5d7f1a (175 1789793968951 "ws" () (put ((kind . section) (title . "F5 lead") (src . "Several agents and people can write against the same block at the same time. Nothing locks up: each writer's work goes into a space of their own, a scratchpad, and the committed tree stays consistent until somebody commits. A commit that states the version it was based on is checked against the block as it is now; if the base has moved the commit is refused, by name, and handed the content of the writer who got there first -- so the loser has what it needs to merge and commit again, instead of silently overwriting or being silently overwritten.") (keywords . "scratchpad, concurrent, isolation, commit, tree") (parent . "8pniyrtk.j") (ord . 15))))
d3335a2c (176 1789793969049 "ws" () (put ((kind . section) (title . "F6 lead") (src . "The store is not only somewhere the knowledge is kept; it is a runtime the knowledge runs in. When a block holds Scheme the whole thing is not far from a modern Lisp machine -- with the qualification first: only Scheme blocks evaluate today. Code an agent generated and code a person typed run in place, against the definitions the store holds, in a sandbox, at any point in the log's history.") (keywords . "lisp machine, runtime, evaluate, scheme, living") (parent . "8pniyrtk.j") (ord . 16))))
8a3813ce (177 1789793989296 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "reference.html")) "The 32 verbs"))))) (sec "features" "Core features" "Structured semantics, and a living graph engine" (copy "Core features lead")) (sec "query" "01" "A minimal query surface for agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One graph across artifacts and languages" (copy "F2 lead") (graph-svg) (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly")))) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "model.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global backlinks at almost no cost" (copy "F3 lead") (code-of "Refs, verbatim") (note-of "What refs resolves, exactly")) (sec "people" "04" "Human-agent symbiosis" (copy "F4 lead") (sub "In the editor today" (prose "In the editor today")) (note-of "In the editor, next")) (sec "concurrency" "05" "A zero-conflict concurrent workspace" (copy "F5 lead") (sub "Scratchpads" (prose "A writer is an identity") (prose "Drafts, then commit")) (sub "Baseline optimistic locking" (prose "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (one-card "Measured under real concurrency")) (sec "evaluate" "06" "A Lisp machine: a living knowledge base" (copy "F6 lead") (sub "Evaluation in the block" (prose "Evaluate intro")) (sub "Evaluate at a point in history" (prose "Evaluate at a point in history") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then."))) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "Branches side by side: not yet" (prose "What evaluation does not do yet"))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
4d7c2db7 (178 1789794011749 "ws" () (set "8pniyrtk.2s" body (define (page-model) (shell "The model | theourgia" "A store is a directory of append-only logs. A block is a stable id, some fields, a position and typed edges. Prose and code are the same kind of node, and the store goes in git as it is." "Model" (list (phead "The model" "A store, a block, a log that is the only truth, one shape for every answer -- and the store in git, as it is.") (sec "store" "01" "A store" (copy "A store") (code-of "Store layout")) (sec "block" "02" "A block" (copy "A block") (code-of "A block, as the store answers it")) (sec "log" "03" "The log is the only truth" (copy "The log is the only truth") (one-card "Deletion keeps the history")) (sec "graph" "04" "One graph over code and prose" (copy "Everything is a block") (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly"))))) (sec "refs" "05" "Backlinks cost one query" (copy "Backlinks cost one query") (code-of "Refs, verbatim") (note-of "What refs resolves, exactly")) (sec "surface" "06" "One query surface" (copy "One answer shape") (quasiquote (p (@ (style "margin-top:20px")) (a (@ (href "reference.html")) "All 32 verbs, with their usage lines") " -> " (a (@ (href "index.html#evaluate")) "Running the Scheme a store holds") " ->"))) (sec "git" "07" "Put the store in git" (copy "Put the store in git") (quasiquote (h3 (@ (style "margin-top:28px")) "What to exclude, and what to keep")) (code-of "A store's gitignore") (quasiquote (h3 (@ (style "margin-top:28px")) "What a clone can do, and when")) (code-of "A clone's first write") (note-of "What adopt does to a clone")))))))
edb63045 (179 1789794248844 "ws" () (set "8pniyrtk.4t" src "This changes how an agent, or a person, looks for context, and it changes what that costs. refs <id> is one small query that answers the whole picture at once: which design mentions this function, which prose block refers to it -- and log <id> gives the history of the block itself. search finds the block that answers, and the agent reads that block instead of the document around it. Measured on 56 questions over 20 real documents: search, then read the block that answers, cost 15% of the tokens that reading the whole document each time would have; outline, then read, 20%. The outline of an entire corpus is 6% of its markdown. Today search covers titles, prose and keywords; indexing the bodies of code blocks, so that finding a call site costs what finding a sentence does, is the next thing."))
7c3e7bf5 (180 1789794248971 "ws" () (put ((kind . section) (title . "F3 cost table") (src . "Route|Tokens, 56 questions|Share\nRead the whole document for each question|232,478|100%\noutline, then read the block that answers|46,410|20%\nsearch, then read the block that answers|34,917|15%") (keywords . "table, token, search, outline, measured") (parent . "8pniyrtk.j") (ord . 17))))
96208824 (181 1789794316639 "ws" () (put ((kind . code) (mode . datum) (lang . chez) (body define (olist-of t) (quasiquote (ol (@ (class "design")) (unquote-splicing (map (lambda (l) (let ((p (split-char l ("#%char" 124)))) (unless (= (length p) 2) (error (quote olist-of) "a row must be term|body" l)) (quasiquote (li (b (unquote (car p))) " " (unquote (cadr p)))))) (lines-of (copy t))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 53))))
37f24b02 (182 1789794316797 "ws" () (set "8pniyrtk.1x" src ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#5b3fc4;--acc2:#3f3a8f;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#6d28d9;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo span{color:var(--acc);font-size:20px;vertical-align:-1px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#efeaff 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.glyph{font-size:44px;color:var(--acc);line-height:1}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}\n.subsec{margin-top:38px}\n.subsec h3{font-size:20px;margin-bottom:10px}\n.subsec h4{font-size:16px;margin:24px 0 8px}\n.subsec p{color:var(--dim)}\n.subsec .lead{color:var(--dim)}\nol.design{margin:18px 0 0 22px;color:var(--dim)}\nol.design li{margin:10px 0}\nol.design li b{color:var(--fg);font-weight:600}"))
aa281bce (183 1789794316891 "ws" () (put ((kind . section) (title . "IDE design lead") (src . "Where the extension is going, and the reasoning. None of this is in it yet -- today it shows the outline, opens a block and saves through the writer's own space -- but it is the design the extension is being built toward, and it is the concrete form the shared layer takes. The rule underneath: the block world inside an IDE loses nothing of IntelliSense.") (keywords . "ide, design, intellisense, projection, roadmap") (parent . "8pniyrtk.j") (ord . 18))))
2e738cc1 (184 1789794316989 "ws" () (put ((kind . section) (title . "IDE for people") (src . "The projection is the editing surface.|The extension does not invent a new document type and reimplement completion and go-to-definition. People edit the real files that export-code writes, markers and all, and the language server works natively; on save the extension maps the changed ranges back to block ids by those markers and goes through write and commit. The block world inherits every IDE capability at no cost, and the extension only maps and commits. The markdown side already works this way.\nThe graph feeds the IDE back.|The more valuable direction. Hover and CodeLens providers show, above every definition, what only the store knows: three design sections refer to this, two lessons, last changed by another writer under a named request, see this test. The hover carries the design section's one-line summary. The language server tells you what a thing is; the graph tells you why it is here, who depends on it, and what to read before changing it.\nA rename that breaks no link, as a closed loop.|An LSP rename produces a workspace edit across files; the extension applies it to the projection and writes it back as one incremental import-code, all of it in one plan, atomically. Block ids do not change, so every edge from a design section, a lesson or a test survives. Then a search for the old name in the prose lists the paragraphs that still use it -- the honest form of exposing documentation that has not caught up.\nReviewing an agent's scratchpad with a full IDE.|Each writer's working view projects to a directory of its own, mounted as one root of a multi-root workspace; the language server indexes each agent's draft world separately. Reviewing an agent's change then comes with navigation, types and diagnostics instead of a plain-text diff.") (keywords . "ide, projection, hover, codelens, rename, review") (parent . "8pniyrtk.j") (ord . 19))))
ef26aa09 (185 1789794317080 "ws" () (put ((kind . section) (title . "IDE for agents") (src . "Diagnostics per block, per writer.|The language server's errors and warnings on a projected working view are mapped to block ids and handed to the core as derived data: drafts carries a diagnostic count, and a diagnostics query per writer lists block, severity and message. An agent knows before it commits whether its draft type-checks and whether its names resolve -- verification in the sandbox for languages that do not run here: no running, only asking.\nRead-only queries that skip the body.|Signatures and types from hover and documentSymbol become derived labels. A read that asks for the signature answers one line, an outline of code blocks lists signatures, and most of the time an agent never needs the body. ctags plus types, as part of the query surface.\nKeywords for code blocks, filled in by machine.|The write protocol asks for three to eight keywords, which is expensive to write by hand for code. Symbol name, container, kind and type names are exported mechanically as derived keywords, so search recall on code does not depend on a person writing them.\nImpact analysis as a traversal.|With call hierarchy materialised as calls edges, which tests must rerun when this block changes is one walk of the graph: test block to the block it guards to the transitive calls. Every test hangs off the block it guards; when the block changes, only the related tests run.\nExternal symbols have a place too.|Names the store cannot find, such as third-party libraries, come from workspaceSymbol and are answered as external locations, so an agent reading unfamiliar code never leaves the query surface.") (keywords . "ide, agent, diagnostics, signature, keywords, impact") (parent . "8pniyrtk.j") (ord . 20))))
584212bf (186 1789794351383 "ws" () (set "8pniyrtk.2b" body (define (page-index) (shell "theourgia -- structured semantics in place of markdown" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap")) (div (@ (class "glyph")) (raw "&#952;")) (h1 "theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "reference.html")) "The 32 verbs"))))) (sec "features" "Core features" "Structured semantics, and a living graph engine" (copy "Core features lead")) (sec "query" "01" "A minimal query surface for agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One graph across artifacts and languages" (copy "F2 lead") (graph-svg) (quasiquote (div (@ (class "grid2")) (unquote (card "A name is a block")) (unquote (card "Other languages, more modestly")))) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "model.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global backlinks at almost no cost" (copy "F3 lead") (code-of "Refs, verbatim") (table-of "F3 cost table") (note-of "What refs resolves, exactly")) (sec "people" "04" "Human-agent symbiosis" (copy "F4 lead") (sub "In the editor today" (prose "In the editor today")) (note-of "In the editor, next") (sub "The block world inside an IDE, with nothing of IntelliSense lost" (prose "IDE design lead") (quasiquote (h4 "For people")) (olist-of "IDE for people") (quasiquote (h4 "For agents: semantic facts as cheap queries")) (olist-of "IDE for agents"))) (sec "concurrency" "05" "A zero-conflict concurrent workspace" (copy "F5 lead") (sub "Scratchpads" (prose "A writer is an identity") (prose "Drafts, then commit")) (sub "Baseline optimistic locking" (prose "A refusal hands back the winner") (code-of "A refusal, verbatim") (note-of "About that example")) (sub "Only if you say what you based it on" (prose "Saying nothing about the base")) (one-card "Measured under real concurrency")) (sec "evaluate" "06" "A Lisp machine: a living knowledge base" (copy "F6 lead") (sub "Evaluation in the block" (prose "Evaluate intro")) (sub "Evaluate at a point in history" (prose "Evaluate at a point in history") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then."))) (sub "What the sandbox is given" (prose "The sandbox, plainly")) (sub "Branches side by side: not yet" (prose "What evaluation does not do yet"))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install"))))))))))
f0e5d40b (187 1789794631495 "ws" () (put ((kind . section) (title . "IDE design summary") (src . "Where the extension is going: the block world inside an IDE loses nothing of IntelliSense, because people edit the real files the store projects, the language server works natively, and the extension only maps a save back to the blocks it touched. In return the graph feeds the editor and the agent -- what refers to a definition, why it is there, what a rename or a change reaches -- as hovers, lenses, diagnostics and one-line queries.") (keywords . "ide, design, intellisense, projection, graph") (parent . "8pniyrtk.j") (ord . 21))))
