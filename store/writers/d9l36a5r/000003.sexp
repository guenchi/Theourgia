06da4617 (158 1790973375754 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (page-agents pin doc) (define url (join (list "https://github.com/guenchi/Theourgia/blob/" pin "/docs/claude-code-memory.md"))) (define (after-number heading) (let skip ((i 0) (spaces 0)) (cond ((= spaces 2) (substring heading i (string-length heading))) ((char=? (string-ref heading i) ("#%char" 32)) (skip (+ i 1) (+ spaces 1))) (else (skip (+ i 1) spaces))))) (define (fences heading) (let loop ((fs (doc-fences doc heading)) (i 1) (out (quote ()))) (if (null? fs) (reverse out) (loop (cdr fs) (+ i 1) (cons (quasiquote (pre (@ (data-heading (unquote heading)) (data-index (unquote (number->string i)))) (code (unquote (car fs))))) out))))) (define migrate "## 1. Migrating an existing markdown memory") (define memory (quote ("### 2.1 Turn auto-memory off" "### 2.2 Inject the outline at session start" "### 2.3 Tell the agent how to use it (CLAUDE.md)" "### 2.4 The MCP route instead of the shell"))) (define count (apply + (map (lambda (h) (length (doc-fences doc h))) (cons migrate memory)))) (define source (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "Every block in sections 04 and 05 is copied byte for byte from " (a (@ (href (unquote url))) "docs/claude-code-memory.md") " at commit " (code (unquote (substring pin 0 7))) "; the document says when and how to use each one."))) (shell "For agents and people | Theourgia" "The write protocol, the daemon and the MCP shell, the measured latencies, and two prompts that put a store behind Claude Code's memory." "Agents" (list (phead "For agents, and for the people working beside them" "What an agent has to know to write into a store, what it costs, and two prompts meant to be copied as they are.") (sec "protocol" "01" "The write protocol" (copy "The write protocol")) (sec "shape" "02" "One daemon, thin clients" (copy "Process shape") (prose "Latency, measured")) (sec "cost" "03" "What it costs" #f (quasiquote (div (@ (class "grid2")) (unquote (card "What it costs to move a memory in")) (unquote (card "Recall, measured against markdown"))))) (quasiquote (div (@ (class "memdoc") (data-fences (unquote (number->string count))) (data-commit (unquote pin))) (unquote (sec "migrate" "04" "Prompt: move an existing markdown memory in" "Give this to an agent together with the files to migrate." (quasiquote (div (unquote-splicing (fences migrate)))))) (unquote (apply sec "memory" "05" "Prompt: use a store as Claude Code's memory" "Turn the markdown memory off, put the store's outline into each session, and tell the agent how to recall and how to write." (append (apply append (map (lambda (h) (cons (quasiquote (h3 (@ (style "margin-top:26px")) (unquote (after-number h)))) (fences h))) memory)) (list source))))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 102))))
