a2a09384 (165 1790974596252 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (doc-fences doc heading) (define (fence-marker line) (cond ((starts-with? line "```") "```") ((starts-with? line "~~~") "~~~") (else #f))) (define (heading-line? line) (let count ((i 0)) (cond ((and (< i (string-length line)) (< i 6) (char=? (string-ref line i) ("#%char" 35))) (count (+ i 1))) ((= i 0) #f) ((= i (string-length line)) #t) (else (char=? (string-ref line i) ("#%char" 32)))))) (define (fail what) (raise (list (quote memory-document) what heading))) (define (indented-marker? line) (let skip ((i 0)) (cond ((and (< i (string-length line)) (< i 4) (char=? (string-ref line i) ("#%char" 32))) (skip (+ i 1))) ((or (= i 0) (= i 4)) #f) (else (let ((rest (substring line i (string-length line)))) (or (fence-marker rest) (heading-line? rest))))))) (let walk ((ls (split-char doc ("#%char" 10))) (open #f) (found #f) (body (quote ())) (out (quote ()))) (cond ((null? ls) (cond (open (fail (quote fence-never-closes))) ((not found) (fail (quote no-such-heading))) ((null? out) (fail (quote no-fence-under))) (else (reverse out)))) (open (if (string=? (car ls) open) (walk (cdr ls) #f found (quote ()) (if (eq? found (quote in)) (cons (apply string-append (map (lambda (l) (string-append l "\n")) (reverse body))) out) out)) (walk (cdr ls) open found (cons (car ls) body) out))) ((indented-marker? (car ls)) (raise (list (quote memory-document) (quote indented-fence-or-heading) (car ls)))) ((fence-marker (car ls)) => (lambda (m) (walk (cdr ls) m found (quote ()) out))) ((heading-line? (car ls)) (cond ((string=? (car ls) heading) (if found (fail (quote heading-twice)) (walk (cdr ls) #f (quote in) (quote ()) out))) ((eq? found (quote in)) (walk (cdr ls) #f (quote after) (quote ()) out)) (else (walk (cdr ls) #f found (quote ()) out)))) (else (walk (cdr ls) #f found body out))))) (doc . "") (parent . "8pniyrtk.2") (ord . 103))))
