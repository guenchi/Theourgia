{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  .her