7c72ff41 (31 1790707303031 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (page-index) (shell "Theourgia -- a block-graph storage engine for LLM agents" "A knowledge base agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, deterministic context assembly, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap hero-grid")) (div (@ (class "hero-text")) (h1 "Theourgia") (p (@ (class "tag")) (unquote (copy "Tagline"))) (p (@ (class "sub")) (unquote (copy "Hero sub"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown") (a (@ (class "btn ghost") (href "manual.html")) "The 38 verbs"))) (div (@ (class "hero-icon")) (img (@ (src "favicon.svg") (alt "Theourgia"))))))) (sec "features" "Core features" "A Living Graph Engine" #f (prose "Core features lead")) (sec "query" "01" "A Minimal Query Surface for Agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One Unified Graph Across Docs and Source Code" (copy "F2 lead") (graph-svg) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "manual.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global Backlinks at Near-Zero Cost" (copy "F3 lead") (code-of "Refs, verbatim") (prose "F3 measurement") (table-of "F3 cost table")) (sec "context" "04" "Deterministic Context Assembly" (copy "F4 lead") (prose "Context two layers") (ulist-of "Context sub-features")) (sec "people" "05" "Humans and Agents in the IDE" (copy "F5 lead") (ulist-of "IDE scarce uses")) (sec "concurrency" "06" "Zero-Conflict Concurrent Workspaces & Isolated Execution" (copy "F6 lead") (ulist-of "Concurrency sub-features") (code-of "A refusal, verbatim")) (sec "evaluate" "07" "A Lisp Machine: A Living Knowledge Base" (copy "F7 lead") (ulist-of "Lisp Machine sub-features") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then."))) (sec "measured" "Measured" "Numbers, and where they came from" #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart") (quasiquote (p (@ (class "lead") (style "margin-top:22px")) (unquote (copy "Install")))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 80))))
