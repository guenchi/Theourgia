5a0f93e1 (160 1790973852886 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (doc-fences doc heading) (let find ((ls (split-char doc ("#%char" 10)))) (cond ((null? ls) (raise (list (quote memory-document) (quote no-such-heading) heading))) ((not (string=? (car ls) heading)) (find (cdr ls))) (else (let loop ((ls (cdr ls)) (in #f) (buf (quote ())) (out (quote ()))) (cond ((and (null? ls) in) (raise (list (quote memory-document) (quote fence-never-closes) heading))) ((or (null? ls) (and (not in) (starts-with? (car ls) "#"))) (if (null? out) (raise (list (quote memory-document) (quote no-fence-under) heading)) (reverse out))) (in (if (string=? (car ls) "```") (loop (cdr ls) #f (quote ()) (cons (join-with-newline (reverse buf)) out)) (loop (cdr ls) #t (cons (car ls) buf) out))) ((starts-with? (car ls) "```") (loop (cdr ls) #t (quote ()) out)) (else (loop (cdr ls) #f buf out)))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 103))))
5ff6fb80 (161 1790974261695 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.1j" src "One store, one daemon. theourgia serve <store> holds the store open and keeps the reduced state in memory. The client is thin: it builds a request from the command line, sends it to the daemon and prints the answer; init and eval it hands to a local program, core.sc, instead, and it starts a daemon itself if it cannot reach one. Requests and answers are S-expression envelopes over a unix socket. The MCP shell is thin in the same way -- it asks the daemon for the tool list with describe rather than carrying its own copy."))
