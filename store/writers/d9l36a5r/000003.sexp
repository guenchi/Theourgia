24015754 (44 1790708686313 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.1x" src ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#12b09c;--acc2:#0d8a7a;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#1a8f8f;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo img{width:24px;height:24px;vertical-align:-4px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#e4f4f4 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);align-items:center;gap:36px}\n.hero-grid .cta{margin-bottom:0}\n.hero-text .tag{margin-bottom:30px}\n.hero-mark{display:block;width:56px;height:56px}\n.hero-intro{aspect-ratio:16/9;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg);box-shadow:0 12px 40px rgba(60,50,30,.10)}\n.hero-intro iframe{display:block;width:100%;height:100%;border:0}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  .hero-grid{grid-template-columns:1fr}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}\n.subsec{margin-top:38px}\n.subsec h3{font-size:20px;margin-bottom:10px}\n.subsec h4{font-size:16px;margin:24px 0 8px}\n.subsec p{color:var(--dim)}\n.subsec .lead{color:var(--dim)}\nol.design{margin:18px 0 0 22px;color:var(--dim)}\nol.design li{margin:10px 0}\nol.design li b{color:var(--fg);font-weight:600}\nul.design{margin:18px 0 0 22px;color:var(--dim);list-style:none;padding:0}\nul.design li{margin:14px 0;padding-left:18px;border-left:3px solid var(--acc)}\nul.design li b{color:var(--fg);font-weight:600}\n.md-body{max-width:820px;margin:0 auto;padding:56px 24px}\n.md-body h1{font-size:40px;letter-spacing:-1px;margin-bottom:8px}\n.md-body h2{font-size:28px;margin:44px 0 12px;padding-top:22px;border-top:1px solid var(--line)}\n.md-body h3{font-size:20px;margin:30px 0 8px}\n.md-body h4{font-size:16px;margin:22px 0 6px;color:var(--fg)}\n.md-body p{color:var(--dim);margin:0 0 14px}\n.md-body blockquote{margin:18px 0;padding:12px 18px;border-left:3px solid var(--gold);background:#fdfaf2;border-radius:0 8px 8px 0}\n.md-body blockquote p{margin:0}\n.md-body pre{margin:14px 0}\n.md-body code{color:var(--acc)}"))
