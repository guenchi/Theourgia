65ac9a58 (104 1790806046084 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define verb-table (quote ((init (usage (init)) (description "Create a store in this directory.") (protocol #f) (route local)) (eval (usage (eval ("--lang" <language>) ("--cut" <cut>) ("--under" <library>) ("--working") ("--latest") ("--writer" <name>) ("--timeout-ms" <n>) ("--memory-bytes" <n>) ("--output-bytes" <n>) <source>)) (description "Evaluate source against the store, or against a writer's working view with --working: Scheme by default, another language with --lang, whose runner runs only where the operator has set THEOURGIA_RUNNERS=on. It runs as a child process of the caller, never in the store's server.") (protocol #f) (route child)) (insert (usage (insert ("--under" <id>) ("--after" <id>) "--title" <text> ("--text" <text>) ("--keywords" <text>))) (description "Add a block under a parent, with a title and optional text.") (protocol #t) (route daemon)) (set (usage (set <id> <field> <value> ("--if-unchanged" <version>) ("--based-on" <version>))) (description "Replace one field of one block.") (protocol #f) (route daemon)) (move (usage (move <id> <parent> ("--after" <id>))) (description "Move a block to another parent, optionally after a sibling.") (protocol #f) (route daemon)) (del (usage (del <id>)) (description "Retire a block. Its history stays.") (protocol #f) (route daemon)) (link (usage (link <from> <rel> <to>)) (description "Record a named relation between two blocks.") (protocol #f) (route daemon)) (unlink (usage (unlink <from> <rel> <to>)) (description "Remove a named relation between two blocks.") (protocol #f) (route daemon)) (write (usage (write <block> <bytes> ("--writer" <name>) ("--based-on" <version>) ("--working-cut" <cut>) ("--working-parent-writer" <name>) ("--working-parent" <version>) ("--rebase"))) (description "Save a draft of a block in a writer's own space, without committing it.") (protocol #t) (route daemon)) (restore (usage (restore <version> ("--writer" <name>))) (description "Take an earlier version of a draft back into a writer's space.") (protocol #f) (route daemon)) (commit (usage (commit (<block> ...) ("--writer" <name>) ("--working-version" <block>=<version>))) (description "Install a writer's drafts into the store as one change.") (protocol #f) (route daemon)) (drafts (usage (drafts ("--writer" <name>))) (description "List the drafts a writer is holding.") (protocol #f) (route daemon)) (diagnostics (usage (diagnostics ("--writer" <name>))) (description "List the diagnostics an editor supplied for a writer's working view, by block and then by start, each at a byte range of its block's own src.") (protocol #f) (route daemon)) (discard (usage (discard <block> ("--writer" <name>))) (description "Throw away a writer's draft of a block.") (protocol #f) (route daemon)) (batch (usage (batch <intents>)) (description "Carry out several changes as one request.") (protocol #f) (route daemon)) (split-suggest (usage (split-suggest <file> ("--output" <review-file>) ("--symbols" <symbols-file>))) (description "Propose where a long file could be divided into blocks. With --symbols, the cuts come from an editor's list of the file's top-level symbols instead of the language's definition patterns; the answer's cuts-from says which.") (protocol #f) (route daemon)) (import-code (usage (import-code <dir> ("--allow-delete") ("--datum"))) (description "Read a directory of source into the store. With --datum, the whole-line ; comments directly above a form become its doc; a ; comment inside a form is dropped, and the answer warns with its line and column. A #| |# block comment, and any comment inside a datum discarded with #;, is dropped with neither. With --datum, only Scheme files are read: those the language table gives to Scheme by extension (ss, sc, scm, sls, matched exactly); every other file the directory walk returns (it does not enter a name that starts with a dot) is listed, in the order it was walked, in the answer's skipped clause, which is there only when something was skipped. A file the reader refuses is named in the refusal's path clause. Text mode, without --datum, skips a file that is not UTF-8 text or that holds a NUL byte, and lists it in the same skipped clause; it is decided by the bytes, not the name, so a source file in a legacy 8-bit encoding or in UTF-16 is skipped and listed, not imported, unless its bytes happen to be valid UTF-8 with no NUL.") (protocol #f) (route daemon)) (export-code (usage (export-code <dir> ("--raw") ("--datum") ("--working") ("--writer" <name>))) (description "Write the store's source back out to a directory.") (protocol #f) (route daemon)) (def (usage (def <name> ("--under" <library>) <source>)) (description "Define or replace one named definition.") (protocol #f) (route daemon)) (import-md (usage (import-md <dir> ("--allow-delete"))) (description "Read a directory of markdown into the store.") (protocol #f) (route daemon)) (export-md (usage (export-md <dir> ("--with-ids") ("--working") ("--writer" <name>))) (description "Write the store out as markdown.") (protocol #f) (route daemon)) (supply (usage (supply <kind> <file> ("--for" <writer>) ("--clear"))) (description "Keep facts an editor computed from an export-code projection -- signatures, calls, diagnostics -- beside the store, never in it. The file's header names the projection it was made from; every file it lists is checked against the store's own re-projection, of the committed state or, with --for, of that writer's working view. A fact is used only while the blocks it depends on still project as they did. With --clear, the table the header names is removed.") (protocol #f) (route daemon)) (adopt (usage (adopt)) (description "Take in records that are on disk but not yet in the log.") (protocol #f) (route daemon)) (check (usage (check)) (description "Read the whole store and report whether it is sound.") (protocol #f) (route daemon)) (snapshot (usage (snapshot)) (description "Record the current state as a reduction that can be reopened quickly.") (protocol #f) (route daemon)) (publish (usage (publish <writer> <segment> <file> (<sha256>))) (description "Publish a segment of a writer's log.") (protocol #f) (route daemon)) (outline (usage (outline ("--depth" <n>) ("--with-keywords") ("--with-signatures"))) (description "List the blocks as a tree of titles.") (protocol #f) (route daemon)) (read (usage (read <id> ("--md") ("--recursive") ("--writer" <name>) ("--working") ("--working-info") ("--signature"))) (description "Read one block: its fields, or its text. With --signature, the signature an editor supplied for it, of the committed store or, with --working, of the writer's working view.") (protocol #f) (route daemon)) (refs (usage (refs <id>)) (description "List the relations a block takes part in.") (protocol #f) (route daemon)) (reach (usage (reach <id> ("--rel" <rel>) ("--depth" <n>))) (description "List the blocks a block reaches over the edges an editor supplied (calls, by default), outward, up to --depth hops (1 by default); the block itself is at depth 0.") (protocol #f) (route daemon)) (search (usage (search <query> ("--all"))) (description "Find blocks whose title, keywords or text match every word given.") (protocol #f) (route daemon)) (grep (usage (grep <pattern> ("--under" <id>) ("--all"))) (description "List the lines that contain a pattern, literally.") (protocol #f) (route daemon)) (whereis (usage (whereis <name>)) (description "Say where a name is defined, and which libraries carry it.") (protocol #f) (route daemon)) (log (usage (log (<id>))) (description "Show the changes recorded, for the store or for one block.") (protocol #f) (route daemon)) (tag (usage (tag (<name>))) (description "Name the current cut, or list the names already given.") (protocol #f) (route daemon)) (diff (usage (diff <cut> <cut>)) (description "Report what changed between two cuts.") (protocol #f) (route daemon)) (conflicts (usage (conflicts)) (description "List blocks whose writers disagree.") (protocol #f) (route daemon)) (describe (usage (describe)) (description "List the verbs, what each is for, and the writing protocol.") (protocol #f) (route daemon))))) (doc . "") (parent . "8pniyrtk.2") (ord . 87))))
1b3df668 (105 1790846337485 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (md-table-cells line) (define (trim s) (let ((drop (lambda (l) (let d ((l l)) (if (and (pair? l) (char=? (car l) ("#%char" 32))) (d (cdr l)) l))))) (list->string (reverse (drop (reverse (drop (string->list s)))))))) (let loop ((cs (cdr (string->list (trim line)))) (cell (quote ())) (cells (quote ())) (code #f)) (cond ((null? cs) (reverse (if (null? cell) cells (cons (trim (list->string (reverse cell))) cells)))) ((char=? (car cs) ("#%char" 96)) (loop (cdr cs) (cons (car cs) cell) cells (not code))) ((and (not code) (char=? (car cs) ("#%char" 124))) (loop (cdr cs) (quote ()) (cons (trim (list->string (reverse cell))) cells) code)) (else (loop (cdr cs) (cons (car cs) cell) cells code))))) (doc . "") (parent . "8pniyrtk.2") (ord . 88))))
1fa3915f (106 1790846337907 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (md-table-separator? line) (let ((cs (string->list line))) (and (starts-with? line "|") (memv ("#%char" 45) cs) (let loop ((cs cs)) (or (null? cs) (and (memv (car cs) (quote (("#%char" 124) ("#%char" 45) ("#%char" 58) ("#%char" 32)))) (loop (cdr cs)))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 89))))
f1f160f1 (107 1790846338313 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (md-table rows) (define (tr tag line) (join (list "<tr>" (join (map (lambda (c) (join (list "<" tag ">" (md-inline c) "</" tag ">"))) (md-table-cells line))) "</tr>"))) (join (list "<table><thead>" (tr "th" (car rows)) "</thead><tbody>" (join (map (lambda (l) (tr "td" l)) (cddr rows))) "</tbody></table>"))) (doc . "") (parent . "8pniyrtk.2") (ord . 90))))
b4ac1ee2 (108 1790846338703 "guenchi" (("8pniyrtk" . 328)) (del "8pniyrtk.6g"))
7f6eedd3 (109 1790846339205 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (md->html text) (define (para ls) (if (null? ls) "" (join (list "<p>" (md-inline (join-with-space (reverse ls))) "</p>")))) (define (quoted ls) (if (null? ls) "" (join (list "<blockquote><p>" (md-inline (join-with-space (reverse ls))) "</p></blockquote>")))) (let loop ((ls (split-char text ("#%char" 10))) (mode (quote normal)) (buf (quote ())) (out (quote ()))) (cond ((null? ls) (join (reverse (cons (if (eq? mode (quote quote)) (quoted buf) (para buf)) out)))) ((eq? mode (quote code)) (if (starts-with? (car ls) "```") (loop (cdr ls) (quote normal) (quote ()) (cons (join (list "<pre><code>" (esc (join-with-newline (reverse buf))) "</code></pre>")) out)) (loop (cdr ls) (quote code) (cons (car ls) buf) out))) ((starts-with? (car ls) "```") (loop (cdr ls) (quote code) (quote ()) (cons (if (eq? mode (quote quote)) (quoted buf) (para buf)) out))) ((starts-with? (car ls) "|") (let take ((rest ls) (rows (quote ()))) (if (and (pair? rest) (starts-with? (car rest) "|")) (take (cdr rest) (cons (car rest) rows)) (let ((rows (reverse rows))) (if (and (pair? (cdr rows)) (md-table-separator? (cadr rows))) (loop rest (quote normal) (quote ()) (cons (md-table rows) (cons (if (eq? mode (quote quote)) (quoted buf) (para buf)) out))) (loop rest mode (append (reverse rows) buf) out)))))) ((starts-with? (car ls) "> ") (loop (cdr ls) (quote quote) (cons (substring (car ls) 2 (string-length (car ls))) (if (eq? mode (quote quote)) buf (quote ()))) (if (eq? mode (quote quote)) out (cons (para buf) out)))) ((md-heading-level (car ls)) => (lambda (n) (loop (cdr ls) (quote normal) (quote ()) (cons (join (list "<h" (number->string n) ">" (md-inline (substring (car ls) (+ n 1) (string-length (car ls)))) "</h" (number->string n) ">")) (cons (if (eq? mode (quote quote)) (quoted buf) (para buf)) out))))) ((string=? (car ls) "") (loop (cdr ls) (quote normal) (quote ()) (cons (if (eq? mode (quote quote)) (quoted buf) (para buf)) out))) (else (loop (cdr ls) (if (eq? mode (quote quote)) (quote quote) (quote normal)) (cons (car ls) buf) out))))) (doc . "") (parent . "8pniyrtk.2") (ord . 91))))
18ba60a6 (110 1790846687921 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8k" src "Requirements: Chez Scheme, igropyr, and libuv. No build step when run from source; objects are one command.\n\nChez Scheme 10.1.0, 10.3.0, 10.4.0 or 10.4.1 (the datum printer is measured identical on these; any other version refuses the verbs that print a datum with `(error unsupported-printer-version)`).\n\nPlatforms: the ones with a measured row in `platform-numbers.sc` -- macOS on arm64, Linux on x86_64 and on aarch64 with glibc, and FreeBSD on amd64 (the row was measured on FreeBSD 15, and it is chosen by machine type alone, so another FreeBSD release on amd64 gets it too). On any other platform (another architecture, macOS on x86_64 or under Rosetta, a Linux with musl) every program writes `(error platform-unmeasured ...)` and exits 75 before it does anything else.\n\nmacOS: `brew install chezscheme libuv`\nDebian / Ubuntu: `apt install chezscheme libuv1-dev`\nFedora: `dnf install chez-scheme libuv-devel`\nArch: `pacman -S chez-scheme libuv`\nFreeBSD: `pkg install chez-scheme libuv`"))
7928c0fb (111 1790846688126 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8u" src "Two agents on one writer id: silent overwrite, no detection. The rule is in the documentation; the code does not enforce it.\n\nTwo machines on one store: not supported. A store belongs to one machine's registry; moving it to another requires adopt.\n\nPlatforms: only those with a measured row run -- macOS on arm64, Linux on x86_64 and aarch64 with glibc, FreeBSD on amd64 (measured on FreeBSD 15; the row is chosen by machine type, not by release). Anything else exits 75 with platform-unmeasured; the remedy is to run test/probe/layout.c there and add its row.\n\nExports at a cut: export-md and export-code take no --cut. They write the committed state, or with --working the writer's working view; only a --working export's answer names the cut its view stands on, and an earlier cut has no export.\n\nRunners (--lang): the Scheme evaluator runs in a sandboxed child process with no filesystem and no network. A runner for another language (node, python3, sh, or chez, which runs Scheme outside the sandbox with the store's libraries on its path) gets a projected copy of the store's code files in a temporary directory and the machine's own interpreter, so it has the reach of a local script. Runners are off by default (THEOURGIA_RUNNERS=on)."))
977c34c1 (112 1790846688324 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8p" src "Every verb can run standalone: open the store, answer, exit. For a session that sends many verbs, serve holds the store open and answers over a unix socket. The client finds the socket by the same rule the daemon used to create it, so nothing needs to be told where it is. The daemon's answer is the CLI's answer, byte for byte; both call the same dispatcher, and no verb or answer shape exists in one and not the other, except eval: the daemon does not run it -- sent over the socket, it is answered unknown-verb -- and the CLI runs it in core.sc as its own child. When no daemon is running, the CLI starts one beside itself and asks again; `THEOURGIA_LOCAL=1` skips the socket and answers in process, for debugging. The daemon answers reads from the state it last folded, and can be one commit behind an outside change: a read that notices a record appended by another process, or a segment a git pull brought in, is still answered from that state and asks for a fresh fold, and the reads after the fold see the change. A write is never answered from that state: it is decided on the store as it stands under the lock. While a daemon serves a store, write through it."))
f42b5680 (113 1790846688532 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.2p" src "These are accepted by every verb, and are left out of each usage line above.\n\n| Option | What it does |\n|---|---|\n| `--store <dir>` | Which store. Falls back to `THEOURGIA_STORE`, then `.` |\n| `--actor <name>` | Who the request is from. Falls back to `THEOURGIA_ACTOR`, then `USER`, then `cli` |\n| `--socket <path>` | Reach a daemon at this path instead of the default |\n| `--wire` | Print the answer as one S-expression per line rather than for a person to read |\n| `--req <id>` | The request's identity, so a retry is recognised as the same request rather than a second one |\n| `--cursor <w:n>` | The position this request is composed against |\n\nA request that reaches a server naming `--store`, `--actor`, `--wire` or `--socket` inside it is refused `transport-option-in-rpc`: those say where a request goes, and it has already gone.\n\n| Variable | What it does |\n|---|---|\n| `THEOURGIA_STORE` | The store when `--store` is absent |\n| `THEOURGIA_ACTOR` | Who the requests are from when `--actor` is absent |\n| `THEOURGIA_WRITER` | Whose drafts a request reads and writes when `--writer` is absent |\n| `THEOURGIA_HOME` | Where the machine registry and its lock live. Falls back to `$HOME/.theourgia`, or `/tmp/.theourgia` when `HOME` is unset |\n| `THEOURGIA_RUN` | The run root holding daemon sockets. Falls back to `$HOME/.theourgia/run` |\n| `THEOURGIA_LOCAL` | `1` answers in process even when a daemon is there |\n| `THEOURGIA_SCHEME` | The Chez binary `eval` starts its child with. Falls back to `scheme` |\n| `THEOURGIA_EVAL_SLOTS` | How many evaluations one run root runs at once. Falls back to the number of online processors |\n| `THEOURGIA_RUNNERS` | `on` turns on `eval --lang`'s runners for another language |\n| `THEOURGIA_RUNNER_CHEZ` | The operator's runner for `eval --lang chez`, replacing the language table's fields |\n| `THEOURGIA_TRACE` | `1` writes filesystem and dispatch events to stderr |"))
086e8b5b (114 1790846688729 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.5" src "The extension drives the Theourgia core installed on the machine, and needs VS Code 1.138.0 or later. Install the core first (from source for now: the Homebrew tap and the npm package are not published yet), then configure the settings:\n\n| Setting | What it is |\n|---|---|\n| `theourgia.corePath` | The directory holding the core: a checkout, or a directory built by the core's build.ss. The extension tells which by looking for `client.sc` or `client.so`, and refuses a directory with neither. Required. |\n| `theourgia.libDirs` | Extra directories for `CHEZSCHEMELIBDIRS`, after `corePath`. The core imports igropyr, so the directory holding igropyr belongs here. |\n| `theourgia.store` | The store directory, passed as `--store`. Required. |\n| `theourgia.actor` | The name recorded with every write. Defaults to the OS user name. |\n| `theourgia.writer` | Passed to the core as `THEOURGIA_WRITER`, and the writer whose working view Supply Diagnostics reads. Defaults to the actor. |\n| `theourgia.scheme` | The Chez Scheme executable. Defaults to `scheme`. |\n| `theourgia.timeoutMs` | How long to wait for one request before killing the child process (SIGTERM, then SIGKILL two seconds later). Defaults to 30000. |\n\nUntil `corePath` names a checkout or a built directory and `store` is set, the outline is empty, the status bar shows a gear whose tooltip names each setting at fault, and every command answers that they have to be set first. `store` is only checked for being set: a path that does not exist passes, and the requests go to the core.\n\nEach request runs the core's client as a child process, `<scheme> --script <corePath>/theourgia.sc <verb> ... --store <store> --actor <actor>`, with `CHEZSCHEMELIBDIRS`, `CHEZSCHEMELIBEXTS`, `THEOURGIA_ACTOR`, `THEOURGIA_WRITER` and `THEOURGIA_SCHEME` set from the settings. The client starts the store's daemon when none is running. A core that cannot find a library is answered with advice to add its directory to `libDirs`; a platform the core has no row for is answered with the core's own remedy."))
a1d7fefc (115 1790846688941 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.7" src "An outline tree of the store appears in the side bar. Expanding a node lists the blocks directly under it; a row shows the block's keywords, and an icon for a conflict, an orphan or an unknown mark. Clicking a block opens it. A prose block opens as a markdown buffer: its heading, then this window's working draft of its body. The heading is not edited there -- a save that changed it is refused `prefix-changed`.\n\nSaving writes a working draft first, under a writer of this window's own (`window-<session>`), reads it back, and then sends a commit carrying the draft's version. The request id, cursor and record are written to disk before the commit is sent, so a save whose answer is lost -- a timeout, a lost connection -- stays pending and is retried: at startup, on a settings change, or with \"Retry Pending Saves\". A commit is refused `stale-baseline` when the block itself has changed since the draft's baseline. When other writers have written since, but not to this block, the commit is accepted and the save names those writers; the number shown beside each, worded as records since the save's baseline, is that writer's latest record number, not a count of the records added since. A commit the core refuses (`stale-baseline`, `working-version-changed`, `changed`) is shown as an error naming the refusal and its clauses, and says the text is still in the file and has not been saved; nothing is merged for you. Before anything is sent, a save is refused for a byte-order mark, bytes that are not UTF-8, a file on disk that differs from the editor, or a changed heading.\n\n\"Reconcile Block\" is for a block file holding a version neither this window nor the store wrote. If the file still begins with the block's heading, it keeps the text as a draft against the store without asking. Otherwise it offers two choices -- keep my text, with the block's heading in front of it, or take the store's version -- and publishes a new version either way; nothing is deleted.\n\nRight-clicking a node and choosing \"Open as Document\" composes the block and everything under it into one read-only markdown document. The opened block's heading is level 1 and each level under it one deeper, down to level 6; headings inside a body are shifted down with it, and each block is preceded by a `<!-- theourgia block <id> depth <n> -->` marker. A block that is deleted, cannot be placed, appears twice or is not text refuses the whole document rather than leaving a gap. The document is composed again each time the command runs.\n\nThe tree has a second mode, Files, showing the directory tree that export would write, with a group for blocks that are in no file. A store whose root blocks carry paths opens in Files mode; \"Show Files\" and \"Show Outline\" switch, and the choice is kept per store. \"New File Here\" creates a root `doc` block with that path (`.md` appended) and title. \"Move to Directory\" and \"Rename File\" read the block's version when they run and set its path with `--if-unchanged`: a block that changes before the answer is refused, and the view refreshes.\n\nA text-mode code block opens as its source in the language its `lang` field names, or as plain text without one. A datum-mode definition -- one imported with --datum or written with def -- opens with an empty body today: the extension reads a block's src, and a datum definition keeps its code in body. \"Go to Definition\", as a command and as the editor's own, asks the store's `whereis` which block defines a name, offers a choice when several do, and the nearest names when none does. \"Suggest a Split\" asks the core where a source file on disk could be divided into blocks, using the editor's own symbols for the cuts when it has them and the language's patterns otherwise, and opens the review file the core wrote; nothing is recorded in the store.\n\n\"Search Blocks\" asks for words that must all match: one hit opens straight away, several give a list with scores. \"Show Store Status\" and the status bar show the store, actor, conflict count, pending and blocked saves. \"Other Sessions\" lists the unsent saves another window left behind, to take over or discard. \"Migrate Legacy Block Files\" moves verified block files of an earlier version into a recovery archive. The store is checked with `check` each time the extension connects to it -- at start and after a settings change -- and a bad verdict is warned about once per session; the extension's log is the \"Theourgia\" output channel.\n\nWhen a writer's log cannot be read, the outline shows the blocks the other writers' logs can still place -- a block whose records depend on the unreadable writer's stays pending and is not shown -- and says which one is missing, the path and the reason. The note is carried by the outline, the status bar, search, Go to Definition and the banner of an opened block or document, and it belongs to the last reading: the next complete reading clears it."))
5bfe4123 (116 1790860611045 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.s" src "A block-graph store for LLM agents"))
69667f43 (117 1790860611269 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.3l" src "A store is plain files: meta.sexp, the lock, each writer's numbered segments with one record per line and its owner.sexp and published.sexp, and the blobs. Committing them commits the store itself. There is no export step, nothing to project, and nothing that has to be kept in step with the content, because the content is what was committed. A segment file's diff is the records that were appended: the revision of these pages that corrected four figures shows up in git as 15 added lines and no deleted ones, the log being append-only."))
6451e083 (118 1790860611474 "guenchi" (("8pniyrtk" . 328)) (del "d9l36a5r.1j"))
05ba5af6 (119 1790860611732 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (page-index) (shell "Theourgia -- a block-graph store for LLM agents" "A block-graph store that agents and people write into together: a minimal query surface, one graph across code and prose, backlinks in one query, deterministic context assembly, a shared editor, scratchpads with per-block optimistic commits, and Scheme blocks that run." "Home" (list (quasiquote (header (div (@ (class "wrap hero-grid")) (div (@ (class "hero-text")) (div (@ (class "hero-title")) (img (@ (class "hero-mark") (src "favicon.svg") (alt "") (width "52") (height "52"))) (h1 "Theourgia")) (p (@ (class "tag")) (unquote (copy "Tagline"))) (div (@ (class "cta")) (a (@ (class "btn primary") (href "https://github.com/guenchi/theourgia")) "Get the code") (a (@ (class "btn ghost") (href "why.html")) "Why not markdown"))) (div (@ (class "hero-intro")) (iframe (@ (src "intro.html") (title "Theourgia intro"))))))) (sec "features" "Core features" "Blocks, not files" #f (prose "Core features lead")) (sec "query" "01" "A Minimal Query Surface for Agents" (copy "F1 lead") (code-of "F1 example")) (sec "graph" "02" "One Unified Graph Across Docs and Source Code" (copy "F2 lead") (graph-svg) (quasiquote (p (@ (style "margin-top:22px")) (a (@ (href "manual.html")) "The store, the block and the log, in full") " ->"))) (sec "refs" "03" "Global Backlinks at Near-Zero Cost" (copy "F3 lead") (code-of "Refs, verbatim") (prose "F3 measurement") (table-of "F3 cost table")) (sec "context" "04" "Deterministic Context Assembly" (copy "F4 lead") (prose "Context two layers") (ulist-of "Context sub-features")) (sec "people" "05" "Humans and Agents in the IDE" (copy "F5 lead") (ulist-of "IDE scarce uses")) (sec "concurrency" "06" "Zero-Conflict Concurrent Workspaces & Isolated Execution" (copy "F6 lead") (ulist-of "Concurrency sub-features") (code-of "A refusal, verbatim")) (sec "evaluate" "07" "A Lisp Machine: A Living Store" (copy "F7 lead") (ulist-of "Lisp Machine sub-features") (code-of "History evaluation, verbatim") (quasiquote (p (@ (class "lead") (style "margin-top:18px")) "The definition was changed between the two calls. The second asks for the " "earlier cut and gets the behaviour that was there then."))) (sec "measured" "Measured" #f #f (nums-panel "Numbers") (note-of "How the numbers were taken")) (sec "start" "Start" "A store is a directory" #f (code-of "Quickstart"))))) (doc . "") (parent . "8pniyrtk.2") (ord . 92))))
