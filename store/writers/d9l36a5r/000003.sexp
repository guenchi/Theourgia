\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"60.03\" lengthAdjust=\"spacingAndGlyphs\">RUST</text><rect x=\"633.6\" y=\"545.6\" width=\"76.82\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"657\" y=\"583\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"30.02\" lengthAdjust=\"spacingAndGlyphs\">GO</text><rect x=\"981.6\" y=\"325.6\" width=\"106.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"1005\" y=\"363\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"60.03\" lengthAdjust=\"spacingAndGlyphs\">TEST</text><rect x=\"899.1\" y=\"495.6\" width=\"271.88\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"922.5\" y=\"533\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"225.08\" lengthAdjust=\"spacingAndGlyphs\">DECISION RECORD</text></svg>"))
d181c89c (75 1790765618943 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.1x" src ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#12b09c;--acc2:#0d8a7a;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#1a8f8f;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo img{width:24px;height:24px;vertical-align:-4px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#e4f4f4 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);align-items:center;gap:36px}\n.hero-grid .cta{margin-bottom:0}\n.hero-text .tag{margin-bottom:30px}\n.hero-title{display:flex;align-items:center;gap:14px;margin:10px 0 16px}\n.hero-title h1{margin:0}\n.hero-mark{display:block;flex:none;width:52px;height:52px}\n.hero-intro{aspect-ratio:16/9;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg);box-shadow:0 12px 40px rgba(60,50,30,.10)}\n.hero-intro iframe{display:block;width:100%;height:100%;border:0}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--gold);background:#fdfaf2;padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px;max-width:700px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  .hero-mark{width:38px;height:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  .hero-grid{grid-template-columns:1fr}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}\n.subsec{margin-top:38px}\n.subsec h3{font-size:20px;margin-bottom:10px}\n.subsec h4{font-size:16px;margin:24px 0 8px}\n.subsec p{color:var(--dim)}\n.subsec .lead{color:var(--dim)}\nol.design{margin:18px 0 0 22px;color:var(--dim)}\nol.design li{margin:10px 0}\nol.design li b{color:var(--fg);font-weight:600}\nul.design{margin:18px 0 0 22px;color:var(--dim);list-style:none;padding:0}\nul.design li{margin:14px 0;padding-left:18px;border-left:3px solid var(--acc)}\nul.design li b{color:var(--fg);font-weight:600}\n.md-body{max-width:820px;margin:0 auto;padding:56px 24px}\n.md-body h1{font-size:40px;letter-spacing:-1px;margin-bottom:8px}\n.md-body h2{font-size:28px;margin:44px 0 12px;padding-top:22px;border-top:1px solid var(--line)}\n.md-body h3{font-size:20px;margin:30px 0 8px}\n.md-body h4{font-size:16px;margin:22px 0 6px;color:var(--fg)}\n.md-body p{color:var(--dim);margin:0 0 14px}\n.md-body blockquote{margin:18px 0;padding:12px 18px;border-left:3px solid var(--gold);background:#fdfaf2;border-radius:0 8px 8px 0}\n.md-body blockquote p{margin:0}\n.md-body pre{margin:14px 0}\n.md-body code{color:var(--acc)}"))
cc49559e (76 1790765619146 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.1w" src "<svg viewBox=\"230 210 941.58 396\" xmlns=\"http://www.w3.org/2000/svg\" overflow=\"visible\" role=\"img\" aria-label=\"Docs, code, tests — one graph, any language\"><defs><marker id=\"og-arrow\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"13\" markerHeight=\"13\" markerUnits=\"userSpaceOnUse\" orient=\"auto\"><path d=\"M0 0 L10 5 L0 10 z\" fill=\"rgb(13, 138, 122)\"/></marker><filter id=\"og-shadow\" x=\"-20%\" y=\"-40%\" width=\"140%\" height=\"200%\"><feDropShadow dx=\"0\" dy=\"8\" stdDeviation=\"13\" flood-color=\"rgb(60,50,30)\" flood-opacity=\"0.10\"/></filter></defs><g stroke=\"rgb(13, 138, 122)\" stroke-width=\"1.6\" fill=\"none\" stroke-linecap=\"round\"><path d=\"M336.5 271 C336.5 322.5 336.5 322.5 336.5 374\" marker-end=\"url(#og-arrow)\"/><path d=\"M443 410.5 C535 410.5 535 245.5 627 245.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M443 410.5 C535 410.5 535 355.5 627 355.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M443 410.5 C535 410.5 535 465.5 627 465.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M443 410.5 C535 410.5 535 575.5 627 575.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M771 245.5 C873 245.5 873 355.5 975 355.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M771 355.5 C873 355.5 873 355.5 975 355.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M741 465.5 C858 465.5 858 355.5 975 355.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M711 575.5 C843 575.5 843 355.5 975 355.5\" marker-end=\"url(#og-arrow)\"/><path d=\"M1035 386 C1035 437.5 1035 437.5 1035 489\" marker-end=\"url(#og-arrow)\"/></g><g font-family=\"'SF Mono',Menlo,monospace\" font-weight=\"500\" font-size=\"20\" fill=\"rgb(13, 138, 122)\" paint-order=\"stroke\" stroke=\"#fbfaf7\" stroke-width=\"8\"><text x=\"352.5\" y=\"329.5\" text-anchor=\"start\">states</text><text x=\"535\" y=\"316\" text-anchor=\"middle\">met by</text><text x=\"873\" y=\"288.5\" text-anchor=\"middle\">checked by</text><text x=\"1051\" y=\"444.5\" text-anchor=\"start\">decided in</text></g><rect x=\"268.1\" y=\"210.6\" width=\"136.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"291.5\" y=\"248\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"90.03\" lengthAdjust=\"spacingAndGlyphs\">DESIGN</text><rect x=\"230.6\" y=\"380.6\" width=\"211.86\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"254\" y=\"418\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"165.06\" lengthAdjust=\"spacingAndGlyphs\">REQUIREMENT</text><rect x=\"633.6\" y=\"215.6\" width=\"136.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"657\" y=\"253\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"90.03\" lengthAdjust=\"spacingAndGlyphs\">SCHEME</text><rect x=\"633.6\" y=\"325.6\" width=\"136.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"657\" y=\"363\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"90.03\" lengthAdjust=\"spacingAndGlyphs\">PYTHON</text><rect x=\"633.6\" y=\"435.6\" width=\"106.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"657\" y=\"473\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"60.03\" lengthAdjust=\"spacingAndGlyphs\">RUST</text><rect x=\"633.6\" y=\"545.6\" width=\"76.82\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"657\" y=\"583\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"30.02\" lengthAdjust=\"spacingAndGlyphs\">GO</text><rect x=\"981.6\" y=\"325.6\" width=\"106.83\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"1005\" y=\"363\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"60.03\" lengthAdjust=\"spacingAndGlyphs\">TEST</text><rect x=\"899.1\" y=\"495.6\" width=\"271.88\" height=\"59.8\" rx=\"15\" fill=\"rgb(255, 255, 255)\" stroke=\"rgb(18, 176, 156)\" stroke-width=\"1.2\" filter=\"url(#og-shadow)\"/><text x=\"922.5\" y=\"533\" font-family=\"'SF Mono', ui-monospace, Menlo, monospace\" font-size=\"22\" font-weight=\"500\" fill=\"rgb(13, 138, 122)\" letter-spacing=\"1.76\" textLength=\"225.08\" lengthAdjust=\"spacingAndGlyphs\">DECISION RECORD</text></svg>"))
aa316b50 (77 1790765656846 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.1x" src ":root{--bg:#fbfaf7;--bg2:#f3f1ea;--panel:#f7f5ef;--line:#e4e0d5;--fg:#1c1b18;\n  --dim:#6a655c;--acc:#12b09c;--acc2:#0d8a7a;--gold:#9a6b12;--teal:#0f6f68;\n  --kw:#1a8f8f;--str:#0f6f3f;--com:#8a857a;--num:#8a4b12}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml{scroll-behavior:smooth}\nbody{background:var(--bg);color:var(--fg);\n  font:16px/1.65 -apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;\n  -webkit-font-smoothing:antialiased}\ncode,pre,.mono{font-family:ui-monospace,\"SF Mono\",SFMono-Regular,Menlo,Consolas,\"Liberation Mono\",monospace}\na{color:var(--acc2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:1040px;margin:0 auto;padding:0 24px}\n.narrow{max-width:760px}\nnav{position:sticky;top:0;z-index:10;background:rgba(251,250,247,.88);\n  backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}\nnav .wrap{display:flex;align-items:center;height:56px;gap:22px}\nnav .logo{font-weight:700;color:var(--fg);font-size:17px;letter-spacing:-.2px}\nnav .logo img{width:24px;height:24px;vertical-align:-4px}\nnav .links{margin-left:auto;display:flex;gap:18px;font-size:14px}\nnav .links a{color:var(--dim)}\nnav .links a:hover{color:var(--fg);text-decoration:none}\nnav .links a.on{color:var(--fg);font-weight:600}\nheader{padding:80px 0 56px;position:relative;overflow:hidden;\n  background:radial-gradient(60% 50% at 50% 0%,#e4f4f4 0%,transparent 100%)}\nheader .wrap{position:relative;z-index:1}\n.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);align-items:center;gap:36px}\n.hero-grid .cta{margin-bottom:0}\n.hero-text .tag{margin-bottom:30px}\n.hero-title{display:flex;align-items:center;gap:14px;margin:10px 0 16px}\n.hero-title h1{margin:0}\n.hero-mark{display:block;flex:none;width:52px;height:52px}\n.hero-intro{aspect-ratio:16/9;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--bg);box-shadow:0 12px 40px rgba(60,50,30,.10)}\n.hero-intro iframe{display:block;width:100%;height:100%;border:0}\nh1{font-size:54px;letter-spacing:-1.2px;margin:10px 0 16px}\n.tag{font-size:21px;color:var(--dim);max-width:660px;margin-bottom:12px}\n.tag b{color:var(--fg);font-weight:600}\n.sub{color:var(--dim);font-size:15px;margin-bottom:30px}\n.cta{display:flex;gap:14px;margin-bottom:38px;flex-wrap:wrap}\n.btn{display:inline-block;padding:11px 22px;border-radius:8px;font-size:15px;font-weight:600}\n.btn.primary{background:var(--acc);color:#fff}\n.btn.primary:hover{filter:brightness(1.12);text-decoration:none}\n.btn.ghost{border:1px solid var(--line);color:var(--fg)}\n.btn.ghost:hover{border-color:var(--dim);text-decoration:none}\nsection{padding:64px 0;border-top:1px solid var(--line)}\n.kicker{color:var(--acc);font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase}\nh2{font-size:32px;margin:8px 0 14px;letter-spacing:-.5px}\nh3{font-size:21px;margin-bottom:10px}\np{margin-bottom:14px}\n.lead{color:var(--dim);font-size:17px;max-width:700px}\n.grid2{display:grid;grid-template-columns:1fr 1fr;gap:36px;margin-top:36px}\n.grid2>*{min-width:0}\n.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:22px 24px}\n.card h3{font-size:18px;margin-bottom:8px}\n.card p{color:var(--dim);font-size:15px;margin-bottom:0}\n.card p+p{margin-top:10px}\n.nums{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:1px;\n  background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:32px}\n.num{background:var(--bg);padding:20px}\n.num b{display:block;font-size:30px;letter-spacing:-.5px;color:var(--acc);margin-bottom:6px}\n.num span{color:var(--dim);font-size:13.5px;line-height:1.5;display:block}\npre{background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:18px 20px;\n  overflow-x:auto;font-size:13px;line-height:1.6}\npre.wide{font-size:12.5px}\ncode{color:var(--acc);font-size:.86em;background:var(--bg2);padding:1px 5px;border-radius:4px}\npre code{background:none;padding:0;color:inherit;font-size:inherit}\n.k{color:var(--kw)}.s{color:var(--str)}.c{color:var(--com);font-style:italic}.n{color:var(--num)}\ntable{border-collapse:collapse;width:100%;margin-top:24px;font-size:14.5px}\nth,td{border:1px solid var(--line);padding:9px 12px;text-align:left;vertical-align:top}\nth{background:var(--bg2);font-weight:600}\ntd.mono,th.mono{font-family:ui-monospace,Menlo,monospace;font-size:13px;white-space:nowrap}\n.verb{border-top:1px solid var(--line);padding:16px 0}\n.verb:first-child{border-top:none}\n.verb .sig{font-family:ui-monospace,Menlo,monospace;font-size:13.5px;color:var(--fg);\n  background:var(--bg2);border:1px solid var(--line);border-radius:6px;padding:7px 10px;\n  display:block;overflow-x:auto;white-space:pre}\n.verb .d{color:var(--dim);font-size:15px;margin-top:8px}\n.verb .r{float:right;font-size:11px;letter-spacing:1px;text-transform:uppercase;\n  color:var(--dim);border:1px solid var(--line);border-radius:4px;padding:1px 6px;margin-left:8px}\n.note{border-left:3px solid var(--acc);background:var(--panel);padding:14px 18px;\n  border-radius:0 8px 8px 0;margin-top:24px;font-size:15px;color:var(--dim)}\n.note b{color:var(--fg)}\n.steps{counter-reset:s;margin-top:28px}\n.step{position:relative;padding-left:46px;margin-bottom:26px}\n.step:before{counter-increment:s;content:counter(s);position:absolute;left:0;top:-2px;\n  width:30px;height:30px;border-radius:50%;background:var(--acc);color:#fff;\n  font-size:14px;font-weight:700;display:flex;align-items:center;justify-content:center}\n.step h3{font-size:18px;margin-bottom:6px}\n.step p{color:var(--dim);font-size:15px;margin-bottom:0}\nfooter{border-top:1px solid var(--line);padding:40px 0;color:var(--dim);font-size:14px}\nfooter .wrap{display:flex;gap:18px;flex-wrap:wrap;align-items:center}\nfooter .sp{margin-left:auto}\n.diagram{margin-top:36px;max-width:700px}\n.diagram svg{width:100%;height:auto;display:block}\n@media (max-width:760px){\n  h1{font-size:38px}\n  .hero-mark{width:38px;height:38px}\n  header{padding:56px 0 40px}\n  .tag{font-size:18px}\n  .grid2{grid-template-columns:1fr;gap:24px}\n  .hero-grid{grid-template-columns:1fr}\n  nav .wrap{gap:12px}\n  nav .links{gap:11px;font-size:12.5px}\n  section{padding:48px 0}\n  h2{font-size:26px}\n}\n.subsec{margin-top:38px}\n.subsec h3{font-size:20px;margin-bottom:10px}\n.subsec h4{font-size:16px;margin:24px 0 8px}\n.subsec p{color:var(--dim)}\n.subsec .lead{color:var(--dim)}\nol.design{margin:18px 0 0 22px;color:var(--dim)}\nol.design li{margin:10px 0}\nol.design li b{color:var(--fg);font-weight:600}\nul.design{margin:18px 0 0 22px;color:var(--dim);list-style:none;padding:0}\nul.design li{margin:14px 0;padding-left:18px;border-left:3px solid var(--acc)}\nul.design li b{color:var(--fg);font-weight:600}\n.md-body{max-width:820px;margin:0 auto;padding:56px 24px}\n.md-body h1{font-size:40px;letter-spacing:-1px;margin-bottom:8px}\n.md-body h2{font-size:28px;margin:44px 0 12px;padding-top:22px;border-top:1px solid var(--line)}\n.md-body h3{font-size:20px;margin:30px 0 8px}\n.md-body h4{font-size:16px;margin:22px 0 6px;color:var(--fg)}\n.md-body p{color:var(--dim);margin:0 0 14px}\n.md-body blockquote{margin:18px 0;padding:12px 18px;border-left:3px solid var(--acc);background:var(--panel);border-radius:0 8px 8px 0}\n.md-body blockquote p{margin:0}\n.md-body pre{margin:14px 0}\n.md-body code{color:var(--acc)}"))
bc184e8d (78 1790804876033 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8k" src "Requirements: Chez Scheme, igropyr, and libuv. No build step when run from source; objects are one command.\n\nChez Scheme 10.1.0, 10.3.0, 10.4.0 or 10.4.1 (the datum printer is measured identical on these; any other version refuses the verbs that print a datum with `(error unsupported-printer-version)`).\n\nPlatforms: the ones with a measured row in `platform-numbers.sc` -- macOS on arm64, Linux on x86_64 and on aarch64 with glibc, and FreeBSD 15 on amd64. On any other platform (another architecture, macOS on x86_64 or under Rosetta, a Linux with musl) every program writes `(error platform-unmeasured ...)` and exits 75 before it does anything else.\n\nmacOS: `brew install chezscheme libuv`\nDebian / Ubuntu: `apt install chezscheme libuv1-dev`\nFedora: `dnf install chez-scheme libuv-devel`\nArch: `pacman -S chez-scheme libuv`\nFreeBSD: `pkg install chez-scheme libuv`"))
189f7a7b (79 1790804876246 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8o" src "Create the store first, once: `theourgia init --store <path>`. The MCP shell has no local route and does not offer `init` as a tool. Then register `theourgia-mcp --store <path>` in the client's MCP configuration. One store per project or per person, on one machine."))
633e2678 (80 1790804876452 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.14" src "A store is a directory, and everything in it is a plain file. meta.sexp names the store. Each writer owns a directory under writers/, holding one numbered segment file per run of writing: one record per line, a CRC and an S-expression, readable by a person and diffable by git. Large payloads go to blobs/. A writer's published.sexp records which of its segments have been handed to other machines."))
d0a60b14 (81 1790804876649 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.2n" src "store/\n  meta.sexp            the store's identity\n  instance.sexp        which machine and directory this copy is\n  lock                 zero bytes; only its existence is used\n  .gitignore           written by init: what stays out of git\n  writers/\n    f0sjkuzn/\n      owner.sexp       who this writer is\n      000001.sexp      one record per line: a CRC and an S-expression\n      published.sexp   which segments have been handed to other machines\n      incoming/        published segments kept but not installed\n      working/         this writer's drafts -- not part of the log\n  blobs/               payloads too large to sit in a record\n  snap/                a cached reduction; delete it and it is rebuilt\n  derived/             facts an editor supplied; the next supply rebuilds them"))
13c26b4a (82 1790804876850 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8p" src "Every verb can run standalone: open the store, answer, exit. For a session that sends many verbs, serve holds the store open and answers over a unix socket. The client finds the socket by the same rule the daemon used to create it, so nothing needs to be told where it is. The daemon's answer is the CLI's answer, byte for byte; both call the same dispatcher, and no verb or answer shape exists in one and not the other. When no daemon is running, the CLI starts one beside itself and asks again; `THEOURGIA_LOCAL=1` skips the socket and answers in process, for debugging. The daemon answers reads from the state it last folded, and can be one commit behind an outside change: a read that notices a record appended by another process, or a segment a git pull brought in, is still answered from that state and asks for a fresh fold, and the reads after the fold see the change. A write is never answered from that state: it is decided on the store as it stands under the lock. While a daemon serves a store, write through it."))
95346358 (83 1790804877055 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.3l" src "A store is plain files: meta.sexp, the lock, each writer's numbered segments with one record per line and its owner.sexp and published.sexp, and the blobs. Committing them commits the knowledge base itself. There is no export step, nothing to project, and nothing that has to be kept in step with the content, because the content is what was committed. A segment file's diff is the records that were appended: the revision of these pages that corrected four figures shows up in git as 15 added lines and no deleted ones, the log being append-only."))
4b6bf03a (84 1790804877255 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.3m" src "/instance.sexp\n/request-index.sexp\n/snap/\n/derived/\n/writers/*/working/\n/writers/*/draft.lock\n*.tmp-*\n!/writers/*/incoming/*"))
a458d2dd (85 1790804877453 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.3o" src "instance.sexp binds a store to the machine and the directory it was made in, so the first write from a clone is refused rather than accepted into a second copy of the same writer's log. A clone that carries another copy's instance.sexp is refused for the mismatch, as above; a clone without one -- what the .gitignore init writes gives -- is refused `(error refused no-instance (remedy adopt))`. adopt mints a new writer id and leaves the history where it is: the clone keeps every block it was given, and its own records go under the new id from then on. Reading never needed any of this -- outline, read, search and eval answer from a fresh clone straight away. Every answer above came from a clone of this site; the outline is abridged and the titles passed to insert are left out, and nothing else is changed."))
3768d698 (86 1790804877655 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8r" src "`theourgia-mcp --store <path> [--socket <path>] [--actor <name>] [--writer <name>]` speaks MCP `2025-11-25` over stdio. Create the store with `theourgia init` first, then register the shell once:\n\n```\nclaude mcp add theourgia -- theourgia-mcp --store /path/to/store --actor <name>\n```\n\nOr in a client's JSON configuration:\n\n```json\n{\n  \"mcpServers\": {\n    \"theourgia\": {\n      \"command\": \"theourgia-mcp\",\n      \"args\": [\"--store\", \"/path/to/store\", \"--actor\", \"<name>\"]\n    }\n  }\n}\n```\n\nOne tool per verb the shell can carry out -- every verb routed to the daemon, and `eval` -- named `theourgia_<verb>`, each taking `{\"argv\": [...]}` with the command line's own arguments as an array of strings. The shell asks the store's daemon for the catalogue on every call and never caches it, so a verb added to a newer build appears without restarting the server. `theourgia_insert` and `theourgia_write` carry the core's writing protocol in their descriptions.\n\nThe core's answer arrives as S-expression text, byte for byte. A core refusal is a successful tool result, not a JSON-RPC error: `(error unknown-id ...)` is the store's answer to the question asked, delivered with `isError: false`. Only the shell's own failures use the JSON-RPC error channel: a frame it could not parse, a frame past the size limit, or a connection that was made and then lost. A lost connection says the request may have been carried out, because it may have been; a request that reached nobody says it was not. A store condition the shell meets before the verb runs -- a daemon that would not start, a refused or unreadable catalogue -- is a tool result with `isError: true` and the refusal in `_meta.refusal`: read the text, not the flag.\n\n`eval` is offered as `theourgia_eval`. The shell runs `core.sc eval` as its own child, not through the daemon: the store's server never runs user code. The call's optional `stdin` string becomes the child's standard input; without one it reads `/dev/null`. Transport options (`--store`, `--wire`, `--socket`, `--actor`) are refused with `transport-option-in-rpc`; the writer defaults to the session's unless `--writer` is given; a language other than Scheme runs only where the shell was started with `THEOURGIA_RUNNERS=on`; a lost evaluation is a protocol error naming the reason. `init` is not offered, because the store must exist before the MCP server starts.\n\nThe catalogue comes from whichever daemon is serving the store, and a client may read `tools/list` only once per session. After a core upgrade, stop the store's daemon first — the next request starts one from the new core — then restart the agent's session. A session restarted while the old daemon still runs is given the old catalogue and sees none of the new verbs."))
4bcff662 (87 1790804877856 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8s" src "A writer id is held by one live agent at a time. On the command line it is `--writer`, else `THEOURGIA_WRITER`; with neither, a draft verb is refused `writer-required`. The MCP shell decides it once, when it starts: `THEOURGIA_WRITER` when set and not empty, else `--writer`, else one derived for the session, `<actor>-<start>-<pid>` -- the actor reduced to what a writer id may hold, the start in milliseconds in base 36, the shell's process id. The initialize response names it, and a tool call's own `--writer` overrides it for that call only. A name a writer cannot have (1 to 128 characters of `a-z`, `0-9`, `.`, `_`, `-`, and not `.` or `..`) stops the shell at start with its usage line, exit 2.\n\nA later session may bind the same id and carry on with its drafts, by starting with `THEOURGIA_WRITER=<that name>`, but two agents writing under one id at the same moment overwrite each other silently. There is no lock and no refusal: the rule is stated here, and the failure it prevents is silent. Derived writers differ between sessions, so the risk comes from a fixed name: a host that sets one `--writer` or `THEOURGIA_WRITER` for several agents makes them share it."))
b6cc5a56 (88 1790804878062 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.5" src "The extension drives the Theourgia core installed on the machine, and needs VS Code 1.138.0 or later. Install the core first (from source for now: the Homebrew tap and the npm package are not published yet), then configure the settings:\n\n| Setting | What it is |\n|---|---|\n| `theourgia.corePath` | The directory holding the core: a checkout, or a directory built by the core's build.ss. The extension tells which by looking for `client.sc` or `client.so`, and refuses a directory with neither. Required. |\n| `theourgia.libDirs` | Extra directories for `CHEZSCHEMELIBDIRS`, after `corePath`. The core imports igropyr, so the directory holding igropyr belongs here. |\n| `theourgia.store` | The store directory, passed as `--store`. Required. |\n| `theourgia.actor` | The name recorded with every write. Defaults to the OS user name. |\n| `theourgia.writer` | Passed to the core as `THEOURGIA_WRITER`, and the writer whose working view Supply Diagnostics reads. Defaults to the actor. |\n| `theourgia.scheme` | The Chez Scheme executable. Defaults to `scheme`. |\n| `theourgia.timeoutMs` | How long to wait for one request before killing the child process (SIGTERM, then SIGKILL two seconds later). Defaults to 30000. |\n\nUntil `corePath` and `store` are set and valid, the outline is empty, the status bar shows a gear whose tooltip names each setting at fault, and every command answers that they have to be set first.\n\nEach request runs the core's client as a child process, `<scheme> --script <corePath>/theourgia.sc <verb> ... --store <store> --actor <actor>`, with `CHEZSCHEMELIBDIRS`, `CHEZSCHEMELIBEXTS`, `THEOURGIA_ACTOR`, `THEOURGIA_WRITER` and `THEOURGIA_SCHEME` set from the settings. The client starts the store's daemon when none is running. A core that cannot find a library is answered with advice to add its directory to `libDirs`; a platform the core has no row for is answered with the core's own remedy."))
2e02b160 (89 1790804878261 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.6" src "Install the `.vsix` package for your platform from the command line:\n\n```\ncode --install-extension theourgia-darwin-arm64.vsix\n```\n\nThe packages are named `theourgia-<target>.vsix`. The Visual Studio Marketplace listing arrives when the extension is published there."))
6165bd16 (90 1790804878465 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.7" src "An outline tree of the store appears in the side bar. Expanding a node lists the blocks directly under it; a row shows the block's keywords, and an icon for a conflict, an orphan or an unknown mark. Clicking a block opens it. A prose block opens as a markdown buffer: its heading, then this window's working draft of its body. The heading is not edited there -- a save that changed it is refused `prefix-changed`.\n\nSaving writes a working draft first, under a writer of this window's own (`window-<session>`), reads it back, and then sends a commit carrying the draft's version. The request id, cursor and record are written to disk before the commit is sent, so a save whose answer is lost -- a timeout, a lost connection -- stays pending and is retried: at startup, on a settings change, or with \"Retry Pending Saves\". A commit whose baseline has moved can still be accepted, and the save then says how many records other writers have added since. A commit the core refuses (`stale-baseline`, `working-version-changed`, `changed`) is shown as an error naming the refusal and its clauses, and says the text is still in the file and has not been saved; nothing is merged for you. Before anything is sent, a save is refused for a byte-order mark, bytes that are not UTF-8, a file on disk that differs from the editor, or a changed heading.\n\n\"Reconcile Block\" is for a block file holding a version neither this window nor the store wrote. It offers two choices -- keep my text, with the block's heading in front of it, or take the store's version -- and publishes a new version either way; nothing is deleted.\n\nRight-clicking a node and choosing \"Open as Document\" composes the block and everything under it into one read-only markdown document. The opened block's heading is level 1 and each level under it one deeper, down to level 6; headings inside a body are shifted down with it, and each block is preceded by a `<!-- theourgia block <id> depth <n> -->` marker. A block that is deleted, cannot be placed, appears twice or is not text refuses the whole document rather than leaving a gap. The document is composed again each time the command runs.\n\nThe tree has a second mode, Files, showing the directory tree that export would write, with a group for blocks that are in no file. A store whose root blocks carry paths opens in Files mode; \"Show Files\" and \"Show Outline\" switch, and the choice is kept per store. \"New File Here\" creates a root `doc` block with that path (`.md` appended) and title. \"Move to Directory\" and \"Rename File\" read the block's version when they run and set its path with `--if-unchanged`: a block that changes before the answer is refused, and the view refreshes.\n\nA code block opens as its source in the language its `lang` field names, or as plain text without one. \"Go to Definition\", as a command and as the editor's own, asks the store's `whereis` which block defines a name, offers a choice when several do, and the nearest names when none does. \"Suggest a Split\" asks the core where a source file on disk could be divided into blocks, using the editor's own symbols for the cuts when it has them and the language's patterns otherwise, and opens the review file the core wrote; nothing is recorded in the store.\n\n\"Search Blocks\" asks for words that must all match: one hit opens straight away, several give a list with scores. \"Show Store Status\" and the status bar show the store, actor, conflict count, pending and blocked saves. \"Other Sessions\" lists the unsent saves another window left behind, to take over or discard. \"Migrate Legacy Block Files\" moves verified block files of an earlier version into a recovery archive. The store is checked with `check` once per session, and a bad verdict is warned about; the extension's log is the \"Theourgia\" output channel.\n\nWhen a writer's log cannot be read, the outline shows every other writer's blocks and says which one is missing, the path and the reason. The note is carried by the outline, the status bar, search, Go to Definition and the banner of an opened block or document, and it belongs to the last reading: the next complete reading clears it."))
3dd9dc27 (91 1790804878665 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.1k" src "Three commands hand the store facts that the editor's language support computes: \"Theourgia: Supply Signatures and Keywords\", \"Theourgia: Supply Calls\" and \"Theourgia: Supply Diagnostics\". Each projects the store's code with `export-code` into the extension's own storage, asks VS Code's providers for that language (symbols, hover, call hierarchy, diagnostics), and hands the facts to the core with `supply`, which keeps them beside the blocks with the editor and version they came from. The language's own extension must be installed: for C, clangd.\n\nSignatures, keywords and calls are taken from the committed store. Diagnostics are `theourgia.writer`'s, taken from its working view, and are collected once the analysis has been quiet for a second, at most after ten; a supply taken at the cap says the analysis may be incomplete. Facts are grouped by VS Code's language id, and VS Code files `.h` under C++, so a header's facts sit in the cpp table. A run stops if a projected file or document changes, or the store changes, while it is collecting. The supply file is removed afterwards, except one the core refused `supply-malformed`, which is kept to be read.\n\nAn agent reads the facts through MCP; from the command line they come back from `read <id> --signature`, `refs <id>`, `reach <id>`, `search <word>` and `diagnostics --writer <w>`. Each answer names the source of its facts (`via`) and how many of them are stale (`stale`). The facts are as fresh as the last supply: after a source changes, supply again.\n\n1.0 does not show these facts inside the editor; that is a later release."))
2d8e1cfd (92 1790804878877 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.8" src "Packages are built for macOS on Apple Silicon and on Intel, and Linux on x86_64 and arm64. The core has no measured row for macOS on Intel yet, so there the extension installs but the core refuses to start (`platform-unmeasured`). The extension takes a file lock through a small native module (`flock`) built on each target's own runner. There is no Windows package."))
d42ebeb9 (93 1790804879079 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.8u" src "Two agents on one writer id: silent overwrite, no detection. The rule is in the documentation; the code does not enforce it.\n\nTwo machines on one store: not supported. A store belongs to one machine's registry; moving it to another requires adopt.\n\nPlatforms: only those with a measured row run -- macOS on arm64, Linux on x86_64 and aarch64 with glibc, FreeBSD 15 on amd64. Anything else exits 75 with platform-unmeasured; the remedy is to run test/probe/layout.c there and add its row.\n\nExports at a cut: export-md and export-code take no --cut. They write the committed state, or with --working the writer's working view, and the answer names the cut that view stands on; an earlier cut has no export.\n\nRunners (--lang): the Scheme evaluator runs in a sandboxed child process with no filesystem and no network. A runner for another language (node, python3, sh, or chez, which runs Scheme outside the sandbox with the store's libraries on its path) gets a projected copy of the store's code files in a temporary directory and the machine's own interpreter, so it has the reach of a local script. Runners are off by default (THEOURGIA_RUNNERS=on)."))
afbd22a1 (94 1790804879285 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.2q" src "Every verb below, with its usage line and its one-sentence description, is rendered from what the store answers to describe. Nothing on this page is typed by hand, so it cannot drift from the binary that produced it. The tag on the right of each signature says where the verb runs: local in the client process, daemon over the socket, or child: a process the caller runs itself, so the store's server never runs user code."))
b42a4098 (95 1790804879494 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "What to exclude, and what to keep") (src . "init writes `<store>/.gitignore`, which keeps out what belongs to this copy of the store rather than to its history:") (keywords . "git, gitignore, init, exclude, store") (parent . "8pniyrtk.m") (ord . 17/2))))
4ca5f98b (96 1790804879695 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "Why those paths are excluded") (src . "instance.sexp is this copy's identity. request-index.sexp and snap/ are rebuilt from the log, and derived/ by the next supply. The working areas and draft locks are one machine's drafts. The `*.tmp-*` files are what an atomic write keeps after a failure -- except under a writer's incoming/, which the last line brings back, because a candidate kept there is evidence a replay is answered from.\n\nTrack the lock. It is zero bytes and only its existence is used, but a clone without it answers store-busy to every verb, reads included -- and init will not create it in a store that exists.\n\nAdd the store as a whole, never named files -- `git add <store>` -- because a segment rolls over after 1 MiB, and a list of named files misses the one that rolled since.") (keywords . "gitignore, instance, snapshot, derived, drafts, tmp, incoming, lock") (parent . "8pniyrtk.m") (ord . 19/2))))
011487dc (97 1790804879900 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "Options every verb takes") (src . "These are accepted by every verb, and are left out of each usage line above.\n\n| Option | What it does |\n|---|---|\n| `--store <dir>` | Which store. Falls back to `THEOURGIA_STORE`, then `.` |\n| `--actor <name>` | Who the request is from. Falls back to `THEOURGIA_ACTOR`, then `USER`, then `cli` |\n| `--socket <path>` | Reach a daemon at this path instead of the default |\n| `--wire` | Print the answer as one S-expression per line rather than for a person to read |\n| `--req <id>` | The request's identity, so a retry is recognised as the same request rather than a second one |\n| `--cursor <w:n>` | The position this request is composed against |\n\nA request that reaches a server naming `--store`, `--actor`, `--wire` or `--socket` inside it is refused `transport-option-in-rpc`: those say where a request goes, and it has already gone.\n\n| Variable | What it does |\n|---|---|\n| `THEOURGIA_STORE` | The store when `--store` is absent |\n| `THEOURGIA_ACTOR` | Who the requests are from when `--actor` is absent |\n| `THEOURGIA_WRITER` | Whose drafts a request reads and writes when `--writer` is absent |\n| `THEOURGIA_HOME` | Where the machine registry and its lock live. Falls back to `HOME` |\n| `THEOURGIA_RUN` | The run root holding daemon sockets. Falls back to `$HOME/.theourgia/run` |\n| `THEOURGIA_LOCAL` | `1` answers in process even when a daemon is there |\n| `THEOURGIA_SCHEME` | The Chez binary `eval` starts its child with. Falls back to `scheme` |\n| `THEOURGIA_EVAL_SLOTS` | How many evaluations one run root runs at once. Falls back to the number of online processors |\n| `THEOURGIA_RUNNERS` | `on` turns on `eval --lang`'s runners for another language |\n| `THEOURGIA_RUNNER_CHEZ` | The operator's runner for `eval --lang chez`, replacing the language table's fields |\n| `THEOURGIA_TRACE` | `1` writes filesystem and dispatch events to stderr |") (keywords . "options, environment, variables, store, actor, wire, socket") (parent . "8pniyrtk.o") (ord . 2))))
8a5e0870 (98 1790804880103 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "The writing protocol") (src . "describe carries this text once, beside the verbs, and the MCP shell puts it in the descriptions of `theourgia_insert` and `theourgia_write`:\n\n```\nA block is the unit of writing: one block should answer one question on its own.\nKeep a block under about 800 tokens (roughly 3000 bytes); split a longer one.\nGive every block a one-sentence title.\nGive every block 3 to 8 keywords, comma separated, with --keywords.\nPlace a block under the parent its source or subject puts it under, with --under.\nDo not rewrite the source bytes: splitting a document must not edit its prose.\nChange a block with write and then commit, through a draft, rather than replacing it.\nHold a writer id from one agent at a time: a later session may bind the same id and carry on with its drafts, but two agents writing one draft at once overwrite each other silently.\n```") (keywords . "protocol, block, title, keywords, writer, mcp, describe") (parent . "8pniyrtk.n") (ord . 19/2))))
ad96a7ac (99 1790804880311 "guenchi" (("8pniyrtk" . 328)) (del "d9l36a5r.l"))
814f5563 (100 1790804880545 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define verb-table (quote ((init (usage (init)) (description "Create a store in this directory.") (protocol #f) (route local)) (insert (usage (insert ("--under" <id>) ("--after" <id>) "--title" <text> ("--text" <text>) ("--keywords" <text>))) (description "Add a block under a parent, with a title and optional text.") (protocol #t) (route daemon)) (set (usage (set <id> <field> <value> ("--if-unchanged" <version>) ("--based-on" <version>))) (description "Replace one field of one block.") (protocol #f) (route daemon)) (move (usage (move <id> <parent> ("--after" <id>))) (description "Move a block to another parent, optionally after a sibling.") (protocol #f) (route daemon)) (del (usage (del <id>)) (description "Retire a block. Its history stays.") (protocol #f) (route daemon)) (link (usage (link <from> <rel> <to>)) (description "Record a named relation between two blocks.") (protocol #f) (route daemon)) (unlink (usage (unlink <from> <rel> <to>)) (description "Remove a named relation between two blocks.") (protocol #f) (route daemon)) (write (usage (write <block> <bytes> ("--writer" <name>) ("--based-on" <version>) ("--working-cut" <cut>) ("--working-parent-writer" <name>) ("--working-parent" <version>) ("--rebase"))) (description "Save a draft of a block in a writer's own space, without committing it.") (protocol #t) (route daemon)) (restore (usage (restore <version> ("--writer" <name>))) (description "Take an earlier version of a draft back into a writer's space.") (protocol #f) (route daemon)) (commit (usage (commit (<block> ...) ("--writer" <name>) ("--working-version" <block>=<version>))) (description "Install a writer's drafts into the store as one change.") (protocol #f) (route daemon)) (drafts (usage (drafts ("--writer" <name>))) (description "List the drafts a writer is holding.") (protocol #f) (route daemon)) (discard (usage (discard <block> ("--writer" <name>))) (description "Throw away a writer's draft of a block.") (protocol #f) (route daemon)) (batch (usage (batch <intents>)) (description "Carry out several changes as one request.") (protocol #f) (route daemon)) (split-suggest (usage (split-suggest <file> ("--output" <review-file>) ("--symbols" <symbols-file>))) (description "Propose where a long file could be divided into blocks.") (protocol #f) (route daemon)) (import-code (usage (import-code <dir> ("--allow-delete") ("--datum"))) (description "Read a directory of source into the store.") (protocol #f) (route daemon)) (export-code (usage (export-code <dir> ("--raw") ("--datum") ("--working") ("--writer" <name>))) (description "Write the store's source back out to a directory.") (protocol #f) (route daemon)) (def (usage (def <name> ("--under" <library>) <source>)) (description "Define or replace one named definition.") (protocol #f) (route daemon)) (import-md (usage (import-md <dir> ("--allow-delete"))) (description "Read a directory of markdown into the store.") (protocol #f) (route daemon)) (export-md (usage (export-md <dir> ("--with-ids") ("--working") ("--writer" <name>))) (description "Write the store out as markdown.") (protocol #f) (route daemon)) (adopt (usage (adopt)) (description "Take in records that are on disk but not yet in the log.") (protocol #f) (route daemon)) (check (usage (check)) (description "Read the whole store and report whether it is sound.") (protocol #f) (route daemon)) (snapshot (usage (snapshot)) (description "Record the current state as a reduction that can be reopened quickly.") (protocol #f) (route daemon)) (publish (usage (publish <writer> <segment> <file> (<sha256>))) (description "Publish a segment of a writer's log.") (protocol #f) (route daemon)) (outline (usage (outline ("--depth" <n>) ("--with-keywords") ("--with-signatures"))) (description "List the blocks as a tree of titles.") (protocol #f) (route daemon)) (read (usage (read <id> ("--md") ("--recursive") ("--writer" <name>) ("--working") ("--working-info") ("--signature"))) (description "Read one block: its fields, or its text.") (protocol #f) (route daemon)) (refs (usage (refs <id>)) (description "List the relations a block takes part in.") (protocol #f) (route daemon)) (search (usage (search <query> ("--all"))) (description "Find blocks whose title, keywords or text match every word given.") (protocol #f) (route daemon)) (log (usage (log (<id>))) (description "Show the changes recorded, for the store or for one block.") (protocol #f) (route daemon)) (tag (usage (tag (<name>))) (description "Name the current cut, or list the names already given.") (protocol #f) (route daemon)) (diff (usage (diff <cut> <cut>)) (description "Report what changed between two cuts.") (protocol #f) (route daemon)) (conflicts (usage (conflicts)) (description "List blocks whose writers disagree.") (protocol #f) (route daemon)) (describe (usage (describe)) (description "List the verbs, what each is for, and the writing protocol.") (protocol #f) (route daemon)) (eval (usage (eval ("--lang" <language>) ("--cut" <cut>) ("--under" <library>) ("--working") ("--latest") ("--writer" <name>) ("--timeout-ms" <n>) ("--memory-bytes" <n>) ("--output-bytes" <n>) <source>)) (description "Evaluate source against the store, or against a writer's working view with --working: Scheme by default, another language with --lang, whose runner runs only where the operator has set THEOURGIA_RUNNERS=on.") (protocol #f) (route child)) (supply (usage (supply <kind> <file> ("--for" <writer>) ("--clear"))) (description "Keep facts an editor computed from an export-code projection -- signatures, calls, diagnostics -- beside the store, never in it.") (protocol #f) (route daemon)) (reach (usage (reach <id> ("--rel" <rel>) ("--depth" <n>))) (description "List the blocks a block reaches over the edges an editor supplied (calls, by default), outward, up to --depth hops (1 by default); the block itself is at depth 0.") (protocol #f) (route daemon)) (diagnostics (usage (diagnostics ("--writer" <name>))) (description "List the diagnostics an editor supplied for a writer's working view, by block and then by start, each at a byte range of its block's own src.") (protocol #f) (route daemon)) (grep (usage (grep <pattern> ("--under" <id>) ("--all"))) (description "List the lines that contain a pattern, literally.") (protocol #f) (route daemon)) (whereis (usage (whereis <name>)) (description "Say where a name is defined, and which libraries carry it.") (protocol #f) (route daemon))))) (doc . "") (parent . "8pniyrtk.2") (ord . 85))))
f723836b (101 1790804880744 "guenchi" (("8pniyrtk" . 328)) (del "d9l36a5r.1m"))
6cc0f32c (102 1790804880981 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (manual-md) (join (list (md-head 1 "Theourgia manual") (md-head 2 "Installing") (md-para "Prerequisites") (md-head 3 "Homebrew") (md-para "Homebrew") (md-head 3 "npm") (md-para "npm") (md-head 3 "From source") (md-para "From source") (md-head 3 "Connecting a client") (md-para "Connecting a client") (md-head 2 "What a store is") (md-head 3 "A store") (md-para "A store") (md-fence "Store layout") (md-head 3 "A block") (md-para "A block") (md-fence "A block, as the store answers it") (md-head 3 "The log is the only truth") (md-para "The log is the only truth") (md-head 4 "Deletion keeps the history") (md-para "Deletion keeps the history") (md-head 3 "One graph over code and prose") (md-para "Everything is a block") (md-head 3 "One answer shape") (md-para "One answer shape") (md-head 3 "Writers") (md-para "A writer is an identity") (md-head 3 "Drafts, then commit") (md-para "Drafts, then commit") (md-head 4 "A refusal hands back the winner") (md-para "A refusal hands back the winner") (md-head 3 "One store per scope") (md-para "One store per scope") (md-head 3 "The daemon") (md-para "The daemon") (md-head 3 "Put the store in git") (md-para "Put the store in git") (md-head 4 "What to exclude, and what to keep") (md-para "What to exclude, and what to keep") (md-fence "A store's gitignore") (md-para "Why those paths are excluded") (md-head 4 "What a clone can do, and when") (md-fence "A clone's first write") (md-quote "What adopt does to a clone") (md-head 2 (join (list (number->string (length verb-table)) " verbs"))) (md-para "Reference intro") (md-verbs) (md-head 2 "Options every verb takes") (md-para "Options every verb takes") (md-head 2 "Working with agents") (md-head 3 "The MCP shell") (md-para "The MCP shell") (md-head 3 "The writing protocol") (md-para "The writing protocol") (md-head 3 "One writer per session") (md-para "One writer per session") (md-head 3 "One store per machine") (md-para "One store per machine") (md-head 3 "The memory recipe") (md-para "The memory recipe") (md-head 2 "The VS Code extension") (md-head 3 "Before you start") (md-para "Before you start") (md-head 3 "Installing the extension") (md-para "Installing the extension") (md-head 3 "What it does") (md-para "What it does") (md-head 3 "Supplying what the editor knows") (md-para "Supplying what the editor knows") (md-head 3 "Platforms") (md-para "Platforms") (md-head 2 "Limits") (md-para "Limits")))) (doc . "") (parent . "8pniyrtk.2") (ord . 86))))
