581320a9 (167 1790976273259 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (doc-fences doc heading) (define (fence-marker line) (cond ((starts-with? line "```") "```") ((starts-with? line "~~~") "~~~") (else #f))) (define (heading-line? line) (let count ((i 0)) (cond ((and (< i (string-length line)) (< i 6) (char=? (string-ref line i) ("#%char" 35))) (count (+ i 1))) ((= i 0) #f) ((= i (string-length line)) #t) (else (char=? (string-ref line i) ("#%char" 32)))))) (define (fail what) (raise (list (quote memory-document) what heading))) (define (indented-marker? line) (let skip ((i 0)) (cond ((and (< i (string-length line)) (< i 4) (char=? (string-ref line i) ("#%char" 32))) (skip (+ i 1))) ((or (= i 0) (= i 4)) #f) (else (let ((rest (substring line i (string-length line)))) (or (fence-marker rest) (heading-line? rest))))))) (let walk ((ls (split-char doc ("#%char" 10))) (open #f) (found #f) (body (quote ())) (out (quote ()))) (cond ((null? ls) (cond (open (fail (quote fence-never-closes))) ((not found) (fail (quote no-such-heading))) ((null? out) (fail (quote no-fence-under))) (else (reverse out)))) ((and open (not (string=? (car ls) open)) (starts-with? (car ls) open)) (raise (list (quote memory-document) (quote fence-line-not-read) (car ls)))) ((and (not open) (or (starts-with? (car ls) "````") (starts-with? (car ls) "~~~~"))) (raise (list (quote memory-document) (quote fence-line-not-read) (car ls)))) (open (if (string=? (car ls) open) (walk (cdr ls) #f found (quote ()) (if (eq? found (quote in)) (cons (apply string-append (map (lambda (l) (string-append l "\n")) (reverse body))) out) out)) (walk (cdr ls) open found (cons (car ls) body) out))) ((indented-marker? (car ls)) (raise (list (quote memory-document) (quote indented-fence-or-heading) (car ls)))) ((fence-marker (car ls)) => (lambda (m) (walk (cdr ls) m found (quote ()) out))) ((heading-line? (car ls)) (cond ((string=? (car ls) heading) (if found (fail (quote heading-twice)) (walk (cdr ls) #f (quote in) (quote ()) out))) ((eq? found (quote in)) (walk (cdr ls) #f (quote after) (quote ()) out)) (else (walk (cdr ls) #f found (quote ()) out)))) (else (walk (cdr ls) #f found body out))))) (doc . "") (parent . "8pniyrtk.2") (ord . 103))))
5191d15a (168 1790985774892 "guenchi" (("8pniyrtk" . 328)) (set "8pniyrtk.2p" src "Reading a store|read refs search grep whereis log outline tag diff describe commitments tasks names uses\nMaking and changing blocks|init template insert set move del link unlink def\nDrafts, and committing them|write restore drafts discard commit\nImporting, exporting, splitting|import-md export-md import-code export-code split-suggest\nChecking, syncing, serving|check snapshot adopt conflicts publish batch\nEvaluating|eval\nDerived data from an editor|supply reach diagnostics"))
0108399a (169 1790985775117 "guenchi" (("8pniyrtk" . 328)) (set "d9l36a5r.2q" src "describe carries this text once, beside the verbs, and the MCP shell puts it in the descriptions of `theourgia_insert` and `theourgia_write`; in a store with a template, the tools that write carry the roots' sentences after it:\n\n```\nA block is the unit of writing: one block should answer one question on its own.\nKeep a block under about 800 tokens (roughly 3000 bytes); split a longer one.\nGive every block a one-sentence title.\nGive every block 3 to 8 keywords, comma separated, with --keywords.\nPlace a block under the parent its source or subject puts it under, with --under.\nDo not rewrite the source bytes: splitting a document must not edit its prose.\nChange a block with write and then commit, through a draft, rather than replacing it.\nHold a writer id from one agent at a time: a later session may bind the same id and carry on with its drafts, but two agents writing one draft at once overwrite each other silently.\nRecord a decision as a block of kind decision, and link each block that implements it with link <block> implements <decision>.\nOpen a session with commitments --open, which lists the decisions not yet implemented, done or dropped.\nSet class with set <id> class inference for what you concluded and did not verify, and with set <id> class external for material from outside; neither is ever treated as a ruling.\nTo replace a ruling, write the new one and link <new> supersedes <old>; to record that something is wrong, link <evidence> refutes <claim>.\nSay what your work rests on with link <work> depends-on <premise>: when the premise changes, the work is marked for review.\nAfter checking that an implementation still carries out its decision, link <impl> implements <decision> again: linking again is how you say you checked.\n```"))
e1bdfdb0 (170 1790985775339 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "Read receipts") (src . "A read of the committed store ends with a receipt: `(cut <cut>)`, the state the answer was read from, and `(versions ((<id> . \"<hash>\") ...))`, the version of each block it shows. A version is the token `--if-unchanged` compares, so a block read and written back with it is refused if it changed in between. `read` (plain, `--md`, `--recursive`), `refs`, `commitments`, `tasks`, `names` and `uses` carry both clauses; `search`, `grep` and `whereis`, which already give their cut, add the versions; `outline` and `reach` carry the cut only. A working read, a draft listing, `log`, `diff`, `conflicts`, `check`, `diagnostics`, `describe` and the exports carry none. The human output shows the receipt only for a plain `read` and for `reach`. Recall does not need either clause; a write that must not overwrite a later change does.") (keywords . "receipt, cut, versions, read, if-unchanged") (parent . "8pniyrtk.l") (ord . 9/2))))
24399c36 (171 1790985775570 "guenchi" (("8pniyrtk" . 328)) (put ((kind . section) (title . "Class and validity") (src . "A block's `class` says what kind of statement it is: `observation`, `inference`, `ruling`, `verification` or `external`. With no class, a decision is a ruling and anything else an observation. Observations, rulings and verifications are authoritative; inferences and external material are not.\n\nSix relations change whether a block is in force: `supersedes`, `refutes`, `depends-on`, `implements`, `verifies` and `conflicts-with`. `supersedes`, `refutes` and `conflicts-with` act only from an authoritative block; from another they are proposals, and the target needs review. A block's validity is `superseded`, `refuted`, `needs-review` or `valid`.\n\nA plain `read` of a block that is not valid adds a `(validity ...)` clause, and `read` never hides a block. `search`, `grep` and `whereis` leave out superseded and refuted blocks; the `(excluded ...)` clause that counts them is in the `--wire` answer only, and the human output shows the hits in force and nothing else -- nothing at all when every hit was left out. `--all-validity` leaves nothing out and names every hit that is not valid. A store that links none of the six relations answers as before.") (keywords . "class, validity, supersedes, refutes, excluded, all-validity") (parent . "8pniyrtk.l") (ord . 13/3))))
a52a7daa (172 1790985775799 "guenchi" (("8pniyrtk" . 328)) (del "d9l36a5r.3u"))
62b47d7b (173 1790985776074 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define verb-table (quote ((init (usage (init ("--template" <name>) ("--template-file" <template-file>))) (description "Create a store in this directory; with --template (a built-in such as project) or --template-file, then apply that template to it.") (protocol #f) (route local)) (eval (usage (eval ("--lang" <language>) ("--cut" <cut>) ("--under" <library>) ("--working") ("--latest") ("--writer" <name>) ("--timeout-ms" <n>) ("--memory-bytes" <n>) ("--output-bytes" <n>) <source>)) (description "Evaluate source against the store, or against a writer's working view with --working: Scheme by default, another language with --lang, whose runner runs only where the operator has set THEOURGIA_RUNNERS=on. It runs as a child process of the caller, never in the store's server.") (protocol #f) (route child)) (insert (usage (insert ("--under" <id>) ("--after" <id>) "--title" <text> ("--text" <text>) ("--keywords" <text>))) (description "Add a block under a parent, with a title and optional text.") (protocol #t) (route daemon)) (set (usage (set <id> <field> <value> ("--if-unchanged" <version>) ("--based-on" <version>))) (description "Replace one field of one block.") (protocol #f) (route daemon)) (move (usage (move <id> <parent> ("--after" <id>))) (description "Move a block to another parent, optionally after a sibling.") (protocol #f) (route daemon)) (del (usage (del <id>)) (description "Retire a block. Its history stays.") (protocol #f) (route daemon)) (link (usage (link <from> <rel> <to>)) (description "Record a named relation between two blocks.") (protocol #f) (route daemon)) (unlink (usage (unlink <from> <rel> <to>)) (description "Remove a named relation between two blocks.") (protocol #f) (route daemon)) (write (usage (write <block> <bytes> ("--writer" <name>) ("--based-on" <version>) ("--working-cut" <cut>) ("--working-parent-writer" <name>) ("--working-parent" <version>) ("--rebase"))) (description "Save a draft of a block in a writer's own space, without committing it.") (protocol #t) (route daemon)) (restore (usage (restore <version> ("--writer" <name>))) (description "Take an earlier version of a draft back into a writer's space.") (protocol #f) (route daemon)) (commit (usage (commit (<block> ...) ("--writer" <name>) ("--working-version" <block>=<version>))) (description "Install a writer's drafts into the store as one change.") (protocol #f) (route daemon)) (drafts (usage (drafts ("--writer" <name>))) (description "List the drafts a writer is holding.") (protocol #f) (route daemon)) (diagnostics (usage (diagnostics ("--writer" <name>))) (description "List the diagnostics an editor supplied for a writer's working view, by block and then by start, each at a byte range of its block's own src.") (protocol #f) (route daemon)) (discard (usage (discard <block> ("--writer" <name>))) (description "Throw away a writer's draft of a block.") (protocol #f) (route daemon)) (batch (usage (batch <intents>)) (description "Carry out several changes as one request.") (protocol #f) (route daemon)) (split-suggest (usage (split-suggest <file> ("--output" <review-file>) ("--symbols" <symbols-file>))) (description "Propose where a long file could be divided into blocks. With --symbols, the cuts come from an editor's list of the file's top-level symbols instead of the language's definition patterns; the answer's cuts-from says which.") (protocol #f) (route daemon)) (import-code (usage (import-code <dir> ("--allow-delete") ("--datum"))) (description "Read a directory of source into the store. With --datum, the whole-line ; comments directly above a form become its doc; a ; comment inside a form is dropped, and the answer warns with its line and column. A #| |# block comment, and any comment inside a datum discarded with #;, is dropped with neither. With --datum, only Scheme files are read: those the language table gives to Scheme by extension (ss, sc, scm, sls, matched exactly); every other file the directory walk returns (it does not enter a name that starts with a dot) is listed, in the order it was walked, in the answer's skipped clause, which is there only when something was skipped. A file the reader refuses is named in the refusal's path clause. Text mode, without --datum, skips a file that is not UTF-8 text or that holds a NUL byte, and lists it in the same skipped clause; it is decided by the bytes, not the name, so a source file in a legacy 8-bit encoding or in UTF-16 is skipped and listed, not imported, unless its bytes happen to be valid UTF-8 with no NUL.") (protocol #f) (route daemon)) (export-code (usage (export-code <dir> ("--raw") ("--datum") ("--working") ("--writer" <name>))) (description "Write the store's source back out to a directory.") (protocol #f) (route daemon)) (def (usage (def <name> ("--under" <library>) <source>)) (description "Define or replace one named definition.") (protocol #f) (route daemon)) (import-md (usage (import-md <dir> ("--allow-delete"))) (description "Read a directory of markdown into the store.") (protocol #f) (route daemon)) (export-md (usage (export-md <dir> ("--with-ids") ("--working") ("--writer" <name>))) (description "Write the store out as markdown.") (protocol #f) (route daemon)) (supply (usage (supply <kind> <file> ("--for" <writer>) ("--clear"))) (description "Keep facts an editor computed from an export-code projection -- signatures, calls, diagnostics -- beside the store, never in it. The file's header names the projection it was made from; every file it lists is checked against the store's own re-projection, of the committed state or, with --for, of that writer's working view. A fact is used only while the blocks it depends on still project as they did. With --clear, the table the header names is removed.") (protocol #f) (route daemon)) (adopt (usage (adopt)) (description "Take in records that are on disk but not yet in the log.") (protocol #f) (route daemon)) (check (usage (check)) (description "Read the whole store and report whether it is sound.") (protocol #f) (route daemon)) (snapshot (usage (snapshot)) (description "Record the current state as a reduction that can be reopened quickly.") (protocol #f) (route daemon)) (publish (usage (publish <writer> <segment> <file> (<sha256>))) (description "Publish a segment of a writer's log.") (protocol #f) (route daemon)) (outline (usage (outline ("--depth" <n>) ("--with-keywords") ("--with-signatures"))) (description "List the blocks as a tree of titles.") (protocol #f) (route daemon)) (read (usage (read <id> ("--md") ("--recursive") ("--writer" <name>) ("--working") ("--working-info") ("--signature") ("--cut" <cut>))) (description "Read one block: its fields, or its text. With --signature, the signature an editor supplied for it, of the committed store or, with --working, of the writer's working view. With --cut, the block as it was at a causal cut (a literal or a tag name): the same answer over that cut's state, or unknown-id where the block did not exist yet.") (protocol #f) (route daemon)) (refs (usage (refs <id>)) (description "List the relations a block takes part in.") (protocol #f) (route daemon)) (reach (usage (reach <id> ("--rel" <rel>) ("--depth" <n>))) (description "List the blocks a block reaches over the edges an editor supplied (calls, by default), outward, up to --depth hops (1 by default); the block itself is at depth 0.") (protocol #f) (route daemon)) (search (usage (search <query> ("--all") ("--all-validity"))) (description "Find blocks whose title, keywords or text match every word given.") (protocol #f) (route daemon)) (grep (usage (grep <pattern> ("--under" <id>) ("--all") ("--all-validity"))) (description "List the lines that contain a pattern, literally.") (protocol #f) (route daemon)) (whereis (usage (whereis <name> ("--all-validity"))) (description "Say where a name is defined, and which libraries carry it.") (protocol #f) (route daemon)) (log (usage (log (<id>))) (description "Show the changes recorded, for the store or for one block.") (protocol #f) (route daemon)) (tag (usage (tag (<name>))) (description "Name the current cut, or list the names already given.") (protocol #f) (route daemon)) (diff (usage (diff <cut> <cut>)) (description "Report what changed between two cuts.") (protocol #f) (route daemon)) (conflicts (usage (conflicts)) (description "List blocks whose writers disagree.") (protocol #f) (route daemon)) (describe (usage (describe)) (description "List the verbs, what each is for, and the writing protocol.") (protocol #f) (route daemon)) (commitments (usage (commitments ("--open") ("--all") ("--drifted") ("--since" <cut>) ("--under" <id>))) (description "List the decisions still owed: by default those neither implemented (an incoming implements edge) nor marked done or dropped; with --all every decision. --drifted keeps those with an implementation whose latest change was seen neither by its implements link nor by the decision's latest edit.") (protocol #f) (route daemon)) (tasks (usage (tasks ("--status" <status>) ("--batch" <batch>) ("--under" <id>))) (description "List the tasks: by default those under the root the store's template names for tasks, else every task; each with its status (todo, doing, done or dropped), its batch, what it implements, and (unlinked) when it implements no live decision.") (protocol #f) (route daemon)) (template (usage (template <action> (<name>) ("--file" <template-file>))) (description "Apply a template to this store (apply <name>, or apply --file <template-file>): create the template block and each document root the store lacks, changing nothing that exists. Or print the store's template (export).") (protocol #f) (route daemon)) (names (usage (names <id>)) (description "Which names a code block uses, as its stored code shows them, and which libraries a library block imports. A datum block's body is walked as data: a symbol is a use unless something in the form binds it, and an unknown macro's operands count as uses. A text block's uses are every token its language's identifier pattern matches, comments and strings included. No name is resolved.") (protocol #f) (route daemon)) (uses (usage (uses <name> ("--under" <id>))) (description "The live code blocks that use a name, compared whole and exactly, one row per block with its library and mode; with --under, those inside that block. It is not find-references: a use is listed whether or not anything defines the name, and a text block that defines the name also lists it.") (protocol #f) (route daemon))))) (doc . "") (parent . "8pniyrtk.2") (ord . 104))))
