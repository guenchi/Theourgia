405cb9ac (146 1790935341936 "guenchi" (("8pniyrtk" . 328)) (put ((kind . code) (mode . datum) (lang . chez) (body define (page-changelog) (shell "Changelog -- Theourgia" "Released versions of theourgia, newest first." "Changelog" (list (quasiquote (div (@ (class "md-body")) (raw (unquote (md->html (copy "The changelog"))))))))) (doc . "") (parent . "8pniyrtk.2") (ord . 98))))
