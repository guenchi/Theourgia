{
  "name": "theourgia",
  "displayName": "theourgia",
  "description": "Browse and edit a theourgia block store from VS Code.",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/guenchi/Theourgia.git",
    "directory": "."
  },
  "publisher": "theourgia",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/src/extension.js",
  "activationEvents": [
    "onView:theourgiaOutline"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "theourgia",
          "title": "theourgia",
          "icon": "media/outline.svg"
        }
      ]
    },
    "views": {
      "theourgia": [
        {
          "id": "theourgiaOutline",
          "name": "Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "theourgia.openAsDocument",
        "title": "theourgia: Open as Document"
      },
      {
        "command": "theourgia.goToDefinition",
        "title": "theourgia: Go to Definition"
      },
      {
        "command": "theourgia.search",
        "title": "theourgia: Search Blocks",
        "icon": "$(search)"
      },
      {
        "command": "theourgia.refreshOutline",
        "title": "theourgia: Refresh Outline",
        "icon": "$(refresh)"
      },
      {
        "command": "theourgia.openBlock",
        "title": "theourgia: Open Block"
      },
      {
        "command": "theourgia.retryOutbox",
        "title": "theourgia: Retry Pending Saves"
      },
      {
        "command": "theourgia.showStatus",
        "title": "theourgia: Show Store Status"
      },
      {
        "command": "theourgia.reconcileBlock",
        "title": "theourgia: Reconcile Block"
      },
      {
        "command": "theourgia.otherSessions",
        "title": "theourgia: Other Sessions"
      },
      {
        "command": "theourgia.migrateBlock",
        "title": "theourgia: Migrate Legacy Block Files"
      },
      {
        "command": "theourgia.suggestSplit",
        "title": "theourgia: Suggest a Split of This File"
      },
      {
        "command": "theourgia.showFiles",
        "title": "theourgia: Show Files",
        "icon": "$(file-directory)"
      },
      {
        "command": "theourgia.showOutline",
        "title": "theourgia: Show Outline",
        "icon": "$(list-tree)"
      },
      {
        "command": "theourgia.newFileHere",
        "title": "theourgia: New File Here",
        "icon": "$(new-file)"
      },
      {
        "command": "theourgia.moveToDirectory",
        "title": "theourgia: Move to Directory"
      },
      {
        "command": "theourgia.renameFile",
        "title": "theourgia: Rename File"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "theourgia.search",
          "when": "view == theourgiaOutline",
          "group": "navigation@0"
        },
        {
          "command": "theourgia.refreshOutline",
          "when": "view == theourgiaOutline",
          "group": "navigation"
        },
        {
          "command": "theourgia.showFiles",
          "when": "view == theourgiaOutline && theourgia.viewMode != files",
          "group": "navigation@1"
        },
        {
          "command": "theourgia.showOutline",
          "when": "view == theourgiaOutline && theourgia.viewMode == files",
          "group": "navigation@1"
        },
        {
          "command": "theourgia.newFileHere",
          "when": "view == theourgiaOutline && theourgia.viewMode == files",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "theourgia.openAsDocument",
          "when": "view == theourgiaOutline && viewItem =~ /^theourgia\\.block/"
        },
        {
          "command": "theourgia.newFileHere",
          "when": "view == theourgiaOutline && viewItem == theourgia.dir"
        },
        {
          "command": "theourgia.moveToDirectory",
          "when": "view == theourgiaOutline && viewItem == theourgia.block.file"
        },
        {
          "command": "theourgia.renameFile",
          "when": "view == theourgiaOutline && viewItem == theourgia.block.file"
        }
      ],
      "commandPalette": [
        {
          "command": "theourgia.openBlock",
          "when": "false"
        },
        {
          "command": "theourgia.openAsDocument",
          "when": "false"
        },
        {
          "command": "theourgia.moveToDirectory",
          "when": "false"
        },
        {
          "command": "theourgia.renameFile",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "theourgia",
      "properties": {
        "theourgia.corePath": {
          "type": "string",
          "default": "",
          "description": "Directory holding the core. Either a checkout (the library sources beside theourgia.sc) or a directory built by the core's build.ss (the compiled libraries beside the same scripts). Which one it is decides how the libraries are looked up, and the extension reads the directory to find out rather than asking you."
        },
        "theourgia.libDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra directories to place on CHEZSCHEMELIBDIRS after corePath. The core imports (igropyr crypto), (igropyr platform) and (igropyr sexpr), so the directory holding igropyr belongs here."
        },
        "theourgia.store": {
          "type": "string",
          "default": "",
          "description": "Store directory. Passed as --store."
        },
        "theourgia.actor": {
          "type": "string",
          "default": "",
          "description": "Actor name recorded with every write. Defaults to the OS user name."
        },
        "theourgia.writer": {
          "type": "string",
          "default": "",
          "description": "Draft space this window writes into. Passed to the core as THEOURGIA_WRITER. Defaults to the actor name, which is what one window wants; give two windows two names when they should keep separate drafts of the same block."
        },
        "theourgia.scheme": {
          "type": "string",
          "default": "scheme",
          "description": "Chez Scheme executable."
        },
        "theourgia.timeoutMs": {
          "type": "number",
          "default": 30000,
          "description": "How long to wait for one request before killing the child process."
        }
      }
    }
  },
  "scripts": {
    "compile": "node scripts/clean.js && tsc -p ./ && node scripts/copy-vendor.js && node scripts/build-native.js",
    "watch": "tsc -watch -p ./",
    "test:unit": "npm run compile && mocha --reporter spec --require out/test/support/unhandled-tripwire.js 'out/test/unit/**/*.test.js'",
    "test:integration": "npm run compile && node out/test/integration/run.js",
    "test": "npm run test:unit && npm run test:integration"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^4.0.0",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "goeteia": "1.7.2"
  }
}
