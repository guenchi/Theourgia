{
  "name": "theourgia",
  "version": "1.1.0",
  "description": "A block-graph store for LLM agents and the people working with them, with its daemon and MCP shell.",
  "license": "Apache-2.0",
  "author": "guenchi",
  "homepage": "https://theourgia.dev",
  "bugs": "https://github.com/guenchi/Theourgia/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guenchi/Theourgia.git"
  },
  "keywords": ["mcp", "knowledge-base", "chez-scheme", "agents"],
  "bin": {
    "theourgia": "bin/theourgia.js",
    "theourgia-mcp": "bin/theourgia-mcp.js",
    "theourgiad": "bin/theourgiad.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/postinstall.js",
    "theourgia/*.sc",
    "theourgia/build.ss",
    "theourgia/mcp/",
    "theourgia/LICENSE",
    "source.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "node scripts/prepublish.js",
    "prepack": "node scripts/source-pin.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "igropyr": "1.8.2"
  },
  "os": ["darwin", "linux"],
  "cpu": ["arm64", "x64"],
  "engines": {
    "node": ">=18"
  }
}
