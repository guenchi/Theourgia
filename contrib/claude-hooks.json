{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "THEOURGIA_ACTOR=claude sh /path/to/theourgia/contrib/mail-hook.sh PostToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "THEOURGIA_ACTOR=claude sh /path/to/theourgia/contrib/mail-hook.sh UserPromptSubmit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
